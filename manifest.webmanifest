    <div class="field"><span style="color:var(--muted);font-size:12.5px">ปี พ.ศ.</span><select id="sumYear"></select></div>
    <button class="btn" id="sumAddYear" style="background:var(--navy);border-color:var(--navy);color:#fff">＋ เพิ่มปี</button>
    <div class="field grow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input id="sumSearch" placeholder="ค้นหาชื่อ / ตำแหน่ง"></div>
    <div class="field"><select id="sumGroup"></select></div>
    <button class="btn" id="sumPrint" style="background:var(--orange);border-color:var(--orange);color:var(--ink)">🖨️ พิมพ์ / บันทึก PDF</button>
    <span class="dbmsg" id="sumMsg" style="margin-left:auto"></span>
  </div>
  <div class="print-head" id="sumPrintHead"></div>
  <div class="kpis" id="sumKpis" style="grid-template-columns:repeat(5,1fr)"></div>
  <div class="tbl-wrap" id="sumTable"></div>
</div>

</section>
<style>
#view-score .wrap{max-width:1180px;margin:0 auto;padding:18px 20px 60px}
#view-score .sc-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:14px}
#view-score h1{font-family:'IBM Plex Sans Thai',sans-serif;font-size:22px;font-weight:700;margin:0;color:var(--ink)}
#view-score .sc-sub{margin:4px 0 0;color:var(--muted);font-size:13px}
#view-score .sc-issue{background:var(--orange);color:#fff;border:none;border-radius:10px;padding:10px 16px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;white-space:nowrap}
#view-score .sc-issue:hover{filter:brightness(1.05)}
#view-score .sc-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:6px 0 16px}
@media(max-width:760px){#view-score .sc-kpis{grid-template-columns:repeat(2,1fr)}}
#view-score .sc-kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px;box-shadow:var(--shadow)}
#view-score .sc-kpi .l{font-size:12.5px;color:var(--muted)}
#view-score .sc-kpi .v{font-size:26px;font-weight:800;font-variant-numeric:tabular-nums;margin-top:2px}
#view-score .sc-rules{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
#view-score .sc-rules .r{display:inline-flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-size:12.5px}
#view-score .sc-rules .r b{color:var(--orange)}
#view-score .sc-rules .r i{width:9px;height:9px;border-radius:3px;display:inline-block}
#view-score .sc-tablewrap{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:auto;box-shadow:var(--shadow);margin-bottom:8px}
#view-score table.sc-tbl{border-collapse:collapse;width:100%;font-size:13.5px;min-width:760px}
#view-score .sc-tbl th,#view-score .sc-tbl td{padding:10px 12px;text-align:center;border-bottom:1px solid var(--line);white-space:nowrap}
#view-score .sc-tbl th{background:#F6F6F2;font-weight:600;color:var(--ink);position:sticky;top:0}
#view-score .sc-tbl td.nm{text-align:left;font-weight:600}
#view-score .sc-tbl td.nm small{display:block;font-weight:400;color:var(--muted);font-size:11.5px}
#view-score .sc-tbl tr.zero{opacity:.5}
#view-score .sc-tbl td.tot{font-weight:800;color:var(--orange);font-variant-numeric:tabular-nums}
#view-score .sc-tbl td.rem{font-weight:700;font-variant-numeric:tabular-nums}
#view-score .sc-tbl td.rem.low{color:var(--absent)}
#view-score .sc-h2{font-size:16px;font-weight:700;margin:26px 0 10px;color:var(--ink)}
#view-score .sc-badge{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600;background:var(--orange-soft);color:var(--orange)}
#view-score .sc-dim{color:var(--muted)}
#view-score .warn-btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:#fff;border-radius:8px;padding:3px 9px;font-family:inherit;font-size:12.5px;cursor:pointer;color:var(--ink)}
#view-score .warn-btn:hover{border-color:var(--orange);color:var(--orange)}
#view-score .warn-mng{color:var(--muted);font-size:11.5px}
#view-score tr.warn-detail>td{background:#F7FBFF;border-bottom:1px solid var(--line);padding:10px 14px}
#view-score tr.warn-detail.hide{display:none}
#view-score .warn-panel{display:flex;flex-direction:column;gap:8px;text-align:left}
#view-score .wp-item{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-radius:9px;padding:7px 10px}
#view-score .wp-date{font-variant-numeric:tabular-nums;color:var(--muted);white-space:nowrap;font-size:12.5px}
#view-score .wp-reason{flex:1;min-width:120px}
#view-score .wp-act{display:inline-flex;gap:6px}
#view-score .wp-act button{border:1px solid var(--line);background:#fff;border-radius:7px;padding:4px 10px;font-family:inherit;font-size:12px;cursor:pointer}
#view-score .wp-edit:hover{border-color:var(--navy);color:var(--navy)}
#view-score .wp-del:hover{border-color:var(--absent);color:var(--absent)}
#view-score .wp-empty{color:var(--muted);font-size:13px;padding:2px}
#view-score .wp-add{align-self:flex-start;border:1px dashed var(--orange);background:#fff;color:var(--orange);border-radius:8px;padding:6px 12px;font-family:inherit;font-weight:600;font-size:12.5px;cursor:pointer}
#view-score .sc-act{display:inline-flex;gap:6px}
#view-score .sc-act button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:5px 10px;font-family:inherit;font-size:12.5px;cursor:pointer}
#view-score .sc-act button.pr:hover{border-color:var(--navy);color:var(--navy)}
#view-score .sc-act button.del:hover{border-color:var(--absent);color:var(--absent)}
#view-score .sc-empty{padding:26px;text-align:center;color:var(--muted)}
#view-score .sc-msg{font-size:12.5px;margin:6px 2px}
#view-score .sc-msg.err{color:var(--absent)}
#view-score .sc-msg.ok{color:var(--present)}
#scModal .scm-combo{position:relative}
#scModal .scm-list{position:absolute;left:0;right:0;top:calc(100% + 4px);background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px rgba(16,31,54,.16);max-height:230px;overflow:auto;z-index:5;display:none}
#scModal .scm-list.open{display:block}
#scModal .scm-opt{padding:9px 12px;cursor:pointer;font-size:14px;display:flex;justify-content:space-between;gap:10px}
#scModal .scm-opt:hover,#scModal .scm-opt.active{background:var(--orange-soft)}
#scModal .scm-opt small{color:var(--muted)}
#scModal .scm-none{padding:11px 12px;color:var(--muted);font-size:13px}
/* modal */
#scModal{position:fixed;inset:0;background:rgba(16,31,54,.42);display:none;align-items:center;justify-content:center;z-index:9999;padding:16px}
#scModal.open{display:flex}
#scModal .box{background:#fff;border-radius:16px;width:520px;max-width:100%;max-height:90vh;overflow:auto;padding:22px 24px;box-shadow:0 20px 60px rgba(16,31,54,.3)}
#scModal h3{margin:0 0 4px;font-size:18px;color:var(--ink)}
#scModal .hint{color:var(--muted);font-size:12.5px;margin:0 0 16px}
#scModal label{display:block;font-size:12.5px;font-weight:600;color:var(--ink);margin:12px 0 5px}
#scModal input,#scModal select,#scModal textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:9px 11px;font-family:inherit;font-size:14px;color:var(--ink);background:#fff}
#scModal textarea{resize:vertical;min-height:70px}
#scModal .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
#scModal .foot{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}
#scModal .foot button{border-radius:10px;padding:10px 18px;font-family:inherit;font-weight:600;font-size:14px;cursor:pointer}
#scModal .foot .cancel{background:#fff;border:1px solid var(--line);color:var(--ink)}
#scModal .foot .ok{background:var(--orange);border:none;color:#fff}
#scModal .foot .ok:disabled{opacity:.6;cursor:default}
</style>
<section id="view-score" class="view">
  <div class="wrap">
    <div class="sc-head">
      <div>
        <h1>คะแนนความประพฤติ &amp; ใบเตือน</h1>
        <p class="sc-sub" id="scSub">—</p>
      </div>
      <button class="sc-issue" id="scIssueBtn">＋ ออกใบเตือน</button>
    </div>
    <div class="sc-kpis" id="scKpis"></div>
    <div class="sc-rules" id="scRules"></div>
    <div class="sc-msg" id="scMsg"></div>
    <div class="sc-tablewrap"><table class="sc-tbl" id="scTbl"><tbody><tr><td class="sc-empty">กด “🔄 โหลด” ด้านบนเพื่อดึงข้อมูลก่อน</td></tr></tbody></table></div>
  </div>
  <div id="scModal">
    <div class="box">
      <h3>ออกใบเตือน (หนังสือเตือน)</h3>
      <p class="hint">บันทึกลงระบบและนับเป็น −5 คะแนนในเดือนที่ออก</p>
      <label>พนักงาน</label>
      <div class="scm-combo">
        <input id="scmEmpText" autocomplete="off" placeholder="พิมพ์ชื่อเพื่อค้นหา...">
        <input type="hidden" id="scmEmp">
        <div id="scmEmpList" class="scm-list"></div>
      </div>
      <div class="row2">
        <div><label>วันที่ออก</label><input type="date" id="scmDate"></div>
        <div><label>ระดับการเตือน</label>
          <select id="scmLevel">
            <option value="ครั้งที่ 1">ครั้งที่ 1</option>
            <option value="ครั้งที่ 2">ครั้งที่ 2</option>
            <option value="ครั้งสุดท้าย">ครั้งสุดท้าย</option>
          </select>
        </div>
      </div>
      <label>เรื่อง / สาเหตุ</label>
      <input id="scmReason" placeholder="เช่น ขาดงานโดยไม่แจ้งล่วงหน้า, มาสายเกินกำหนดซ้ำ">
      <label>รายละเอียด (ไม่บังคับ)</label>
      <textarea id="scmDetail" placeholder="อธิบายเหตุการณ์ วันเวลา และข้อตกลง/ผลหากเกิดซ้ำ"></textarea>
      <div class="foot">
        <button class="cancel" id="scmCancel">ยกเลิก</button>
        <button class="ok" id="scmSave">บันทึกใบเตือน</button>
      </div>
    </div>
  </div>
</section>
<section id="view-deadline" class="view">
  <div id="dlHost" style="display:block"></div>
  <template id="dlTpl">
<div class="wrap">
  <header>
    <h1><span class="brand-dot"></span> ระบบเตือน Deadline HR</h1>
    <div style="display:flex;align-items:center;gap:12px">
      <span id="syncDot" class="sync off" title="สถานะการเชื่อมต่อ">● ...</span>
      <button id="bellBtn" title="ดูงานด่วน" style="background:rgba(255,255,255,.12);border:none;color:#fff;border-radius:9px;padding:7px 12px;cursor:pointer;font-family:inherit;font-size:.95rem">🔔 งานด่วน</button>
      <div class="date" id="todayLabel"></div>
    </div>
  </header>

  <!-- Summary -->
  <div class="summary" id="summary"></div>

  <!-- Toolbar -->
  <div class="toolbar">
    <div class="filters" id="filters">
      <button class="chip active" data-type="probation">⏳ ทดลองงาน</button>
      <button class="chip" data-type="termination">🚪 วันพ้นสภาพ (วันออก)</button>
    </div>
    <div class="spacer"></div>
    <button class="btn ghost" id="toggleDone">แสดงที่เสร็จแล้ว</button>
    <button class="btn ghost" id="exportXlsxBtn">📤 ส่งออก Excel</button>
    <button class="btn gold" id="importBtn">📥 นำเข้า / กู้ข้อมูล</button>
    <button class="btn" id="addBtn">+ เพิ่มรายการ</button>
    <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" class="hide">
  </div>
  <div class="toolbar toolbar2">
    <input type="text" id="deadSearch" class="dead-search" placeholder="🔍 ค้นหาชื่อ...">
    <div class="focus-btns" id="focusBtns">
      <button class="chip focus active" data-focus="all">ทั้งหมด</button>
      <button class="chip focus" data-focus="week">สัปดาห์นี้</button>
      <button class="chip focus" data-focus="month">เดือนนี้</button>
      <button class="chip focus" data-focus="overdue">เลยกำหนด</button>
    </div>
    <select id="deadDept" class="dead-dept"><option value="all">ทุกแผนก</option></select>
  </div>

  <!-- Active alerts -->
  <div class="list" id="list"></div>

  <!-- Done -->
  <div id="doneWrap" class="hide">
    <div class="section-title">✅ เสร็จแล้ว</div>
    <div class="list" id="doneList"></div>
  </div>
</div>

<!-- Modal -->
<div class="overlay" id="overlay">
  <div class="modal">
    <h2 id="modalTitle">เพิ่มรายการ</h2>
    <input type="hidden" id="f_id">
    <div class="field">
      <label>ประเภท</label>
      <select id="f_type">
        <option value="probation">⏳ ทดลองงาน (30/60/90 วัน)</option>
      </select>
    </div>
    <div class="field">
      <label id="lbl_name">ชื่อพนักงาน</label>
      <div class="emp-combo">
        <input id="f_name" autocomplete="off" placeholder="พิมพ์ชื่อ/ชื่อเล่นเพื่อค้นหา หรือพิมพ์เองก็ได้">
        <div id="empList" class="emp-list"></div>
      </div>
      <div class="hint" id="hint_name">ดึงรายชื่อจากระบบบันทึกการมาทำงาน — เลือกแล้วเติมวันเริ่มงาน/แผนกให้อัตโนมัติ</div>
    </div>

    <!-- probation / maternity ref date -->
    <div class="field" id="grp_ref">
      <label id="lbl_ref">วันเริ่มงาน</label>
      <input type="date" id="f_ref">
      <div class="hint" id="hint_ref">ระบบจะคำนวณ 30/60/90 วันให้อัตโนมัติ</div>
    </div>

    <!-- maternity threshold -->
    <div class="field hide" id="grp_threshold">
      <label>จำนวนวันเกณฑ์ (ค่าจ้างนายจ้างจ่าย)</label>
      <input type="number" id="f_threshold" value="45" min="1">
      <div class="hint">ค่าเริ่มต้น 45 วัน (ปรับเป็น 60 หรือค่าอื่นได้ตามเคส)</div>
    </div>

    <!-- contract / document due date -->
    <div class="field hide" id="grp_due">
      <label id="lbl_due">วันครบกำหนด</label>
      <input type="date" id="f_due">
    </div>

    <div class="field">
      <label>แผนก (ไม่บังคับ)</label>
      <input id="f_dept" placeholder="เช่น คลังสินค้า, บัญชี, HR">
    </div>

    <div class="field">
      <label>หมายเหตุ (ไม่บังคับ)</label>
      <textarea id="f_note" rows="2" placeholder="รายละเอียดเพิ่มเติม / เอกสารที่ต้องเตรียม"></textarea>
    </div>

    <div class="modal-actions">
      <button class="btn ghost" id="deleteBtn" style="margin-right:auto;color:var(--red)">ลบ</button>
      <button class="btn ghost" id="cancelBtn">ยกเลิก</button>
      <button class="btn" id="saveBtn">บันทึก</button>
    </div>
  </div>
</div>

<!-- Alert popup -->
<div class="overlay" id="alertPop">
  <div class="modal pop">
    <div class="pop-head">
      <span class="pop-icon">🔔</span>
      <div>
        <h2 id="popTitle">งานด่วนที่ต้องจัดการ</h2>
        <div class="pop-sub" id="popSub"></div>
      </div>
    </div>
    <div class="pop-list" id="popList"></div>
    <label class="pop-snooze"><input type="checkbox" id="popSnooze"> ไม่ต้องเตือนซ้ำวันนี้</label>
    <div class="modal-actions">
      <button class="btn" id="popClose">รับทราบ</button>
    </div>
  </div>
</div>
<div class="overlay" id="termOverlay">
  <div class="modal">
    <h2>ไม่ผ่านทดลองงาน — บันทึกวันพ้นสภาพ</h2>
    <div class="field"><label>พนักงาน</label><div id="term_name" style="font-weight:600"></div><div id="term_ms" style="color:var(--muted);font-size:.9rem;margin-top:2px"></div></div>
    <div class="field"><label>วันพ้นสภาพ (วันออกจริง)</label><input type="date" id="term_date"></div>
    <div class="field"><label>เหตุผล (ไม่บังคับ)</label><textarea id="term_reason" rows="2" placeholder="เช่น ผลงานไม่ผ่านเกณฑ์ทดลองงาน"></textarea></div>
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px">
      <button class="btn ghost" id="termCancel">ยกเลิก</button>
      <button class="btn" id="termSave" style="background:var(--red);color:#fff">บันทึกวันออก</button>
    </div>
  </div>
</div>
  </template>
  <script type="text/plain" id="dlCss">

  :host{
    --green:#16294d; --green-dark:#0e1c38; --gold:#d62030;
    --red:#C00000; --ok:#1E7145;
    --bg:#EEEEEA; --card:#ffffff; --line:#e2e7ef; --muted:#64708a;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  :host{display:block;font-family:'IBM Plex Sans Thai',system-ui,sans-serif;background:var(--bg);color:#16233f;line-height:1.5}
  .wrap{max-width:1000px;margin:0 auto;padding:16px}

  /* Header */
  header{background:linear-gradient(120deg,#0e1c38,#16294d);color:#fff;border-radius:14px;padding:20px 22px;margin-bottom:16px;border-bottom:4px solid var(--gold);
    display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
  header h1{font-size:1.35rem;font-weight:700;display:flex;align-items:center;gap:10px}
  header .date{font-size:.95rem;color:#cdd8ee}
  .brand-dot{width:10px;height:10px;border-radius:50%;background:var(--gold);display:inline-block}
  .sync{font-size:.8rem;padding:4px 10px;border-radius:20px;font-weight:600}
  .sync.ok{background:rgba(46,180,120,.25);color:#d6ffe9}
  .sync.off{background:rgba(255,120,120,.25);color:#ffdede}

  /* Summary cards */
  .summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
  .scard{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;text-align:center;cursor:pointer;transition:.15s}
  .scard:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(31,56,100,.08)}
  .scard.active{border-color:var(--green-dark);box-shadow:0 0 0 2px var(--green-dark) inset}
  .scard .num{font-size:1.9rem;font-weight:700;line-height:1}
  .scard .lbl{font-size:.82rem;color:var(--muted);margin-top:4px}
  .scard.overdue .num{color:var(--red)}
  .scard.urgent .num{color:#e06a00}
  .scard.soon .num{color:var(--gold)}
  .scard.ok .num{color:var(--ok)}

  /* Toolbar */
  .toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
  .filters{display:flex;gap:6px;flex-wrap:wrap}
  .chip{border:1px solid var(--line);background:#fff;color:#334;border-radius:20px;padding:6px 14px;font-size:.86rem;cursor:pointer;font-family:inherit}
  .chip.active{background:var(--green-dark);color:#fff;border-color:var(--green-dark)}
  .spacer{flex:1}
  .btn{background:var(--green);color:#fff;border:none;border-radius:9px;padding:9px 16px;font-size:.92rem;font-weight:600;cursor:pointer;font-family:inherit}
  .btn:hover{background:var(--green-dark)}
  .btn.gold{background:var(--gold);color:#3a2f00}
  .btn.ghost{background:#fff;color:var(--green-dark);border:1px solid var(--line)}

  /* Alert list */
  .list{display:flex;flex-direction:column;gap:10px}
  .item{background:var(--card);border:1px solid var(--line);border-left:6px solid var(--line);border-radius:11px;padding:14px 16px;
    display:flex;align-items:center;gap:14px;transition:.15s}
  .item.overdue{border-left-color:var(--red)}
  .item.urgent{border-left-color:#e06a00}
  .item.soon{border-left-color:var(--gold)}
  .item.prep{border-left-color:#2E75B6}
  .item.ok{border-left-color:var(--ok)}
  .item.done{opacity:.5}
  .item.done .title{text-decoration:line-through}
  .item .icon{font-size:1.5rem;width:34px;text-align:center}
  .item .body{flex:1;min-width:0}
  .item .title{font-weight:600}
  .item .meta{font-size:.83rem;color:var(--muted);margin-top:2px}
  .item .tag{display:inline-block;font-size:.72rem;padding:1px 8px;border-radius:6px;background:#eef1f7;color:#445;margin-right:6px;font-weight:600}
  .item .right{text-align:right;white-space:nowrap}
  .item .days{font-weight:700;font-size:1.05rem}
  .badge{display:inline-block;font-size:.74rem;font-weight:700;padding:2px 10px;border-radius:20px;color:#fff;margin-top:4px}
  .badge.overdue{background:var(--red)}
  .badge.urgent{background:#e06a00}
  .badge.soon{background:var(--gold);color:#3a2f00}
  .badge.prep{background:#2E75B6}
  .badge.ok{background:var(--ok)}
  .item .acts{display:flex;gap:6px;margin-left:6px}
  .iconbtn{border:1px solid var(--line);background:#fff;border-radius:8px;width:34px;height:34px;cursor:pointer;font-size:1rem}
  .iconbtn:hover{background:#f0f3f9}
  .empty{text-align:center;color:var(--muted);padding:40px}
  .gitem{background:var(--card);border:1px solid var(--line);border-left:6px solid var(--line);border-radius:11px;padding:12px 14px;margin-bottom:10px}
  .gitem.overdue{border-left-color:var(--red)} .gitem.urgent{border-left-color:#e06a00} .gitem.soon{border-left-color:var(--gold)} .gitem.done{opacity:.6}
  .ghead{display:flex;align-items:center;gap:10px}
  .ghead .icon{font-size:1.4rem;width:30px;text-align:center}
  .gtitle{flex:1;min-width:0;font-weight:600}
  .gtitle .tag{display:inline-block;font-size:.72rem;padding:1px 8px;border-radius:12px;background:#eef2f9;color:var(--muted);margin-right:6px}
  .gitem.done .gtitle{text-decoration:line-through}
  .glead{white-space:nowrap;text-align:right;font-weight:700}
  .glead .badge{margin-left:6px}
  .ghead .iconbtn{width:32px;height:32px}
  .gmiles{margin:8px 0 2px;border-top:1px dashed var(--line);padding-top:8px;display:flex;flex-direction:column;gap:6px}
  .gmile{display:flex;align-items:center;gap:10px;font-size:.9rem;padding:4px 6px;border-radius:8px}
  .gmile.overdue{background:#fdecea} .gmile.urgent{background:#fff2e6} .gmile.soon{background:#fff8e1} .gmile.done{opacity:.55}
  .gm-label{flex:1;min-width:0}
  .gm-date{color:var(--muted);white-space:nowrap}
  .gm-days{white-space:nowrap;font-weight:700;min-width:96px;text-align:right}
  .gm-days.overdue{color:var(--red)} .gm-days.urgent{color:#e06a00} .gm-days.soon{color:#b8860b}
  .gmile.done .gm-days{color:var(--ok)}
  .gm-actions{display:inline-flex;gap:6px;white-space:nowrap;align-items:center}
  .gm-pass{border:1px solid #bfe6d2;background:#eafaf1;color:#0e7a4b;border-radius:8px;padding:4px 10px;font-family:inherit;font-size:.82rem;font-weight:700;cursor:pointer}
  .gm-pass:hover{background:#0e7a4b;color:#fff}
  .gm-fail{border:1px solid #f2c2c0;background:#fdecea;color:#c0392b;border-radius:8px;padding:4px 10px;font-family:inherit;font-size:.82rem;font-weight:700;cursor:pointer}
  .gm-fail:hover{background:#c0392b;color:#fff}
  .gm-passed{color:#0e7a4b;font-weight:700;font-size:.82rem}
  .iconbtn.sm{width:30px;height:30px;font-size:.9rem}
  .toolbar2{gap:10px;flex-wrap:wrap;align-items:center;margin-top:-4px}
  .dead-search{border:1px solid var(--line);border-radius:9px;padding:8px 12px;font-family:inherit;font-size:.92rem;min-width:180px;color:var(--ink)}
  .focus-btns{display:inline-flex;gap:6px;flex-wrap:wrap}
  .chip.focus{padding:6px 12px}
  .dead-dept{border:1px solid var(--line);border-radius:9px;padding:8px 10px;font-family:inherit;font-size:.9rem;background:#fff;color:var(--ink);max-width:200px}
  .auto-toggle{display:inline-flex;align-items:center;gap:6px;font-size:.88rem;color:var(--muted);cursor:pointer;user-select:none}
  .auto-toggle input{width:15px;height:15px}
  .auto-tag{font-size:.7rem;font-weight:700;color:#0e7a4b;background:#e3f5ec;border:1px solid #bfe6d2;border-radius:20px;padding:3px 9px;white-space:nowrap}
  .gitem .ghead .auto-tag{margin-left:2px}

  .section-title{font-weight:700;color:var(--green-dark);margin:18px 0 8px;font-size:1rem}

  /* Modal */
  .overlay{position:fixed;inset:0;background:rgba(20,30,55,.5);display:none;align-items:center;justify-content:center;padding:24px;overflow:auto;z-index:200000}
  .overlay.show{display:flex}
  .modal{background:#fff;border-radius:14px;width:100%;max-width:520px;padding:22px}
  .modal h2{color:var(--green-dark);font-size:1.15rem;margin-bottom:14px}
  .field{margin-bottom:12px}
  .field label{display:block;font-size:.86rem;font-weight:600;margin-bottom:4px;color:#334}
  .field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:9px 11px;font-family:inherit;font-size:.95rem}
  .field .hint{font-size:.76rem;color:var(--muted);margin-top:3px}
  .modal .row{display:flex;gap:10px}
  .modal .row .field{flex:1}
  .modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:8px}
  .emp-combo{position:relative}
.emp-list{position:absolute;left:0;right:0;top:calc(100% + 4px);background:#fff;border:1px solid #e3e3dc;border-radius:10px;box-shadow:0 12px 30px rgba(16,31,54,.16);max-height:240px;overflow:auto;z-index:30;display:none}
.emp-list.open{display:block}
.emp-opt{padding:9px 12px;cursor:pointer;font-size:14px;display:flex;justify-content:space-between;gap:10px;align-items:center}
.emp-opt:hover,.emp-opt.active{background:#FBE7E8}
.emp-opt small{color:#7A8398;white-space:nowrap}
.emp-none{padding:11px 12px;color:#7A8398;font-size:13px}
.hide{display:none!important}

  /* Alert popup */
  .modal.pop{max-width:680px;padding:28px 30px}
  .pop-head{display:flex;gap:18px;align-items:center;margin-bottom:20px}
  .pop-icon{font-size:2.8rem;background:#fff4d6;width:78px;height:78px;border-radius:16px;display:flex;align-items:center;justify-content:center;flex-shrink:0;animation:ring 1.2s ease-in-out}
  @keyframes ring{0%,100%{transform:rotate(0)}20%{transform:rotate(-12deg)}40%{transform:rotate(10deg)}60%{transform:rotate(-6deg)}80%{transform:rotate(4deg)}}
  .pop-head h2{color:var(--green-dark);font-size:1.7rem;margin:0;font-weight:700}
  .pop-sub{font-size:1.05rem;color:#444;margin-top:5px;font-weight:600}
  .pop-list{display:flex;flex-direction:column;gap:12px;max-height:56vh;overflow:auto;margin-bottom:16px}
  .pop-row{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:12px;border-left:8px solid var(--line);background:#fafbfe}
  .pop-row.overdue{border-left-color:var(--red);background:#fdf2f2}
  .pop-row.urgent{border-left-color:#e06a00;background:#fff7ef}
  .pop-row.soon{border-left-color:var(--gold);background:#fdfaef}
  .pop-row .pr-body{flex:1;min-width:0}
  .pop-row .pr-title{font-weight:700;font-size:1.2rem;line-height:1.3}
  .pop-row .pr-meta{font-size:.95rem;color:var(--muted);margin-top:3px}
  .pop-row .pr-days{font-weight:800;white-space:nowrap;font-size:1.5rem}
  .pop-row.overdue .pr-days{color:var(--red)}
  .pop-row.urgent .pr-days{color:#e06a00}
  .pop-row.soon .pr-days{color:#a5872f}
  .pop-snooze{display:flex;align-items:center;gap:8px;font-size:.95rem;color:var(--muted);margin-bottom:8px;cursor:pointer}
  .pop-snooze input{width:18px;height:18px}
  .modal.pop .modal-actions .btn{padding:12px 28px;font-size:1.05rem}

  footer{text-align:center;color:var(--muted);font-size:.8rem;margin:24px 0 8px}
  .backup-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;
    background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 16px;margin-top:22px}
  .backup-note{font-size:.85rem;color:var(--muted);margin-right:4px}
  .backup-bar .btn{padding:7px 13px;font-size:.86rem}

  @media(max-width:640px){
    .summary{grid-template-columns:repeat(2,1fr)}
    .item{flex-wrap:wrap}
    .item .right{width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center}
  }

  </script>
</section>

<script>// Supabase client ตัวเดียวใช้ร่วมทั้ง 2 แท็บ
window.__SB_URL="https://iyycyvnvfmerxkcfalea.supabase.co";
window.__SB_KEY="sb_publishable_ChkZClaeE6NCAxqyTqE4Yw_aTsz4zqi";
window.__getSB=function(){
  if(!window.__SB_CLIENT && window.supabase && window.__SB_URL && !/PASTE-PROJECT-URL/.test(window.__SB_URL)){
    window.__SB_CLIENT=window.supabase.createClient(window.__SB_URL,window.__SB_KEY);
  }
  return window.__SB_CLIENT||null;
};
// อ่านแบบแบ่งหน้า ดึงครบทุกแถว (เลี่ยงลิมิต ~1000 แถว/คำขอของ Supabase)
window.__pageAll=async function(buildQuery){ var out=[],from=0,P=1000;
  while(true){ var r=await buildQuery(from,from+P-1); if(r.error) throw r.error; var d=r.data||[]; out=out.concat(d);
    if(d.length<P) break; from+=P; if(from>500000) break; } return out; };
// ===== เดือนกลาง (ใช้ร่วมทุกแท็บ กันเดือนไม่ตรงกัน) =====
(function(){ var gi=document.getElementById('globalMonth'); if(gi){ gi.value='2026-07'; gi.setAttribute('autocomplete','off'); } })();
window.__ym='2026-07';
// ที่พักข้อมูลจากไฟล์ (ยังไม่บันทึกลง DB)
window.__staged=null;
window.__updateSaveUI=function(){ var b=document.getElementById('btnSave'); if(!b) return;
  b.style.display='inline-flex';
  if(window.__staged){ b.textContent='💾 บันทึกนำเข้า ('+window.__staged.monthsCount+' เดือน)'; b.classList.add('has-changes'); }
  else if(window.__gridDirty && window.__gridDirty()){ b.textContent='💾 บันทึก *'; b.classList.add('has-changes'); }
  else { b.textContent='💾 บันทึก'; b.classList.remove('has-changes'); } };
window.__saveAll=async function(){ var b=document.getElementById('btnSave'); if(b)b.disabled=true;
  try{ if(window.__gridDirty && window.__gridDirty()){ if(window.__saveGrid) await window.__saveGrid(); }
       else if(window.__staged){ if(window.__commitStaged) await window.__commitStaged(); }
       else if(window.__saveGrid){ await window.__saveGrid(); } }
  finally{ if(b)b.disabled=false; if(window.__updateSaveUI) window.__updateSaveUI(); } };
window.__loadAll=function(){
  if(window.__gridDirty && window.__gridDirty() && !confirm('มีการแก้ที่ยังไม่บันทึก — โหลดใหม่จะทับของที่ยังไม่บันทึก ยืนยันไหม?')) return;
  window.__setMonth(window.__ym);
  if(window.__gridForceLoad) window.__gridForceLoad();   // โหลด grid เฉพาะตอนกดปุ่มนี้
  if(window.__leaveActivate) window.__leaveActivate();
  if(window.__sumActivate) window.__sumActivate(); };
// ชื่อไทย = บน (0), ชื่อพม่า/อื่น (อักษรละติน) = ล่าง (1)
window.__nameLangRank=function(name){ return /[\u0E00-\u0E7F]/.test(name||"")?0:1; };
// แปลงวันเริ่มงานเป็น timestamp เพื่อใช้เรียง — รองรับ ISO, DD/MM/YYYY, พ.ศ. (>2200 หัก 543), ค่าว่าง→ไปท้ายสุด
window.__parseStart=function(s){
  var FAR=8.64e15; if(s==null) return FAR; s=(""+s).trim(); if(!s) return FAR;
  var y,mo,d,m;
  if((m=s.match(/^(\d{3,4})[-\/.](\d{1,2})[-\/.](\d{1,2})$/))){ y=+m[1]; mo=+m[2]; d=+m[3]; }
  else if((m=s.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2,4})$/))){ d=+m[1]; mo=+m[2]; y=+m[3]; }
  else { var t=Date.parse(s); return isNaN(t)?FAR:t; }
  if(y>2200) y-=543;
  if(y<1900||mo<1||mo>12||d<1||d>31) return FAR;
  var ts=Date.UTC(y,mo-1,d); return isNaN(ts)?FAR:ts;
};
// เรียงให้คนกลุ่มเดียวกันอยู่ติดกัน (กลุ่มไปอยู่ตำแหน่งสมาชิกคนแรก) + ไทยขึ้นก่อนพม่า (ส่ง getName เข้ามา)
window.__groupSort=function(rows,getSeq,getGroup,getName){
  var anchor={};
  rows.forEach(function(r){ var g=getGroup(r); if(g){ var s=getSeq(r); if(anchor[g]==null||s<anchor[g]) anchor[g]=s; } });
  function lang(r){ return getName?window.__nameLangRank(getName(r)):0; }
  rows.sort(function(a,b){
    var la=lang(a),lb=lang(b); if(la!==lb) return la-lb;
    var ga=getGroup(a),gb=getGroup(b); var aa=ga?anchor[ga]:getSeq(a), bb=gb?anchor[gb]:getSeq(b);
    if(aa!==bb) return aa-bb; if((ga||"")!==(gb||"")) return (ga||"")<(gb||"")?-1:1; return getSeq(a)-getSeq(b); });
  return rows;
};
window.__monthSubs=[];
window.__onMonth=function(fn){ window.__monthSubs.push(fn); };
window.__setMonth=function(ym){ if(!/^\d{4}-\d{2}$/.test(ym)) return; window.__ym=ym; var gi=document.getElementById('globalMonth'); if(gi) gi.value=ym; window.__monthSubs.forEach(function(fn){ try{fn(ym);}catch(e){} }); };
// เปิดมา -> เด้งไปเดือนล่าสุดที่มีข้อมูลจริงใน DB (กันเบราว์เซอร์จำเดือนเก่า)
(async function(){ try{ var sb=window.__getSB(); if(!sb) return;
  var r=await sb.from('daiki_attendance').select('work_date').order('work_date',{ascending:false}).limit(1);
  if(!r.error && r.data && r.data.length){ window.__setMonth(r.data[0].work_date.slice(0,7)); }
}catch(e){} })();</script>
<script>
(function(){
var ROOT=document.getElementById('view-dash');var $=function(id){return ROOT.querySelector('#'+id);};

"use strict";

// รหัสในช่องรายวัน -> หมวด
var STATUS = [
  {key:"present",  label:"มาทำงาน",  short:"มา",   color:"var(--present)",  codes:["1","1.0"]},
  {key:"late",     label:"มาสาย",    short:"สาย",  color:"var(--late)",     codes:["ส"]},
  {key:"sick",     label:"ลาป่วย",   short:"ป่วย", color:"var(--sick)",     codes:["ป"]},
  {key:"personal", label:"ลากิจ",    short:"กิจ",  color:"var(--personal)", codes:["ก"]},
  {key:"noscan",   label:"ลืมสแกน",  short:"ลืม",  color:"#C9A227", codes:["ล"]},
  {key:"vacation", label:"พักร้อน",  short:"พร",   color:"var(--vacation)",codes:["พ"]},
  {key:"absent",   label:"ขาดงาน",   short:"ขาด",  color:"var(--absent)",   codes:["ข"]},
  {key:"dayoff",   label:"หยุดประจำ",short:"หยุด", color:"var(--dayoff)",   codes:["w","W"]},
  {key:"holiday",  label:"วันหยุด",  short:"นข",   color:"var(--holiday)", codes:["h","H"]}
];
var CODE2KEY={}, KEYMAP={};
STATUS.forEach(function(s){ KEYMAP[s.key]=s; s.codes.forEach(function(c){CODE2KEY[c]=s.key;}); });
function classify(raw){
  if(raw==null) return "";
  var s=(""+raw).trim();
  if(s==="") return "";
  if(CODE2KEY[s]) return CODE2KEY[s];
  var f=parseFloat(s);
  if(!isNaN(f) && Math.abs(f-1)<1e-9) return "present";
  return "other";
}
var MONTH_TH={0:"ม.ค.",1:"ก.พ.",2:"มี.ค.",3:"เม.ย.",4:"พ.ค.",5:"มิ.ย.",6:"ก.ค.",7:"ส.ค.",8:"ก.ย.",9:"ต.ค.",10:"พ.ย.",11:"ธ.ค."};
var DOW_TH=["อา","จ","อ","พ","พฤ","ศ","ส"];

var DATA=null, sel={day:null, open:null};

function monthMeta(asOf, days){
  // asOf "YYYY-MM-DD"
  var y=2026,m=6; // default July(idx6)
  if(asOf){ var p=asOf.split("-"); y=+p[0]; m=(+p[1])-1; }
  var asOfDay = asOf? (+asOf.split("-")[2]) : 31;
  var dows = days.map(function(d){ return new Date(y,m,d).getDay(); });
  return {y:y,m:m,asOfDay:asOfDay,dows:dows};
}

// ------- aggregation -------
function computeEmp(e, days, meta){
  var c={present:0,late:0,sick:0,personal:0,vacation:0,absent:0,dayoff:0,holiday:0,other:0};
  var required=0; // วันที่ควรมาทำงาน (ไม่นับหยุดประจำ/วันหยุด/ช่องว่าง)
  e.cells.forEach(function(raw,i){
    var k=classify(raw);
    if(k==="") return;
    if(c[k]===undefined) c.other++; else c[k]++;
    if(k==="present"||k==="late"||k==="sick"||k==="personal"||k==="vacation"||k==="absent") required++;
  });
  var attended=c.present+c.late;
  e._c=c; e._req=required; e._att=attended;
  e._rate = required? Math.round(attended/required*100) : null;
  e._leave = c.sick+c.personal+c.vacation;
  return e;
}

function activeDays(days, emps){
  // วันที่มีข้อมูลอย่างน้อย 1 คน = วันที่นับไปแล้ว
  return days.map(function(d,i){
    var has=false;
    for(var j=0;j<emps.length;j++){ if((""+ (emps[j].cells[i]||"")).trim()!==""){has=true;break;} }
    return has;
  });
}

function dailyCounts(days, emps, i){
  var c={present:0,late:0,sick:0,personal:0,vacation:0,absent:0,dayoff:0,holiday:0,other:0};
  emps.forEach(function(e){ var k=classify(e.cells[i]); if(k==="")return; if(c[k]===undefined)c.other++; else c[k]++; });
  return c;
}

// ------- render -------
function fmt(n){ return (n||0).toLocaleString("en-US"); }

function render(){
  var d=DATA; var emps=d.employees; var days=d.days; var meta=d.meta;
  var act=d._active;

  // KPI = สรุป ณ วันล่าสุดที่มีข้อมูล
  var lastIdx=-1; for(var i=days.length-1;i>=0;i--){ if(act[i]){lastIdx=i;break;} }
  var today = lastIdx>=0? dailyCounts(days,emps,lastIdx):null;
  var totalStaff = emps.filter(function(e){ // นับเฉพาะคนที่มีข้อมูลเดือนนี้
      return e.cells.some(function(x){return (""+ (x||"")).trim()!==""; }); }).length;
  var sumLeave = today? today.sick+today.personal+today.vacation : 0;
  var camToday = today? today.present+today.late : 0;
  var kpiRate = today && (camToday+today.absent+sumLeave)>0
      ? Math.round(camToday/(camToday+today.absent+sumLeave)*100) : null;
  var dLabel = lastIdx>=0 ? (days[lastIdx]+" "+MONTH_TH[meta.m]) : "-";

  var kpiEl=document.getElementById("kpis");
  var K=[
    {c:"var(--navy)",   lab:"พนักงานทั้งหมด", v:totalStaff, cap:"คนที่มีข้อมูลเดือนนี้"},
    {c:"var(--present)",lab:"มาทำงานวันนี้", v:camToday, cap:"ล่าสุด "+dLabel},
    {c:"var(--absent)", lab:"ขาดงานวันนี้",  v:today?today.absent:0, cap:"ล่าสุด "+dLabel},
    {c:"var(--late)",   lab:"มาสายวันนี้",   v:today?today.late:0,   cap:"ล่าสุด "+dLabel},
    {c:"var(--sick)",   lab:"ลาวันนี้ (รวม)", v:sumLeave, cap:"ป่วย+กิจ+พักร้อน"},
    {c:"var(--orange)", lab:"อัตราการมา",    v:(kpiRate==null?"-":kpiRate), suf:(kpiRate==null?"":"%"), cap:"ของวันล่าสุด"}
  ];
  kpiEl.innerHTML=K.map(function(k){
    return '<div class="kpi" style="--c:'+k.c+'"><div class="lab"><span class="dot"></span>'+k.lab+
      '</div><div class="v num">'+fmt(k.v)+(k.suf?'<small>'+k.suf+'</small>':'')+
      '</div><div class="cap">'+k.cap+'</div></div>';
  }).join("");

  // daily steps
  var counts = days.map(function(_,i){ return act[i]? dailyCounts(days,emps,i):null; });
  var maxCame=1;
  counts.forEach(function(c){ if(c){ var v=c.present+c.late; if(v>maxCame)maxCame=v; } });
  var stepsEl=document.getElementById("steps");
  stepsEl.innerHTML = days.map(function(dnum,i){
    if(!act[i]) return '<div class="step future"><div class="bar-track"><div class="bar" style="height:4px"></div></div><div class="cnt">·</div><div class="date">'+dnum+'</div></div>';
    var c=counts[i]; var came=c.present+c.late; var h=Math.max(6,Math.round(came/maxCame*96));
    var dow=DOW_TH[meta.dows[i]];
    return '<div class="step'+(sel.day===i?' sel':'')+'" data-i="'+i+'">'+
      '<div class="bar-track"><div class="bar" style="height:'+h+'px"></div></div>'+
      '<div class="cnt num">'+came+'</div>'+
      '<div class="date"><b>'+dnum+'</b> '+MONTH_TH[meta.m]+'<br>'+dow+'</div></div>';
  }).join("");
  document.getElementById("dailySub").textContent = d.sheet + (d.asOf? " · ถึงวันที่ "+d.asOf : "");
  if(sel.day==null) sel.day=lastIdx;
  renderDayDetail(counts);

  stepsEl.querySelectorAll(".step[data-i]").forEach(function(el){
    el.onclick=function(){ sel.day=+el.dataset.i; render(); };
  });

  renderTable();
  renderLegend();
  document.getElementById("foot").textContent="MASARU · แดชบอร์ดการมาทำงาน — ข้อมูลจาก "+d.sheet+" ("+emps.length+" รายการ)";
}

function renderDayDetail(counts){
  var el=document.getElementById("dayDetail");
  var i=sel.day;
  if(i==null||!counts[i]){ el.innerHTML=""; return; }
  var c=counts[i]; var d=DATA;
  var head='วันที่ '+d.days[i]+' '+MONTH_TH[d.meta.m]+' '+(d.meta.y+543);
  var order=["present","late","sick","personal","vacation","absent","dayoff","holiday"];
  var chips=order.map(function(k){
    var s=KEYMAP[k];
    return '<span class="chip"><span class="cd" style="background:'+s.color+'"></span>'+s.label+' <b>'+c[k]+'</b></span>';
  }).join("");
  el.innerHTML='<span class="dh">'+head+'</span>'+chips;
}

function passFilter(e){
  var q=document.getElementById("q").value.trim().toLowerCase();
  var dept=document.getElementById("dept").value;
  if(dept && (e.pos||"")!==dept) return false;
  var grp=document.getElementById("grpFilter").value;
  if(grp==="__none"){ if(e.group) return false; } else if(grp){ if((e.group||"")!==grp) return false; }
  if(q){
    var hay=((e.name||"")+" "+(e.nick||"")).toLowerCase();
    if(hay.indexOf(q)<0) return false;
  }
  return true;
}

function renderTable(){
  var d=DATA; var emps=d.employees.slice();
  var sortv=document.getElementById("sort").value;
  var rows=emps.filter(passFilter);
  rows.sort(function(a,b){
    if(sortv==="default"||sortv==="name"){
      var la=window.__nameLangRank(a.name), lb=window.__nameLangRank(b.name);
      if(la!==lb) return la-lb;
    }
    switch(sortv){
      case "name": return (a.name||"").localeCompare(b.name||"","th");
      case "absent": return b._c.absent-a._c.absent;
      case "late": return b._c.late-a._c.late;
      case "leave": return b._leave-a._leave;
      case "rate": return (a._rate==null?999:a._rate)-(b._rate==null?999:b._rate);
      default: return a._idx-b._idx;
    }
  });
  document.getElementById("tblSub").textContent="แสดง "+rows.length+" จาก "+emps.length+" คน";

  function stat(v,cls){ return '<td><span class="stat '+(v?cls:'z')+'">'+(v||"–")+'</span></td>'; }
  var head='<table><thead><tr>'+
    '<th style="width:44px">#</th>'+
    '<th class="l">พนักงาน</th>'+
    '<th>มาทำงาน</th><th>มาสาย</th><th>ลาป่วย</th><th>ลากิจ</th><th class="hide">พักร้อน</th><th>ขาดงาน</th>'+
    '<th style="width:150px">อัตราการมา</th></tr></thead><tbody>';
  var body=rows.map(function(e){
    var c=e._c;
    var rate=e._rate;
    var rc = rate==null? "var(--dayoff)" : rate>=95?"var(--present)":rate>=85?"var(--late)":"var(--absent)";
    var tr='<tr class="emp-row" data-id="'+e._idx+'">'+
      '<td class="idx num">'+(e._idx+1)+'</td>'+
      '<td class="who"><div class="nm">'+esc(e.name)+(e.nick?' <span class="nick">('+esc(e.nick)+')</span>':'')+(e.group?'<span class="grpchip">'+esc(e.group)+'</span>':'')+'</div>'+
        '<div class="role">'+esc(e.pos||"—")+'</div></td>'+
      stat(c.present,"present")+stat(c.late,"late")+stat(c.sick,"sick")+stat(c.personal,"personal")+
      '<td class="hide"><span class="stat '+(c.vacation?'vacation':'z')+'">'+(c.vacation||"–")+'</span></td>'+
      stat(c.absent,"absent")+
      '<td><div class="rate">'+(rate==null?'<span class="rv" style="color:var(--muted)">–</span>':
        '<div class="rbar"><div class="rfill" style="width:'+rate+'%;background:'+rc+'"></div></div><span class="rv" style="color:'+rc+'">'+rate+'%</span>')+
        '</div></td></tr>';
    // timeline row
    var cells=e.cells.map(function(raw,i){
      var k=classify(raw); var s=KEYMAP[k];
      var m = s? s.short : (k==="other"? (""+raw).trim() : "");
      var cls = (k===""||k==="other")? "empty" : k;
      return '<div class="cell '+cls+'"><span class="d">'+d.days[i]+'</span><span class="m">'+(m||"·")+'</span></div>';
    }).join("");
    var tl='<tr class="tl-row"><td colspan="9"><div class="tl" id="tl'+e._idx+'">'+
      '<div class="tl-h">ไทม์ไลน์รายวัน · '+esc(e.name)+'</div><div class="tl-grid">'+cells+'</div></div></td></tr>';
    return tr+tl;
  }).join("");
  document.getElementById("tblWrap").innerHTML = rows.length? head+body+'</tbody></table>'
    : '<div class="empty-state"><h3>ไม่พบพนักงานตามเงื่อนไข</h3><div>ลองล้างคำค้นหาหรือเลือกแผนกอื่น</div></div>';

  document.querySelectorAll(".emp-row").forEach(function(tr){
    tr.onclick=function(){
      var id=+tr.dataset.id;
      var tl=document.getElementById("tl"+id);
      var isOpen=tl.classList.contains("open");
      document.querySelectorAll(".tl.open").forEach(function(x){x.classList.remove("open");});
      if(!isOpen) tl.classList.add("open");
    };
  });
}

function renderLegend(){
  document.getElementById("legend").innerHTML="คำอธิบายสี:&nbsp;&nbsp;"+STATUS.map(function(s){
    return '<span><i style="background:'+s.color+'"></i>'+s.label+'</span>';
  }).join("");
}

function esc(s){ return (""+(s==null?"":s)).replace(/[&<>]/g,function(m){return{"&":"&amp;","<":"&lt;",">":"&gt;"}[m];}); }

// ------- department options -------
function buildDept(){
  var set={}; DATA.employees.forEach(function(e){ if(e.pos) set[e.pos]=(set[e.pos]||0)+1; });
  var keys=Object.keys(set).sort(function(a,b){return set[b]-set[a];});
  var el=document.getElementById("dept");
  el.innerHTML='<option value="">ทุกแผนก / ตำแหน่ง</option>'+keys.map(function(k){
    return '<option value="'+esc(k)+'">'+esc(k)+' ('+set[k]+')</option>';
  }).join("");
  buildGroups();
}
function buildGroups(){
  var set={}, none=0; DATA.employees.forEach(function(e){ if(e.group) set[e.group]=(set[e.group]||0)+1; else none++; });
  var keys=Object.keys(set).sort(function(a,b){return a.localeCompare(b,'th');});
  var el=document.getElementById("grpFilter"); var cur=el.value;
  el.innerHTML='<option value="">ทุกแผนก</option>'+keys.map(function(k){
    return '<option value="'+esc(k)+'">แผนก: '+esc(k)+' ('+set[k]+')</option>';
  }).join("")+(none?'<option value="__none">(ไม่มีแผนก) ('+none+')</option>':'');
  if(cur) el.value=cur;
}

// ------- load a dataset (from demo or upload) -------
function loadData(d){
  d.meta = monthMeta(d.asOf, d.days);
  d.employees.forEach(function(e,i){ e._idx=i; computeEmp(e,d.days,d.meta); });
  d._active = activeDays(d.days, d.employees);
  DATA=d; sel.day=null;
  buildDept();
  render();
}

// ------- Excel upload / parse -------
function parseSheetToData(ws, sheetName){
  var A=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,defval:null});
  // find header row containing ชื่อ-นามสกุล
  var hr=-1;
  for(var i=0;i<A.length;i++){
    if(A[i] && A[i].some(function(c){return (""+ (c||"")).trim()==="ชื่อ-นามสกุล";})){ hr=i; break; }
  }
  if(hr<0) throw new Error("ไม่พบหัวตาราง 'ชื่อ-นามสกุล' ในชีตนี้ — เลือกชีตรูปแบบ Daiki");
  var H=A[hr];
  function col(label){ for(var j=0;j<H.length;j++){ if((""+ (H[j]||"")).trim()===label) return j; } return -1; }
  var cN=col("ชื่อ-นามสกุล"), cNick=col("ชื่อเล่น"), cPos=col("ตำแหน่ง"), cStart=col("เริ่มทำงาน"), cTen=col("อายุงาน");
  var daycols=[];
  for(var j=0;j<H.length;j++){
    var f=parseFloat((""+ (H[j]||"")).trim()); var dd=Math.round(f);
    if(!isNaN(f) && dd>=1 && dd<=31 && Math.abs(f-dd)<1e-6) daycols.push({d:dd,j:j});
  }
  daycols.sort(function(a,b){return a.d-b.d;});
  // as-of date: scan rows above+header for a date-like value
  var asOf=null;
  for(var i=0;i<=hr;i++){ if(!A[i])continue; for(var k=0;k<A[i].length;k++){ var v=A[i][k]; if(v && /^\d{4}-\d{2}-\d{2}/.test((""+v))){ asOf=(""+v).slice(0,10);} var dt=parseExcelDate(v); if(dt) asOf=dt; } }
  var emps=[];
  for(var r=hr+1;r<A.length;r++){
    var row=A[r]||[]; var nm=cN>=0?row[cN]:null;
    if(!(nm && (""+nm).trim()!=="")) continue;
    var cells=daycols.map(function(dc){
      var v=row[dc.j]; if(v==null) return "";
      var s=(""+v).trim(); if(s==="1"||s==="1.0") s="1"; return s;
    });
    // รหัสพนักงาน (เช่น DK-212) มักอยู่คอลัมน์ซ้ายของชื่อ — เก็บถ้ารูปแบบตรง
    var code="";
    if(cN>0 && row[cN-1]!=null){ var cc=(""+row[cN-1]).trim(); if(/^[A-Za-z]{1,4}-?\d+$/.test(cc)) code=cc; }
    emps.push({code:code, name:(""+nm).trim(), nick:cNick>=0&&row[cNick]!=null?(""+row[cNick]).trim():"",
      pos:cPos>=0&&row[cPos]!=null?(""+row[cPos]).trim():"", cells:cells});
  }
  return {sheet:sheetName, asOf:asOf, days:daycols.map(function(x){return x.d;}), employees:emps};
}
function parseExcelDate(v){
  if(v==null) return null;
  if(typeof v==="number" && v>30000 && v<60000){ // excel serial
    var dt=new Date(Math.round((v-25569)*86400*1000)); return dt.toISOString().slice(0,10);
  }
  var m=(""+v).match(/^(\d{4})-(\d{2})-(\d{2})/); if(m) return m[1]+"-"+m[2]+"-"+m[3];
  return null;
}

var WB=null;
document.getElementById("fileIn").addEventListener("change",function(ev){
  var f=ev.target.files[0]; if(!f) return;
  var rd=new FileReader();
  rd.onload=function(e){
    try{
      WB=XLSX.read(new Uint8Array(e.target.result),{type:"array",cellDates:false});
      var dt=document.getElementById("demoTag"); if(dt) dt.classList.remove("on");
      stageFromWB();
    }catch(err){ dbSay("อ่านไฟล์ไม่สำเร็จ: "+(err.message||err),"err"); }
  };
  rd.readAsArrayBuffer(f);
});
// ------- export -------
document.getElementById("exportBtn").addEventListener("click",function(){
  var d=DATA; var rows=d.employees.filter(passFilter);
  var aoa=[["ลำดับ","ชื่อ-นามสกุล","ชื่อเล่น","ตำแหน่ง","มาทำงาน","มาสาย","ลาป่วย","ลากิจ","พักร้อน","ขาดงาน","หยุดประจำ","วันหยุด","อัตราการมา(%)"]];
  rows.forEach(function(e,i){ var c=e._c;
    aoa.push([i+1,e.name,e.nick,e.pos,c.present,c.late,c.sick,c.personal,c.vacation,c.absent,c.dayoff,c.holiday,e._rate==null?"":e._rate]);
  });
  var ws=XLSX.utils.aoa_to_sheet(aoa);
  var wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,"สรุปการมาทำงาน");
  XLSX.writeFile(wb,"สรุปการมาทำงาน_"+(d.sheet||"Daiki").replace(/\s+/g,"_")+".xlsx");
});

// ------- controls wiring -------
["q","dept","grpFilter","sort"].forEach(function(id){
  document.getElementById(id).addEventListener("input",renderTable);
  document.getElementById(id).addEventListener("change",renderTable);
});

// ============ Supabase ============
// ⬇️ ใส่ค่าตายตัวตรงนี้ที่เดียว ไม่ต้องพิมพ์ทุกครั้ง
//    แก้ SUPABASE_URL เป็น Project URL ของคุณ (Supabase → Project Settings → API → Project URL)
var SUPABASE_URL="https://iyycyvnvfmerxkcfalea.supabase.co";
var SUPABASE_ANON_KEY="sb_publishable_ChkZClaeE6NCAxqyTqE4Yw_aTsz4zqi";
var SB=null;

function dbSay(msg,cls){ var el=$("dbMsg"); el.textContent=msg; el.className="dbmsg"+(cls?" "+cls:""); }

function pad2(n){return (n<10?"0":"")+n;}
function ymOfData(){ return DATA&&DATA.meta? DATA.meta.y+"-"+pad2(DATA.meta.m+1):""; }

function connectDB(){
  var url=$("dbUrl").value.trim()||SUPABASE_URL;
  var key=$("dbKey").value.trim()||SUPABASE_ANON_KEY;
  if(!url||!key){ dbSay("กรุณากรอก Supabase URL และ anon key","err"); return false; }
  if(!window.supabase){ dbSay("โหลดไลบรารี Supabase ไม่สำเร็จ (ตรวจอินเทอร์เน็ต)","err"); return false; }
  try{ SB=window.__getSB(); if(!SB) throw new Error("no client"); dbSay("เชื่อมต่อแล้ว ✓ — พร้อมนำเข้า/โหลดข้อมูล","ok"); return true; }
  catch(e){ dbSay("เชื่อมต่อไม่สำเร็จ: "+e.message,"err"); return false; }
}

// นำเข้าข้อมูลที่กำลังแสดงอยู่ (จาก Excel/demo) ขึ้น Supabase

function ymFromSheet(name){
  var MON={january:1,jan:1,february:2,feb:2,march:3,mar:3,april:4,apr:4,may:5,june:6,jun:6,july:7,jul:7,august:8,aug:8,september:9,sept:9,sep:9,october:10,oct:10,november:11,nov:11,december:12,dec:12};
  var s=name.toLowerCase(); var ym=name.match(/(19|20)\d{2}/); var yr=ym?+ym[0]:null; var mo=null;
  for(var k in MON){ if(new RegExp("\\b"+k+"\\b").test(s)){ mo=MON[k]; break; } }
  if(!yr||!mo) return null;
  return yr+"-"+(mo<10?"0"+mo:mo);
}
// นำเข้า = พักข้อมูลจากไฟล์ไว้ (staged) + พรีวิว ยังไม่เขียน DB จนกว่าจะกด "บันทึก"
function _sleep(ms){ return new Promise(function(r){ setTimeout(r,ms); }); }
function _errText(e){ if(!e) return "unknown"; return (e.message||e.msg||JSON.stringify(e))+(e.details?" | "+e.details:"")+(e.hint?" | "+e.hint:"")+(e.code?" ["+e.code+"]":""); }
function stageFromWB(){
  if(!WB){ dbSay("ยังไม่ได้อัปโหลดไฟล์","err"); return; }
  var names=WB.SheetNames.filter(function(n){ return /daiki/i.test(n); });
  var sheets=[];
  names.forEach(function(n){ var ym=ymFromSheet(n); if(!ym) return;
    try{ var d=parseSheetToData(WB.Sheets[n], n); if(d.employees.length) sheets.push({ym:ym,d:d}); }catch(e){} });
  if(!sheets.length){ dbSay("ไม่พบชีต Daiki ที่มีข้อมูล (ชื่อชีตต้องมี Daiki + เดือน + ปี)","err"); return; }
  sheets.sort(function(a,b){ return a.ym<b.ym?1:(a.ym>b.ym?-1:0); });
  var latestYM=sheets[0].ym;
  var latestNames={}; sheets[0].d.employees.forEach(function(e){ latestNames[e.name]=true; });
  var seen={}, roster=[];
  sheets.forEach(function(s){ s.d.employees.forEach(function(e){ if(seen[e.name]) return; seen[e.name]=true;
    roster.push({emp_code:e.code||null, full_name:e.name, nickname:e.nick||null, position:e.pos||null, seq:roster.length, is_active: !!latestNames[e.name]}); }); });
  var byMonth={}, total=0;
  sheets.forEach(function(s){
    byMonth[s.ym]={ days:s.d.days.slice(), employees:s.d.employees.map(function(e){ return {name:e.name,nick:e.nick,pos:e.pos,code:e.code,cells:e.cells.slice()}; }) };
    s.d.employees.forEach(function(e){ e.cells.forEach(function(raw){ var k=classify(raw); if(k&&k!=="other") total++; }); });
  });
  window.__staged={ byMonth:byMonth, roster:roster, latestYM:latestYM, monthsCount:sheets.length, count:total };
  var dt=document.getElementById("demoTag"); if(dt) dt.classList.remove("on");
  if(window.__updateSaveUI) window.__updateSaveUI();
  window.__setMonth(latestYM);   // พรีวิวเดือนล่าสุด (ทุกแท็บอ่านจาก staged)
  dbSay("โหลดจากไฟล์แล้ว "+sheets.length+" เดือน · "+total+" รายการ — ยังไม่บันทึก กด 💾 บันทึก","ok");
}

// บันทึกทุกอย่างที่ staged ลง DB (global — ปุ่มบนแถบเมนู)
window.__commitStaged=async function(){
  var st=window.__staged; if(!st){ dbSay("ไม่มีข้อมูลรอบันทึก (อัปโหลดไฟล์ก่อน)","err"); return; }
  if(!SB && !connectDB()) return;
  window.__importing=true;
  var btn=document.getElementById("btnSave"); if(btn) btn.disabled=true;
  try{
    dbSay("กำลังบันทึกพนักงาน "+st.roster.length+" คน...","");
    var up=await SB.from("daiki_employees").upsert(st.roster,{onConflict:"full_name"}).select("id,full_name");
    if(up.error){
      // เผื่อยังไม่ได้รัน migrate (คอลัมน์ seq/is_active ไม่มี) → ลองใหม่แบบใส่เฉพาะคอลัมน์พื้นฐาน
      console.error("employee upsert error (full):", up.error);
      var minimal=st.roster.map(function(e){ return {emp_code:e.emp_code, full_name:e.full_name, nickname:e.nickname, position:e.position}; });
      up=await SB.from("daiki_employees").upsert(minimal,{onConflict:"full_name"}).select("id,full_name");
      if(up.error) throw new Error("บันทึกพนักงานไม่สำเร็จ: "+_errText(up.error));
      dbSay("⚠ บันทึกพนักงานแบบพื้นฐาน (ยังไม่ได้รัน migrate seq) — ลำดับ/สถานะลาออกอาจไม่ครบ","");
    }
    var idByName={}; up.data.forEach(function(r){ idByName[r.full_name]=r.id; });
    if(!Object.keys(idByName).length) throw new Error("ไม่ได้ id พนักงานกลับมา (ตรวจ RLS/สิทธิ์ SELECT)");

    // เขียน "ทีละเดือน" เป็นก้อนเดียว/เดือน (ลดจำนวน request + กันชนกัน)
    var yms=Object.keys(st.byMonth).sort(); // เก่า->ใหม่
    var totalDone=0, failMsg="", failYM="";
    for(var mi=0; mi<yms.length; mi++){
      var ym=yms[mi], y=+ym.slice(0,4), mo=+ym.slice(5,7), mn=st.byMonth[ym];
      var seenAtt={}, rows=[];
      mn.employees.forEach(function(e){ var eid=idByName[e.name]; if(!eid) return;
        e.cells.forEach(function(raw,i){ var k=classify(raw); if(k===""||k==="other") return;
          var day=mn.days[i]; var dt=new Date(y,mo-1,day); if(dt.getMonth()!==mo-1) return;
          var wd=ym+"-"+pad2(day); var key=eid+"|"+wd; if(seenAtt[key]) return; seenAtt[key]=true;
          rows.push({employee_id:eid, work_date:wd, raw_code:(""+raw).trim(), status_key:k, source:"excel_import"}); }); });
      dbSay("["+(mi+1)+"/"+yms.length+"] กำลังบันทึกเดือน "+ym+" ("+rows.length+" แถว)...","");
      // upsert ทั้งเดือนในครั้งเดียว (retry 3 ครั้ง); ถ้าเดือนใหญ่มากค่อยซอย 1000
      var ok=false, le=null;
      var batches=[]; if(rows.length<=1500){ batches=[rows]; } else { for(var b=0;b<rows.length;b+=1000) batches.push(rows.slice(b,b+1000)); }
      ok=true;
      for(var bi=0; bi<batches.length && ok; bi++){
        var wrote=false, err2=null;
        for(var a=0;a<3 && !wrote;a++){ if(a>0) await _sleep(600*a);
          var r=await SB.from("daiki_attendance").upsert(batches[bi],{onConflict:"employee_id,work_date"});
          if(r.error){ err2=r.error; } else { wrote=true; } }
        if(!wrote){ ok=false; le=err2; } else { totalDone+=batches[bi].length; }
      }
      if(!ok){ failMsg=_errText(le); failYM=ym; console.error("attendance upsert fail month",ym,le); break; }
      await _sleep(150);
    }

    if(failMsg){
      dbSay("บันทึกไม่ครบ (หยุดที่เดือน "+failYM+", เขียนไปแล้ว "+totalDone+" แถว): "+failMsg,"err");
      alert("บันทึกไม่ครบ!\\nหยุดที่เดือน "+failYM+" · เขียนไปแล้ว "+totalDone+" แถว\\n\\nError จริงจาก DB:\\n"+failMsg+"\\n\\n(ก๊อปข้อความนี้ส่งให้ผู้พัฒนา)");
    } else {
      window.__staged=null; if(window.__updateSaveUI) window.__updateSaveUI();
      dbSay("บันทึกครบ ✓ "+st.monthsCount+" เดือน · พนักงาน "+st.roster.length+" คน · "+totalDone+" รายการ","ok");
    }
  }catch(e){ dbSay("บันทึกไม่สำเร็จ: "+_errText(e),"err"); alert("บันทึกไม่สำเร็จ:\\n"+_errText(e)); }
  finally{
    window.__importing=false; if(btn) btn.disabled=false;
    window.__setMonth(window.__ym);                                             // โหลดใหม่จาก DB
  }
};

// โหลดข้อมูลเดือนที่เลือกจาก Supabase มาแสดง
var dashReq=0;
async function loadFromDB(){
  var ym=window.__ym || ymOfData();
  if(!/^\d{4}-\d{2}$/.test(ym)){ dbSay("เลือกเดือนก่อน (ช่องเดือน)","err"); return; }
  if(window.__staged && window.__staged.byMonth[ym]){        // พรีวิวจากไฟล์ (ยังไม่บันทึก)
    var mn=window.__staged.byMonth[ym]; var last=mn.days[mn.days.length-1];
    loadData({sheet:"📄 พรีวิวจากไฟล์ (ยังไม่บันทึก) "+ym, asOf:ym+"-"+pad2(last), days:mn.days.slice(),
      employees:mn.employees.map(function(e){ return {code:e.code,name:e.name,nick:e.nick,pos:e.pos,cells:e.cells.slice()}; })});
    dbSay("พรีวิวจากไฟล์ เดือน "+ym+" — ยังไม่บันทึก (กด 💾 บันทึก)","");
    return;
  }
  if(!SB && !connectDB()) return;
  var myReq=++dashReq;   // กันผลเก่ามาทับเมื่อสลับเดือนเร็ว ๆ
  try{
    dbSay("กำลังโหลดข้อมูลเดือน "+ym+"...","");
    var start=ym+"-01";
    var y=+ym.slice(0,4), m=+ym.slice(5,7);
    var end=(m===12?(y+1)+"-01":y+"-"+pad2(m+1))+"-01";
    var rdata=await window.__pageAll(function(f,t){ return SB.from("daiki_attendance")
      .select("work_date,raw_code,status_key,daiki_employees(id,full_name,nickname,position,emp_code,seq,is_active,group_name)")
      .gte("work_date",start).lt("work_date",end).order("employee_id",{ascending:true}).order("work_date",{ascending:true}).range(f,t); });
    if(myReq!==dashReq) return;
    if(!rdata.length){
      var ndays=new Date(+ym.slice(0,4), +ym.slice(5,7), 0).getDate();
      var alld=[]; for(var dd=1;dd<=ndays;dd++) alld.push(dd);
      loadData({sheet:"ฐานข้อมูล "+ym, asOf:ym+"-01", days:alld, employees:[]});  // ล้างเป็นว่าง
      $("demoTag").classList.remove("on");
      dbSay("ไม่พบข้อมูลเดือน "+ym+" ในฐานข้อมูล — ตารางว่าง","err");
      return;
    }
    // ประกอบเป็นโครงสร้าง DATA
    var daySet={}, empMap={};
    rdata.forEach(function(row){
      var e=row.daiki_employees||{};
      if(e.is_active===false) return;                 // ซ่อนคนลาออกในแดชบอร์ด
      var day=+row.work_date.slice(8,10); daySet[day]=1;
      var nm=e.full_name||"(ไม่ระบุ)";
      if(!empMap[nm]) empMap[nm]={id:e.id,code:e.emp_code||"",name:nm,nick:e.nickname||"",pos:e.position||"",seq:(e.seq==null?999999:e.seq),group:e.group_name||"",byDay:{}};
      empMap[nm].byDay[day]=row.raw_code||statusToRaw(row.status_key);
    });
    var days=Object.keys(daySet).map(Number).sort(function(a,b){return a-b;});
    var employees=Object.keys(empMap).map(function(nm){ return empMap[nm]; });
    window.__groupSort(employees, function(r){return r.seq;}, function(r){return r.group||"";});
    employees=employees
      .map(function(e){ e.cells=days.map(function(d){ return e.byDay[d]!=null? (""+e.byDay[d]):""; }); delete e.byDay; return e; });
    var lastDay=days[days.length-1];
    if(myReq!==dashReq) return;                 // ทิ้งผลเก่าถ้าสลับเดือนแล้ว
    loadData({sheet:"ฐานข้อมูล "+ym, asOf:ym+"-"+pad2(lastDay), days:days, employees:employees});
    $("demoTag").classList.remove("on");
    dbSay("โหลดจาก DB สำเร็จ ✓ เดือน "+ym+" · "+employees.length+" คน","ok");
  }catch(e){ dbSay("โหลดไม่สำเร็จ: "+(e.message||e),"err"); }
}
function statusToRaw(k){ var s=KEYMAP[k]; return s? s.codes[0]:""; }

$("dbConnect").addEventListener("click",connectDB);
window.__onMonth(function(){ loadFromDB(); });   // เดือนกลางเปลี่ยน = โหลดใหม่

// ------- init with demo -------
loadData(JSON.parse($("demoData").textContent));

// ------- auto-connect ถ้าตั้งค่า URL/key ไว้แล้ว -------
(function autoDB(){
  var ready = SUPABASE_URL && SUPABASE_ANON_KEY && !/PASTE-PROJECT-URL/.test(SUPABASE_URL);
  $("dbUrl").value = /PASTE-PROJECT-URL/.test(SUPABASE_URL)? "" : SUPABASE_URL;
  $("dbKey").value = SUPABASE_ANON_KEY;
  if(ready && connectDB()){ loadFromDB(); }   // เชื่อม + โหลดเดือนปัจจุบันจาก DB อัตโนมัติ
})();

window.__dashRefresh=function(){try{if(SB)loadFromDB();}catch(e){}};
})();
</script>
<script>
(function(){
var ROOT=document.getElementById('view-grid');var $=function(id){return ROOT.querySelector('#'+id);};

"use strict";


// ============ ตั้งค่า Supabase (ใส่ที่เดียว ไม่ต้องพิมพ์ทุกครั้ง) ============
//   แก้ SUPABASE_URL เป็น Project URL ของคุณ (Supabase → Project Settings → API → Project URL)
var SUPABASE_URL="https://iyycyvnvfmerxkcfalea.supabase.co";
var SUPABASE_ANON_KEY="sb_publishable_ChkZClaeE6NCAxqyTqE4Yw_aTsz4zqi";

var STATUS=[
  {key:"present", label:"มาทำงาน", code:"1", color:"var(--present)"},
  {key:"late",    label:"มาสาย",   code:"ส", color:"var(--late)"},
  {key:"sick",    label:"ลาป่วย",  code:"ป", color:"var(--sick)"},
  {key:"personal",label:"ลากิจ",   code:"ก", color:"var(--personal)"},
  {key:"noscan",  label:"ลืมสแกน", code:"ล", color:"#C9A227"},
  {key:"vacation",label:"พักร้อน", code:"พ", color:"var(--vacation)"},
  {key:"absent",  label:"ขาดงาน",  code:"ข", color:"var(--absent)"},
  {key:"dayoff",  label:"หยุดประจำ",code:"w",color:"var(--dayoff)"},
  {key:"holiday", label:"วันหยุด", code:"h", color:"var(--holiday)"}
];
var KEYMAP={}, CODE2KEY={};
STATUS.forEach(function(s){ KEYMAP[s.key]=s; CODE2KEY[s.code]=s.key; if(s.key==="present")CODE2KEY["1.0"]=s.key; });
window.__scoreData=function(){ return {EMP:EMP, Y:Y, M:M, classify:classify, KEYMAP:KEYMAP}; };
// แปรงกรอก — ลาป่วย/ลากิจ แยกได้ตัง(paid)/ไม่ได้ตัง(unpaid)
var BRUSHES=[
  {k:"present", label:"มาทำงาน",  code:"1", color:"var(--present)"},
  {k:"late",    label:"มาสาย",    code:"ส", color:"var(--late)"},
  {k:"sick",    label:"ลาป่วย",   code:"ป", color:"var(--sick)",    leave:true},
  {k:"personal",label:"ลากิจ",    code:"ก", color:"var(--personal)",leave:true},
  {k:"noscan",  label:"ลืมสแกน",   code:"ล", color:"#C9A227"},
  {k:"vacation",label:"พักร้อน",  code:"พ", color:"var(--vacation)"},
  {k:"absent",  label:"ขาดงาน",   code:"ข", color:"var(--absent)"},
  {k:"dayoff",  label:"หยุดประจำ",code:"w", color:"var(--dayoff)"},
  {k:"holiday", label:"วันหยุด",  code:"h", color:"var(--holiday)"}
];
var BRUSHMAP={}; BRUSHES.forEach(function(b){ BRUSHMAP[b.k]=b; });
function classify(raw){ if(raw==null) return ""; var s=(""+raw).trim(); if(s==="")return"";
  if(CODE2KEY[s])return CODE2KEY[s]; if(parseFloat(s)===1)return"present"; return "other"; }
var DOW_TH=["อา","จ","อ","พ","พฤ","ศ","ส"];
var MONTH_TH=["ม.ค.","ก.พ.","มี.ค.","เม.ย.","พ.ค.","มิ.ย.","ก.ค.","ส.ค.","ก.ย.","ต.ค.","พ.ย.","ธ.ค."];

// ---------- state ----------
var Y=2026, M=6;            // M = 0-based month (July=6)
var EMP=[];                  // {id, dbId, code, name, nick, pos, cells:{day:rawCode}}
var brush="present";
var paidMode="paid";   // ได้ตัง/ไม่ได้ตัง สำหรับแปรงลาป่วย/ลากิจ
var leaveHours=8;      // ชั่วโมงที่ลา (1 วัน = 8 ชม.)
var SB=null, LIVE=false, channel=null;

function daysInMonth(y,m){ return new Date(y,m+1,0).getDate(); }
function ymd(day){ return Y+"-"+p2(M+1)+"-"+p2(day); }
function p2(n){ return (n<10?"0":"")+n; }
function esc(s){ return (""+(s==null?"":s)).replace(/[&<>]/g,function(m){return{"&":"&amp;","<":"&lt;",">":"&gt;"}[m];}); }

// ---------- brushes ----------
function renderBrushes(){
  var html=BRUSHES.map(function(b){
    var btn='<button class="brush'+(brush===b.k?' active':'')+'" data-k="'+b.k+'">'+
      '<span class="sw" style="background:'+b.color+'">'+b.code+'</span>'+b.label+'</button>';
    if(b.leave && brush===b.k){
      btn+='<select class="brush-drop" data-role="paid">'+
        '<option value="paid"'+(paidMode==="paid"?" selected":"")+'>ได้ตัง 💰</option>'+
        '<option value="unpaid"'+(paidMode==="unpaid"?" selected":"")+'>ไม่ได้ตัง ฿̶</option></select>';
      var hopts='<option value="8"'+(leaveHours==8?" selected":"")+'>เต็มวัน (8ชม)</option>';
      for(var hh=1;hh<=7;hh++) hopts+='<option value="'+hh+'"'+(leaveHours==hh?" selected":"")+'>'+hh+' ชม.</option>';
      btn+='<select class="brush-drop" data-role="hours">'+hopts+'</select>';
    }
    return btn;
  }).join("");
  html+='<button class="brush eraser'+(brush==="__erase"?' active':'')+'" data-k="__erase"><span class="sw"></span>ล้าง</button>';
  html+='<button class="brush note'+(brush==="__note"?' active':'')+'" data-k="__note"><span class="sw" style="background:var(--ink)">✎</span>โน๊ต</button>';
  $("brushList").innerHTML=html;
  $("brushList").querySelectorAll(".brush").forEach(function(b){
    b.onclick=function(){ brush=(brush===b.dataset.k)?null:b.dataset.k; renderBrushes(); updateGridCursor(); };
  });
  $("brushList").querySelectorAll(".brush-drop").forEach(function(s){
    s.onclick=function(ev){ ev.stopPropagation(); };
    s.onchange=function(){ if(s.dataset.role==="hours"){ leaveHours=+s.value; } else { paidMode=s.value; } };
  });
}

// ---------- grid ----------
function buildGridGroups(){
  var set={},none=0; EMP.forEach(function(e){ if(e.group)set[e.group]=(set[e.group]||0)+1; else none++; });
  var keys=Object.keys(set).sort(function(a,b){return a.localeCompare(b,"th");});
  var el=$("gridGroup"); if(!el)return; var cur=el.value;
  el.innerHTML='<option value="">ทุกแผนก</option>'+keys.map(function(k){return '<option value="'+esc(k)+'">แผนก: '+esc(k)+' ('+set[k]+')</option>';}).join("")+(none?'<option value="__none">(ไม่มีแผนก) ('+none+')</option>':'');
  if(cur)el.value=cur;
}
function applyGridFilter(){
  var q=($("gridSearch").value||"").trim().toLowerCase();
  var grp=$("gridGroup")?$("gridGroup").value:"";
  var rows=$("grid").querySelectorAll("tbody tr"); var shown=0;
  rows.forEach(function(tr,idx){ var e=EMP[idx]; if(!e){tr.style.display="none";return;}
    var hay=((e.name||"")+" "+(e.nick||"")+" "+(e.pos||"")).toLowerCase();
    var ok=!q||hay.indexOf(q)>=0;
    if(ok && grp){ if(grp==="__none"){ if(e.group)ok=false; } else if((e.group||"")!==grp)ok=false; }
    tr.style.display=ok?"":"none"; if(ok)shown++; });
  var c=$("gridCount"); if(c) c.textContent=(q||grp)?("พบ "+shown+"/"+EMP.length+" คน"):(EMP.length+" คน");
}
function renderGrid(){
  var nd=daysInMonth(Y,M);
  var head='<thead><tr>'+
    '<th class="cn c-idx">#</th>'+
    '<th class="cn c-name" style="text-align:left;padding-left:10px">พนักงาน ('+EMP.length+')</th>'+
    '<th class="cn c-sum">มา</th>';
  for(var d=1;d<=nd;d++){
    var dow=new Date(Y,M,d).getDay(); var wk=(dow===0||dow===6);
    head+='<th class="hcol'+(wk?' wknd':'')+'"><div class="dnum">'+d+'</div><div class="dow">'+DOW_TH[dow]+'</div></th>';
  }
  head+='</tr></thead>';

  var body='<tbody>';
  EMP.forEach(function(e,idx){
    body+='<tr>'+
      '<td class="cn c-idx idx num" style="color:var(--muted)">'+(idx+1)+'</td>'+
      '<td class="cn c-name"><div class="nm">'+esc(e.name)+(e.nick?' <span class="nick">('+esc(e.nick)+')</span>':'')+'</div><div class="role">'+esc(e.pos||"—")+(e.group?' <span class="grpchip">'+esc(e.group)+'</span>':'')+(e.active===false?' · <span style="color:var(--absent)">ลาออก</span>':'')+'</div></td>'+
      '<td class="cn c-sum" id="sum_'+idx+'">0</td>';
    for(var d=1;d<=nd;d++){
      var raw=e.cells[d]||""; var k=classify(raw); var dow=new Date(Y,M,d).getDay(); var wk=(dow===0||dow===6);
      var cls=(k&&k!=="other")?k:(wk?"wknd":"");
      var nt=e.notes&&e.notes[d]?e.notes[d]:"";
      var unpaid=(e.paid&&e.paid[d]===false);
      var hrs=(e.hours&&e.hours[d]);
      var tip=[]; if(hrs&&hrs<8)tip.push("ลา "+hrs+" ชม."); if(unpaid)tip.push("ไม่ได้ค่าจ้าง"); if(nt)tip.push("📝 "+nt);
      body+='<td class="cell '+cls+(nt?" has-note":"")+(unpaid?" unpaid":"")+(hrs?" partial":"")+'" id="c_'+idx+'_'+d+'" data-i="'+idx+'" data-d="'+d+'"'+(tip.length?' title="'+esc(tip.join(" · "))+'"':'')+'>'+((raw==="1"?"1":esc(raw))+((hrs&&hrs<8)?String(hrs):""))+'</td>';
    }
    body+='</tr>';
  });
  body+='</tbody>';

  var foot='<tfoot><tr><td class="cn c-idx"></td><td class="cn c-name foot-lab">มาทำงาน (คน)</td><td class="cn c-sum" id="grand">0</td>';
  for(var d=1;d<=nd;d++){ foot+='<td id="col_'+d+'">0</td>'; }
  foot+='</tr></tfoot>';

  $("grid").innerHTML=head+body+foot;
  wireCells();
  recomputeAll();
  updateGridCursor();
  buildGridGroups();
  applyGridFilter();
  window.__gridFit();
}

// ---------- editing ----------
var painting=false;
function wireCells(){
  var cells=$("grid").querySelectorAll("td.cell");
  cells.forEach(function(td){
    td.addEventListener("mousedown",function(ev){ ev.preventDefault();
      if(!brush){ return; }
      if(brush==="__note"){ editNote(+td.dataset.i,+td.dataset.d); return; }
      painting=true; applyBrush(+td.dataset.i,+td.dataset.d); });
    td.addEventListener("mouseenter",function(){ if(painting && brush!=="__note") applyBrush(+td.dataset.i,+td.dataset.d); });
  });
}
document.addEventListener("mouseup",function(){ painting=false; });

// ---------- โน๊ตรายวัน ----------
function editNote(idx,day){
  var e=EMP[idx]; if(!e) return;
  var cur=(e.notes&&e.notes[day])||"";
  var t=prompt("โน๊ตวันที่ "+day+" — "+e.name+"\n(ลบข้อความแล้วตกลง = ลบโน๊ต)", cur);
  if(t===null) return;            // กดยกเลิก
  t=t.trim();
  if(!e.notes) e.notes={};
  if(t===""){ delete e.notes[day]; } else { e.notes[day]=t; }
  paintCell(idx,day);
  saveNote(idx,day,t===""?null:t);
}
function saveNote(idx,day,text){ markDirty(idx,day); }   // ค้างไว้ บันทึกด้วยปุ่ม 💾

function applyBrush(idx,day){
  var e=EMP[idx]; if(!e) return; if(!e.paid) e.paid={}; if(!e.notes) e.notes={}; if(!e.hours) e.hours={};
  var erase=(brush==="__erase");
  var b=erase?null:BRUSHMAP[brush]; if(!erase && !b) return;
  var code=erase?"":b.code;
  var isLeave=(!erase && b.leave);
  var unpaid=isLeave && paidMode==="unpaid";
  var paid=erase?undefined:(isLeave?(unpaid?false:true):undefined);   // true/false/undefined
  var cur=e.cells[day]||"";
  var curHrs=(e.hours&&e.hours[day])||null;
  var tgtHrs=(isLeave && leaveHours && leaveHours<8)?leaveHours:null;
  if(erase){ if(cur==="" && e.paid[day]===undefined && e.notes[day]==null) return; }
  else if(cur===code && (e.paid[day]===false)===(paid===false) && curHrs===tgtHrs) return;
  if(erase){ delete e.cells[day]; delete e.paid[day]; delete e.notes[day]; delete e.hours[day]; }   // ล้างโน๊ต+ชม.ด้วย
  else{ e.cells[day]=code; if(paid===false) e.paid[day]=false; else delete e.paid[day];
        if(isLeave && leaveHours && leaveHours<8) e.hours[day]=leaveHours; else delete e.hours[day]; }
  paintCell(idx,day);
  recomputeSoon();
  markDirty(idx,day);
}

function paintCell(idx,day){
  var td=$("c_"+idx+"_"+day); if(!td) return;
  var e=EMP[idx]; var raw=e.cells[day]||""; var k=classify(raw);
  var dow=new Date(Y,M,day).getDay(); var wk=(dow===0||dow===6);
  var nt=(e.notes&&e.notes[day])||"";
  var unpaid=(e.paid&&e.paid[day]===false);
  var hrs=(e.hours&&e.hours[day]);
  td.className="cell "+((k&&k!=="other")?k:(wk?"wknd":""))+(nt?" has-note":"")+(unpaid?" unpaid":"")+(hrs?" partial":"");
  td.textContent = (raw==="1"?"1":raw)+((hrs&&hrs<8)?String(hrs):"");
  var tip=[]; if(hrs&&hrs<8)tip.push("ลา "+hrs+" ชม."); if(unpaid)tip.push("ไม่ได้ค่าจ้าง"); if(nt)tip.push("📝 "+nt);
  if(tip.length) td.title=tip.join(" · "); else td.removeAttribute("title");
}
function flashCell(idx,day){ var td=$("c_"+idx+"_"+day); if(!td)return; td.classList.remove("flash"); void td.offsetWidth; td.classList.add("flash"); }
function updateGridCursor(){ var g=$("grid"); if(g) g.classList.toggle("nobrush", !brush); }
window.__gridFit=function(){};   // เลื่อนทั้งหน้า ไม่ต้องคุมความสูงกล่อง
window.addEventListener("resize", window.__gridFit);

var recomputeTimer=null;
function recomputeSoon(){ if(recomputeTimer)return; recomputeTimer=requestAnimationFrame(function(){recomputeTimer=null;recomputeAll();}); }
function recomputeAll(){
  var nd=daysInMonth(Y,M); var colCame=new Array(nd+1).fill(0); var grand=0;
  EMP.forEach(function(e,idx){
    var came=0;
    for(var d=1;d<=nd;d++){ var k=classify(e.cells[d]); if(k==="present"||k==="late"){came++;colCame[d]++;} }
    var el=$("sum_"+idx); if(el) el.textContent=came;
  });
  for(var d=1;d<=nd;d++){ var el=$("col_"+d); if(el) el.textContent=colCame[d]; grand+=colCame[d]; }
  var g=$("grand"); if(g) g.textContent=grand;
}

// ---------- แก้ค้างไว้ บันทึกด้วยปุ่ม 💾 บนแถบเมนู (ไม่มี realtime) ----------
var dirty={}, loadedYM=null;
function setSave(state,txt){ var el=$("saveInd"); if(!el)return; el.className="save-ind "+(state||""); var t=$("saveTxt"); if(t)t.textContent=txt; }
function markDirty(idx,day){ dirty[idx+"|"+day]=true; updateDirtyUI(); }
function updateDirtyUI(){ var n=Object.keys(dirty).length; setSave(n?"saving":"saved", n?("แก้แล้ว "+n+" ช่อง — กด 💾 บันทึก"):"ยังไม่มีการแก้"); if(window.__updateSaveUI) window.__updateSaveUI(); }
window.__gridDirty=function(){ return Object.keys(dirty).length>0; };
window.__saveGrid=async function(){
  if(!SB && !connectDB()) return false;
  var keys=Object.keys(dirty); if(!keys.length){ setSave("saved","ไม่มีการแก้"); return true; }
  var ups=[], dels=[];
  keys.forEach(function(k){ var p=k.split("|"), idx=+p[0], day=+p[1]; var e=EMP[idx]; if(!e||!e.dbId) return;
    var code=e.cells[day]||""; var note=(e.notes&&e.notes[day])||null; var paid=(e.paid&&e.paid[day]===false)?false:null;
    var hrs=(e.hours&&e.hours[day])||null;
    var wd=Y+"-"+p2(M+1)+"-"+p2(day);
    if(code===""&&!note){ dels.push({employee_id:e.dbId,work_date:wd}); }
    else{ ups.push({employee_id:e.dbId,work_date:wd,raw_code:code||null,status_key:code?classify(code):null,is_paid:paid,note:note,hours:hrs,source:"grid"}); }
  });
  try{ setSave("saving","กำลังบันทึก...");
    var hoursWarn=false;
    for(var i=0;i<ups.length;i+=500){ var chunk=ups.slice(i,i+500);
      var r=await SB.from("daiki_attendance").upsert(chunk,{onConflict:"employee_id,work_date"});
      if(r.error){
        // เผื่อยังไม่มีคอลัมน์ hours (ยังไม่รัน migrate4) → ลองใหม่แบบไม่ใส่ hours
        var chunk2=chunk.map(function(x){ var y={}; for(var kk in x) if(kk!=="hours") y[kk]=x[kk]; return y; });
        var r2=await SB.from("daiki_attendance").upsert(chunk2,{onConflict:"employee_id,work_date"});
        if(r2.error) throw r2.error;
        hoursWarn=true;
      }
    }
    for(var j=0;j<dels.length;j++){ var dr=await SB.from("daiki_attendance").delete().match(dels[j]); if(dr.error) throw dr.error; }
    dirty={}; updateDirtyUI();
    if(hoursWarn){ setSave("err","บันทึกแล้ว แต่ยังเก็บชั่วโมงไม่ได้ — ต้องรัน daiki_migrate4.sql"); alert("บันทึกข้อมูลแล้ว ✓ แต่ยังเก็บชั่วโมงลาไม่ได้ เพราะยังไม่ได้รัน daiki_migrate4.sql ใน Supabase — รัน SQL นั้นก่อน แล้วบันทึกใหม่ ชั่วโมงจะถูกเก็บ"); }
    else { setSave("saved","บันทึกแล้ว ✓"); }
    return true;
  }catch(e){ setSave("err","บันทึกไม่สำเร็จ: "+(e.message||e)); alert("บันทึกไม่สำเร็จ: "+(e.message||e)); return false; }
};
// ---------- add employee ----------
$("gridSearch").addEventListener("input",applyGridFilter);
$("gridGroup").addEventListener("change",applyGridFilter);
$("addEmp").addEventListener("click", async function(){
  var name=prompt("ชื่อ-นามสกุล:"); if(!name||!name.trim())return; name=name.trim();
  var nick=(prompt("ชื่อเล่น (เว้นว่างได้):")||"").trim();
  var pos=(prompt("ตำแหน่ง (เว้นว่างได้):")||"").trim();
  var row={id:"tmp_"+Date.now(), dbId:null, code:"", name:name, nick:nick, pos:pos, cells:{}, notes:{}, paid:{}, hours:{}};
  if(LIVE){
    try{ var r=await SB.from("daiki_employees").upsert({full_name:name,nickname:nick||null,position:pos||null},{onConflict:"full_name"}).select("id").single();
      if(r.error) throw r.error; row.dbId=r.data.id; }
    catch(e){ alert("เพิ่มพนักงานไม่สำเร็จ: "+(e.message||e)); return; }
  }
  EMP.push(row); renderGrid();
});

// ---------- Supabase ----------
function connectDB(){
  var url=$("dbUrl").value.trim()||SUPABASE_URL, key=$("dbKey").value.trim()||SUPABASE_ANON_KEY;
  if(/PASTE-PROJECT-URL/.test(url)) url="";
  if(!url||!key){ dbSay("ใส่ Supabase URL ในโค้ด (ตัวแปร SUPABASE_URL) ก่อน","err"); return false; }
  if(!window.supabase){ dbSay("โหลดไลบรารี Supabase ไม่สำเร็จ","err"); return false; }
  try{ SB=window.__getSB(); if(!SB) throw new Error("no client"); dbSay("เชื่อมต่อแล้ว ✓ กด \"โหลดเดือนนี้\"","ok"); return true; }
  catch(e){ dbSay("เชื่อมต่อไม่สำเร็จ: "+e.message,"err"); return false; }
}
function dbSay(msg,cls){ var el=$("dbMsg"); el.textContent=msg; el.className="dbmsg"+(cls?" "+cls:""); }

async function loadMonth(){
  var mv=window.__ym||(Y+"-"+p2(M+1)); if(/^\d{4}-\d{2}$/.test(mv)){ Y=+mv.slice(0,4); M=(+mv.slice(5,7))-1; }
  if(!SB && !connectDB()) return;
  try{
    dbSay("กำลังโหลดพนักงาน...","");
    var erdata=await window.__pageAll(function(f,t){ return SB.from("daiki_employees").select("id,emp_code,full_name,nickname,position,is_active,seq,group_name,start_date").order("seq",{ascending:true,nullsFirst:false}).order("full_name",{ascending:true}).range(f,t); });
    if(!erdata.length){ dbSay("ยังไม่มีพนักงานใน DB — นำเข้าจากแดชบอร์ดก่อน หรือกด \"＋ เพิ่มพนักงาน\"","err"); }
    dbSay("กำลังโหลดข้อมูลเดือน "+mv+"...","");
    var start=Y+"-"+p2(M+1)+"-01", end=(M===11?(Y+1)+"-01":Y+"-"+p2(M+2))+"-01";
    var ardata=await window.__pageAll(function(f,t){ return SB.from("daiki_attendance").select("employee_id,work_date,raw_code,status_key,note,is_paid,hours").gte("work_date",start).lt("work_date",end).order("employee_id",{ascending:true}).order("work_date",{ascending:true}).range(f,t); });
    var hasData={}; ardata.forEach(function(r){ hasData[r.employee_id]=1; });
    // หน้าเช็ค: แสดง "ทำงานอยู่" + คนลาออกที่มีข้อมูลเดือนนี้ (เพื่อเก็บสถิติ)
    var rows=erdata.filter(function(r){ return r.is_active!==false || hasData[r.id]; });
    (function(){
      var gmin={};
      rows.forEach(function(r){ var g=r.group_name||""; var ts=window.__parseStart(r.start_date); if(gmin[g]==null||ts<gmin[g]) gmin[g]=ts; });
      rows.sort(function(a,b){
        var la=window.__nameLangRank(a.full_name), lb=window.__nameLangRank(b.full_name);
        if(la!==lb) return la-lb;                                      // 1) ไทยขึ้นก่อน พม่าลงล่าง
        var ga=a.group_name||"", gb=b.group_name||"";
        var gma=gmin[ga], gmb=gmin[gb];
        if(gma!==gmb) return gma-gmb;                                  // 2) เรียงกลุ่มตามวันเริ่มงานที่เก่าสุดในกลุ่ม
        if(ga!==gb) return ga<gb?-1:1;                                 //    คุมให้คนกลุ่มเดียวกันอยู่ติดกัน
        var ta=window.__parseStart(a.start_date), tb=window.__parseStart(b.start_date);
        if(ta!==tb) return ta-tb;                                      // 3) ในแผนก: เรียงวันเริ่มงาน เก่า→ใหม่
        return (a.seq==null?9e9:a.seq)-(b.seq==null?9e9:b.seq);        // ตัวช่วยตัดสิน
      });
    })();
    EMP=rows.map(function(r){ return {id:r.id, dbId:r.id, code:r.emp_code||"", name:r.full_name, nick:r.nickname||"", pos:r.position||"", group:r.group_name||"", start:r.start_date||null, active:(r.is_active!==false), cells:{}, notes:{}, paid:{}, hours:{}}; });
    var byId={}; EMP.forEach(function(e,i){ byId[e.dbId]=i; }); EMP._byId=byId;
    ardata.forEach(function(row){ var i=byId[row.employee_id]; if(i==null)return; var day=+row.work_date.slice(8,10);
      if(row.status_key){ EMP[i].cells[day]=row.raw_code||(KEYMAP[row.status_key]?KEYMAP[row.status_key].code:""); }
      if(row.note){ EMP[i].notes[day]=row.note; }
      if(row.is_paid===false){ EMP[i].paid[day]=false; }
      if(row.hours!=null && +row.hours<8){ EMP[i].hours[day]=+row.hours; } });
    LIVE=true; dirty={}; loadedYM=mv; $("modeTag").textContent="เชื่อมต่อแล้ว"; $("modeTag").className="mode-tag live";
    renderGrid();
    dbSay("โหลดสำเร็จ ✓ "+EMP.length+" คน · เดือน "+mv+" — แก้ไขได้ แล้วกด 💾 บันทึก","ok");
    setSave("saved","พร้อม");
  }catch(e){ dbSay("โหลดไม่สำเร็จ: "+(e.message||e),"err"); }
}

$("dbConnect").addEventListener("click",connectDB);
// เดือนกลางเปลี่ยน = โหลดเดือนนั้น
window.__gridForceLoad=function(){ loadMonth(); };   // ปุ่ม 🔄 โหลด เรียกตัวนี้
window.__onMonth(function(){
  if(loadedYM===window.__ym) return;                 // เดือนเดิม ไม่ต้องทำอะไร
  if(!Object.keys(dirty).length){ loadMonth(); }     // ไม่มีของค้าง = โหลดเดือนใหม่ให้เลย
  else { dbSay("เดือนเปลี่ยนเป็น "+window.__ym+" — มีข้อมูลยังไม่บันทึก กด 💾 บันทึก ก่อน หรือกด 🔄 โหลด เพื่อทิ้งแล้วโหลดเดือนใหม่","err"); }
});

// ---------- legend ----------
$("legend").innerHTML="คำอธิบาย:&nbsp;&nbsp;"+STATUS.map(function(s){
  return '<span><i style="background:'+s.color+'"></i>'+s.label+' ('+s.code+')</span>';
}).join("")+' <span style="border-left:1px solid var(--line);padding-left:12px">฿̶ = ไม่ได้ค่าจ้าง (ช่องมีลายทาง)</span>';

// ---------- init (โหมดทดลอง) ----------
(function init(){
  var s=JSON.parse($("sampleData").textContent);
  Y=s.y; M=s.m-1;
  EMP=s.employees.map(function(e,i){ var cells={}; Object.keys(e.cells).forEach(function(d){cells[+d]=e.cells[d];});
    return {id:"s"+i, dbId:null, code:e.code||"", name:e.name, nick:e.nick||"", pos:e.pos||"", cells:cells, notes:{}, paid:{}, hours:{}, _ord:i}; });
  EMP.sort(function(a,b){ var la=window.__nameLangRank(a.name), lb=window.__nameLangRank(b.name); return la!==lb?la-lb:a._ord-b._ord; });
  if(window.__ym && /^\d{4}-\d{2}$/.test(window.__ym)){ Y=+window.__ym.slice(0,4); M=+window.__ym.slice(5,7)-1; }
  renderBrushes(); renderGrid();

  // auto-connect ถ้าตั้งค่า URL/key ไว้แล้ว
  var ready = SUPABASE_URL && SUPABASE_ANON_KEY && !/PASTE-PROJECT-URL/.test(SUPABASE_URL);
  $("dbUrl").value = /PASTE-PROJECT-URL/.test(SUPABASE_URL)? "" : SUPABASE_URL;
  $("dbKey").value = SUPABASE_ANON_KEY;
  if(ready && connectDB()){ loadMonth(); }
})();

window.__gridEnsure=function(){try{ if(SB && loadedYM===null) loadMonth(); }catch(e){}};
})();
</script>
<script>

(function(){
  var ROOT=document.getElementById('view-leave');
  var $=function(id){return ROOT.querySelector('#'+id);};
  function esc(s){return (''+(s==null?'':s)).replace(/[&<>]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[m];});}
  function say(msg,cls){var el=$('leaveMsg');el.textContent=msg;el.className='dbmsg'+(cls?' '+cls:'');}
  var POLICY={personal:{label:'ลากิจ',quota:32},sick:{label:'ลาป่วย',quota:240},vacation:{label:'พักร้อน',quota:6,perQuarter:2}};   // personal/sick=ชม. · vacation=วัน
  var SB=null, loadedYear=null;
  function getSB(){ if(!SB) SB=window.__getSB(); return SB; }
  function emptyUse(){return {sick:0,sick_np:0,personal:0,personal_np:0,vacation:0,vq:[0,0,0]};}

  function initYear(){
    var ySel=$('quotaYear'); if(ySel.options.length) return;
    var y0=(new Date().getFullYear())||2026;
    for(var y=y0+1;y>=y0-2;y--){var o=document.createElement('option');o.value=y;o.textContent=(y+543)+' ('+y+')';ySel.appendChild(o);}
    ySel.value=y0;
  }

  var lastBy=null, lastScope='';
  function render(by,scopeText){
    lastBy=by; lastScope=scopeText;
    var q=($('quotaSearch').value||'').trim().toLowerCase();
    var grp=$('quotaGroup')?$('quotaGroup').value:'';
    (function(){ var set={},none=0; Object.keys(by).forEach(function(k){ var g=by[k].group; if(g)set[g]=(set[g]||0)+1; else none++; });
      var ks=Object.keys(set).sort(function(a,b){return a.localeCompare(b,'th');}); var el=$('quotaGroup'); if(el){ var cur=el.value;
        el.innerHTML='<option value="">ทุกแผนก</option>'+ks.map(function(k){return '<option value="'+k.replace(/"/g,'')+'">แผนก: '+k+' ('+set[k]+')</option>';}).join('')+(none?'<option value="__none">(ไม่มีแผนก) ('+none+')</option>':''); if(cur)el.value=cur; } })();
    var list=Object.keys(by).map(function(k){return by[k];}).filter(function(e){
      if(q){ var h=((e.name||'')+' '+(e.nick||'')+' '+(e.pos||'')).toLowerCase(); if(h.indexOf(q)<0)return false; }
      if(grp==='__none'){ if(e.group)return false; } else if(grp){ if((e.group||'')!==grp)return false; }
      return true;
    }).sort(function(a,b){
      var s=(b.use.personal+b.use.sick+b.use.vacation)-(a.use.personal+a.use.sick+a.use.vacation);
      return s!==0?s:(a.name||'').localeCompare(b.name||'','th');
    });
    $('quotaSub').textContent=scopeText;
    function hoursToDH(h){ h=+h||0; var d=Math.floor(h/8), r=h%8; if(!h) return '0 วัน'; return d+' วัน'+(r?(' '+r+' ชม.'):''); }
    function qbarP(used,quota){   // ลากิจ: เก็บเป็นชั่วโมง แสดงเป็น วัน+ชม.
      var pct=Math.min(100,Math.round(used/quota*100)); var over=used>quota;
      var col=over?'var(--absent)':(used>=quota*0.8?'var(--late)':'var(--present)');
      return '<div class="qcell"><div class="qtop"><b class="'+(over?'over':'')+'">'+hoursToDH(used)+'</b> / '+hoursToDH(quota)+'</div>'+
        '<div class="qtrack"><div class="qfill" style="width:'+pct+'%;background:'+col+'"></div></div>'+
        '<div class="qrem'+(over?' over':'')+'">'+(over?('เกิน '+hoursToDH(used-quota)):('เหลือ '+hoursToDH(quota-used)))+'</div></div>';
    }
    function qbar(used,quota){
      var pct=Math.min(100,Math.round(used/quota*100)); var over=used>quota;
      var col=over?'var(--absent)':(used>=quota*0.8?'var(--late)':'var(--present)');
      return '<div class="qcell"><div class="qtop"><b class="'+(over?'over':'')+'">'+used+'</b>/'+quota+'</div>'+
        '<div class="qtrack"><div class="qfill" style="width:'+pct+'%;background:'+col+'"></div></div>'+
        '<div class="qrem'+(over?' over':'')+'">'+(over?('เกิน '+(used-quota)):('เหลือ '+(quota-used)))+' วัน</div></div>';
    }
    function vqChips(vq,lim){return '<div class="vq">'+vq.map(function(v,i){var o=v>lim;return '<span class="vqx'+(o?' over':'')+'">Q'+(i+1)+' '+v+'</span>';}).join('')+'</div>';}
    var head='<table><thead><tr><th style="width:44px">#</th><th class="l">พนักงาน</th>'+
      '<th>ลากิจ (4 วัน)</th><th>ลาป่วย (30 วัน)</th><th>พักร้อน (6 วัน) · รายไตรมาส</th><th>สถานะ</th></tr></thead><tbody>';
    var body=list.map(function(e,i){
      var u=e.use;
      var pOver=u.personal>POLICY.personal.quota, sOver=u.sick>POLICY.sick.quota,
          vYear=u.vacation>POLICY.vacation.quota, vQ=Math.max(u.vq[0],u.vq[1],u.vq[2])>POLICY.vacation.perQuarter;
      var flags=[]; if(pOver)flags.push('ลากิจเกินสิทธิ'); if(sOver)flags.push('ลาป่วยเกินสิทธิ');
      if(vYear)flags.push('พักร้อนเกินสิทธิปี'); if(vQ)flags.push('พักร้อนเกินไตรมาส');
      var badge=flags.length?'<span class="badge over" title="'+esc(flags.join(', '))+'">เกินสิทธิ ('+flags.length+')</span>':'<span class="badge ok">ปกติ</span>';
      return '<tr><td class="idx num">'+(i+1)+'</td>'+
        '<td class="who"><div class="nm">'+esc(e.name)+(e.nick?' <span class="nick">('+esc(e.nick)+')</span>':'')+'</div><div class="role">'+esc(e.pos||'—')+'</div></td>'+
        '<td>'+qbarP(u.personal,POLICY.personal.quota)+(u.personal_np?'<div style=\"font-size:11px;color:var(--absent);margin-top:3px\">฿&#822; ไม่ได้ตัง '+hoursToDH(u.personal_np)+'</div>':'')+'</td>'+
        '<td>'+qbarP(u.sick,POLICY.sick.quota)+(u.sick_np?'<div style=\"font-size:11px;color:var(--absent);margin-top:3px\">฿&#822; ไม่ได้ตัง '+hoursToDH(u.sick_np)+'</div>':'')+'</td>'+
        '<td>'+qbar(u.vacation,POLICY.vacation.quota)+vqChips(u.vq,POLICY.vacation.perQuarter)+'</td>'+
        '<td>'+badge+'</td></tr>';
    }).join('');
    var over=list.filter(function(e){var u=e.use;return u.personal>POLICY.personal.quota||u.sick>POLICY.sick.quota||u.vacation>POLICY.vacation.quota||Math.max(u.vq[0],u.vq[1],u.vq[2])>POLICY.vacation.perQuarter;}).length;
    $('quotaWrap').innerHTML=list.length?head+body+'</tbody></table>':'<div class="empty-state"><h3>ยังไม่มีรายการลา</h3><div>ปีนี้ยังไม่มีการลาป่วย/ลากิจ/พักร้อนในฐานข้อมูล</div></div>';
    if(list.length && over) $('quotaSub').textContent+=' · ⚠ เกินสิทธิ '+over+' คน';
  }

  async function loadYear(){
    var sb=getSB(); if(!sb){ say('ยังเชื่อมต่อฐานข้อมูลไม่ได้','err'); return; }
    initYear(); var year=+$('quotaYear').value;
    try{
      try{ var pol=await sb.from('daiki_leave_policy').select('*');
        if(!pol.error && pol.data) pol.data.forEach(function(r){ if(POLICY[r.status_key]){ var q=+r.days_per_year; POLICY[r.status_key].quota=(r.status_key==='personal'||r.status_key==='sick')?q*8:q; if(r.per_quarter_limit!=null)POLICY[r.status_key].perQuarter=+r.per_quarter_limit;}});
      }catch(_){}
      say('กำลังโหลดสิทธิการลาปี '+year+'...','');
      var start=year+'-01-01', end=(year+1)+'-01-01';
      var rdata=await window.__pageAll(function(f,t){ return sb.from('daiki_attendance').select('work_date,status_key,is_paid,hours,daiki_employees(full_name,nickname,position,group_name)')
        .in('status_key',['sick','personal','vacation']).gte('work_date',start).lt('work_date',end).order('employee_id',{ascending:true}).order('work_date',{ascending:true}).range(f,t); });
      var by={};
      rdata.forEach(function(row){
        var e=row.daiki_employees||{}; var nm=e.full_name||'(ไม่ระบุ)';
        if(!by[nm]) by[nm]={name:nm,nick:e.nickname||'',pos:e.position||'',group:e.group_name||'',use:emptyUse()};
        var u=by[nm].use; var q=Math.floor((+row.work_date.slice(5,7)-1)/4);   // ไตรมาส = 4 เดือน → 3 ช่วง (0,1,2)
        var hr=(row.hours!=null?+row.hours:8);
        if(row.status_key==='sick'){ if(row.is_paid===false)u.sick_np+=hr; else u.sick+=hr; }           // ลาป่วย = ชั่วโมง
        else if(row.status_key==='personal'){ if(row.is_paid===false)u.personal_np+=hr; else u.personal+=hr; }   // ลากิจ = ชั่วโมง
        else if(row.status_key==='vacation'){ u.vacation+=1; u.vq[q]+=1; }
      });
      loadedYear=year;
      render(by,'ทั้งปี '+(year+543)+' · จากฐานข้อมูล');
      say('โหลดสำเร็จ ✓ '+Object.keys(by).length+' คน','ok');
    }catch(e){ say('โหลดไม่สำเร็จ: '+(e.message||e),'err'); }
  }

  initYear();
  $('quotaAddYear').addEventListener('click',function(){
    var v=prompt('เพิ่มปี (พ.ศ. เช่น 2570 หรือ ค.ศ. เช่น 2027):'); if(!v) return;
    var n=parseInt(v,10); if(isNaN(n)) return;
    var cy = n>=2400 ? n-543 : n;
    var sel=$('quotaYear'), exists=false;
    for(var i=0;i<sel.options.length;i++){ if(+sel.options[i].value===cy) exists=true; }
    if(!exists){ var o=document.createElement('option'); o.value=cy; o.textContent=(cy+543)+' ('+cy+')';
      var placed=false;
      for(var j=0;j<sel.options.length;j++){ if(cy>+sel.options[j].value){ sel.insertBefore(o,sel.options[j]); placed=true; break; } }
      if(!placed) sel.appendChild(o);
    }
    sel.value=cy; loadYear();
  });
  $('quotaYear').addEventListener('change',function(){ loadYear(); });
  $('quotaSearch').addEventListener('input',function(){ if(lastBy) render(lastBy,lastScope); });
  $('quotaGroup').addEventListener('change',function(){ if(lastBy) render(lastBy,lastScope); });
  window.__leaveActivate=function(){ if(getSB()) loadYear(); };
})();

</script>
<script>

(function(){
  var ROOT=document.getElementById('view-employees');
  var $=function(id){return ROOT.querySelector('#'+id);};
  function esc(s){return (''+(s==null?'':s)).replace(/[&<>\"]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[m];});}
  function say(msg,cls){var el=$('empMsg');el.textContent=msg;el.className='dbmsg'+(cls?' '+cls:'');}
  var SB=null; function getSB(){ if(!SB) SB=window.__getSB(); return SB; }
  var LIST=[], loaded=false, editingId=null;

  async function loadList(){
    var sb=getSB(); if(!sb){ say('ยังเชื่อมต่อฐานข้อมูลไม่ได้','err'); return; }
    say('กำลังโหลด...','');
    try{
      var r=await sb.from('daiki_employees').select('id,emp_code,full_name,nickname,position,start_date,day_off,is_active,resign_date,seq,group_name')
        .order('seq',{ascending:true,nullsFirst:false}).order('full_name',{ascending:true}).limit(5000);
      if(r.error) throw r.error;
      LIST=r.data||[];
      LIST.sort(function(a,b){
        var la=window.__nameLangRank(a.full_name), lb=window.__nameLangRank(b.full_name);
        if(la!==lb) return la-lb;
        var sa=a.seq==null?999999:a.seq, sb=b.seq==null?999999:b.seq;
        if(sa!==sb) return sa-sb;
        return (a.full_name||'').localeCompare(b.full_name||'','th');
      });
      loaded=true; render(); say('โหลดสำเร็จ ✓ '+LIST.length+' คน','ok');
    }catch(e){ say('โหลดไม่สำเร็จ: '+(e.message||e),'err'); }
  }

  function render(){
    var q=($('empSearch').value||'').trim().toLowerCase();
    var f=$('empFilter').value;
    var grp=$('empGroup')?$('empGroup').value:'';
    (function(){ var set={},none=0; LIST.forEach(function(e){ if(e.group_name)set[e.group_name]=(set[e.group_name]||0)+1; else none++; });
      var ks=Object.keys(set).sort(function(a,b){return a.localeCompare(b,'th');}); var el=$('empGroup'); if(el){ var cur=el.value;
        el.innerHTML='<option value="">ทุกแผนก</option>'+ks.map(function(k){return '<option value="'+esc(k)+'">แผนก: '+esc(k)+' ('+set[k]+')</option>';}).join('')+(none?'<option value="__none">(ไม่มีแผนก) ('+none+')</option>':''); if(cur)el.value=cur; } })();
    var rows=LIST.filter(function(e){
      var active=(e.is_active!==false);
      if(f==='active' && !active) return false;
      if(f==='resigned' && active) return false;
      if(q){ var hay=((e.full_name||'')+' '+(e.nickname||'')+' '+(e.emp_code||'')+' '+(e.position||'')).toLowerCase(); if(hay.indexOf(q)<0) return false; }
      if(grp==='__none'){ if(e.group_name) return false; } else if(grp){ if((e.group_name||'')!==grp) return false; }
      return true;
    });
    var nActive=LIST.filter(function(e){return e.is_active!==false;}).length;
    var nOut=LIST.length-nActive;
    $('empSub').textContent='ทั้งหมด '+LIST.length+' คน · ทำงานอยู่ '+nActive+' · ลาออกแล้ว '+nOut+' · แสดง '+rows.length;
    var head='<table><thead><tr><th style=\"width:40px\">#</th><th>รหัส</th><th class=\"l\">ชื่อ-นามสกุล</th><th>ตำแหน่ง</th><th>แผนก</th><th>เริ่มงาน</th><th>สถานะ</th><th style=\"width:210px\">จัดการ</th></tr></thead><tbody>';
    var body=rows.map(function(e,i){
      var active=(e.is_active!==false);
      var pill=active?'<span class=\"pill on\">ทำงานอยู่</span>':'<span class=\"pill off\">ลาออก'+(e.resign_date?(' '+e.resign_date):'')+'</span>';
      return '<tr>'+
        '<td class=\"idx num\" style=\"color:var(--muted)\">'+(i+1)+'</td>'+
        '<td class=\"num\">'+esc(e.emp_code||'—')+'</td>'+
        '<td class=\"who\"><div class=\"nm\">'+esc(e.full_name)+(e.nickname?' <span class=\"nick\">('+esc(e.nickname)+')</span>':'')+'</div></td>'+
        '<td>'+esc(e.position||'—')+'</td>'+
        '<td>'+(e.group_name?'<span class=\"grpchip\">'+esc(e.group_name)+'</span>':'—')+'</td>'+
        '<td class=\"num\">'+esc(e.start_date||'—')+'</td>'+
        '<td>'+pill+'</td>'+
        '<td><div class=\"act\">'+
          '<button data-act=\"edit\" data-id=\"'+e.id+'\">แก้ไข</button>'+
          (active?'<button class=\"resign\" data-act=\"resign\" data-id=\"'+e.id+'\">ลาออก</button>'
                 :'<button class=\"restore\" data-act=\"restore\" data-id=\"'+e.id+'\">คืนสภาพ</button>')+
          '<button class=\"del\" data-act=\"del\" data-id=\"'+e.id+'\">ลบ</button>'+
        '</div></td></tr>';
    }).join('');
    var _sc=window.scrollY;
    $('empWrap').innerHTML = rows.length? head+body+'</tbody></table>'
      : '<div class=\"empty-state\"><h3>ไม่พบพนักงาน</h3><div>ลองเปลี่ยนตัวกรองหรือคำค้นหา</div></div>';
    window.scrollTo(0,_sc);
    $('empWrap').querySelectorAll('button[data-act]').forEach(function(b){
      b.onclick=function(){ act(b.dataset.act, b.dataset.id); };
    });
  }

  function byId(id){ for(var i=0;i<LIST.length;i++){ if(LIST[i].id===id) return LIST[i]; } return null; }

  function toDMY(ymd){ if(!ymd) return ''; var p=(''+ymd).slice(0,10).split('-'); if(p.length!==3) return ''+ymd; return (+p[2])+'/'+(+p[1])+'/'+p[0]; }
  function parseDMY(s){ s=(s||'').trim(); if(!s) return null;
    if(/^\d{4}-\d{1,2}-\d{1,2}$/.test(s)){ var q=s.split('-'); return q[0]+'-'+('0'+q[1]).slice(-2)+'-'+('0'+q[2]).slice(-2); }
    var m=s.split(/[\/\-.]/); if(m.length!==3) return null;
    var d=+m[0], mo=+m[1], y=+m[2]; if(!d||!mo||!y) return null;
    if(y<100) y+=2000; if(y>=2500) y-=543;
    if(mo<1||mo>12||d<1||d>31) return null;
    return y+'-'+('0'+mo).slice(-2)+'-'+('0'+d).slice(-2); }
  function showForm(emp){
    editingId = emp? emp.id : null;
    var e=emp||{};
    var F=[
      ['emp_code','รหัสพนักงาน',''],['full_name','ชื่อ-นามสกุล','req'],['nickname','ชื่อเล่น',''],
      ['position','ตำแหน่ง',''],['group_name','แผนก (คนแผนกเดียวกันจะแสดงติดกัน)',''],['start_date','วันเริ่มงาน (พิมพ์ 5/7/2025)',''],['day_off','วันหยุดประจำ','']
    ];
    var fields=F.map(function(f){
      var isDate=(f[0]==='start_date');
      var val=isDate? toDMY(e[f[0]]) : (e[f[0]]||'');
      var ph=isDate? ' placeholder=\"วัน/เดือน/ปี เช่น 5/7/2025\"' : '';
      return '<div class=\"ef-f\"><label>'+f[1]+(f[2]==='req'?' <span class=\"req\">*</span>':'')+'</label>'+
        '<input id=\"ef_'+f[0]+'\" type=\"text\" value=\"'+esc(val)+'\"'+ph+'></div>';
    }).join('');
    $('empForm').innerHTML='<h3>'+(emp?'แก้ไขข้อมูลพนักงาน':'เพิ่มพนักงานใหม่')+'</h3>'+
      '<div class=\"ef-grid\">'+fields+'</div>'+
      '<div class=\"ef-actions\"><button class=\"ebtn save\" id=\"efSave\">บันทึก</button><button class=\"ebtn\" id=\"efCancel\">ยกเลิก</button></div>';
    $('empForm').style.display='block'; $('empBackdrop').style.display='block';
    $('efSave').onclick=saveForm; $('efCancel').onclick=closeForm; $('empBackdrop').onclick=closeForm;
    try{ $('ef_full_name').focus({preventScroll:true}); }catch(e){ $('ef_full_name').focus(); }
  }
  function closeForm(){ $('empForm').style.display='none'; $('empBackdrop').style.display='none'; }

  async function saveForm(){
    var sb=getSB(); if(!sb) return;
    function v(k){ var el=$('ef_'+k); var s=(el.value||'').trim(); return s===''?null:s; }
    var name=v('full_name'); if(!name){ say('กรุณากรอกชื่อ-นามสกุล','err'); return; }
    var rec={emp_code:v('emp_code'), full_name:name, nickname:v('nickname'), position:v('position'), group_name:v('group_name'), start_date:parseDMY($('ef_start_date').value), day_off:v('day_off')};
    say('กำลังบันทึก...','');
    try{
      if(editingId){ var r=await sb.from('daiki_employees').update(rec).eq('id',editingId); if(r.error) throw r.error; }
      else{
        var maxSeq=LIST.reduce(function(m,e){ return Math.max(m, e.seq==null?0:e.seq); },0);
        rec.seq=maxSeq+1; rec.is_active=true;
        var r2=await sb.from('daiki_employees').insert(rec); if(r2.error) throw r2.error;
      }
      closeForm();
      await loadList(); say('บันทึกสำเร็จ ✓','ok');
    }catch(e){ say('บันทึกไม่สำเร็จ: '+(e.message||e),'err'); }
  }

  async function act(a,id){
    var sb=getSB(); if(!sb) return; var e=byId(id); if(!e) return;
    if(a==='edit'){ showForm(e); return; }
    try{
      if(a==='resign'){
        if(!confirm('ยืนยันให้ '+e.full_name+' ลาออก/พ้นสภาพ?\\n(ประวัติการมาทำงานจะยังเก็บไว้ แต่จะไม่แสดงในหน้ากรอก)')) return;
        var today=new Date().toISOString().slice(0,10);
        var r=await sb.from('daiki_employees').update({is_active:false, resign_date:today}).eq('id',id); if(r.error) throw r.error;
        say(e.full_name+' → ลาออกแล้ว ('+today+')','ok');
      } else if(a==='restore'){
        var r2=await sb.from('daiki_employees').update({is_active:true, resign_date:null}).eq('id',id); if(r2.error) throw r2.error;
        say(e.full_name+' → คืนสภาพแล้ว','ok');
      } else if(a==='del'){
        if(!confirm('⚠️ ลบ '+e.full_name+' ออกถาวร?\\nข้อมูลการมาทำงานทั้งหมดของคนนี้จะถูกลบด้วย กู้คืนไม่ได้!\\n\\nถ้าแค่ลาออก แนะนำใช้ปุ่ม \"ลาออก\" แทน')) return;
        var r3=await sb.from('daiki_employees').delete().eq('id',id); if(r3.error) throw r3.error;
        say('ลบ '+e.full_name+' แล้ว','ok');
      }
      await loadList();
    }catch(err){ say('ทำรายการไม่สำเร็จ: '+(err.message||err),'err'); }
  }

  $('empAdd').addEventListener('click',function(){ showForm(null); });
  $('empSearch').addEventListener('input',render);
  $('empFilter').addEventListener('change',render);
  $('empGroup').addEventListener('change',render);
  window.__empActivate=function(){ if(getSB() && !loaded) loadList(); };
})();

</script>
<script>

(function(){
  var ROOT=document.getElementById('view-summary');
  var $=function(id){return ROOT.querySelector('#'+id);};
  function esc(s){return (''+(s==null?'':s)).replace(/[&<>]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[m];});}
  function say(msg,cls){var el=$('sumMsg');el.textContent=msg;el.className='dbmsg'+(cls?' '+cls:'');}
  var POLICY={personal:4,sick:30,vacation:6};
  var SB=null; function getSB(){ if(!SB) SB=window.__getSB(); return SB; }
  var ROWS=[], curYear=null;

  function initYear(){ var y=$('sumYear'); if(y.options.length) return; var y0=(window.__ym?+window.__ym.slice(0,4):(new Date().getFullYear()))||2026;
    for(var yy=y0+1;yy>=y0-2;yy--){var o=document.createElement('option');o.value=yy;o.textContent=(yy+543)+' ('+yy+')';y.appendChild(o);} y.value=y0; }
  function agg(){return {present:0,late:0,sick_p:0,sick_np:0,personal_p:0,personal_np:0,vacation:0,absent:0,dayoff:0,holiday:0};}

  async function loadYear(){
    var sb=getSB(); if(!sb){ say('ยังเชื่อมต่อฐานข้อมูลไม่ได้','err'); return; }
    initYear(); var year=+$('sumYear').value; curYear=year;
    try{
      try{ var pol=await sb.from('daiki_leave_policy').select('*'); if(!pol.error&&pol.data) pol.data.forEach(function(r){ if(POLICY[r.status_key]!=null)POLICY[r.status_key]=+r.days_per_year; }); }catch(_){}
      say('กำลังโหลดปี '+year+'...','');
      var erdata=await window.__pageAll(function(f,t){ return sb.from('daiki_employees').select('id,full_name,nickname,position,seq,is_active,resign_date,group_name,start_date').order('seq',{ascending:true,nullsFirst:false}).order('full_name',{ascending:true}).range(f,t); });
      var start=year+'-01-01', end=(year+1)+'-01-01';
      var ardata=await window.__pageAll(function(f,t){ return sb.from('daiki_attendance').select('employee_id,status_key,is_paid').gte('work_date',start).lt('work_date',end).order('employee_id',{ascending:true}).order('work_date',{ascending:true}).range(f,t); });
      var actives=erdata.filter(function(e){ return e.is_active!==false; });   // ไม่รวมคนลาออก
      window.__groupSort(actives, function(e){return e.seq==null?999999:e.seq;}, function(e){return e.group_name||"";}, function(e){return e.full_name||"";});
      var by={}; actives.forEach(function(e){ by[e.id]={emp:e,a:agg()}; });
      ardata.forEach(function(r){ var o=by[r.employee_id]; if(!o)return; var a=o.a; var k=r.status_key;
        if(k==='present')a.present++; else if(k==='late')a.late++;
        else if(k==='sick'){ if(r.is_paid===false)a.sick_np++; else a.sick_p++; }
        else if(k==='personal'){ if(r.is_paid===false)a.personal_np++; else a.personal_p++; }
        else if(k==='vacation')a.vacation++; else if(k==='absent')a.absent++;
        else if(k==='dayoff')a.dayoff++; else if(k==='holiday')a.holiday++;
      });
      ROWS=actives.map(function(e){return by[e.id];});
      render(year);
      say('โหลดสำเร็จ ✓ '+ROWS.length+' คน','ok');
    }catch(e){ say('โหลดไม่สำเร็จ: '+(e.message||e),'err'); }
  }

  function render(year){
    var q=($('sumSearch').value||'').trim().toLowerCase();
    var grp=$('sumGroup')?$('sumGroup').value:'';
    (function(){ var set={},none=0; ROWS.forEach(function(o){ var g=o.emp.group_name; if(g)set[g]=(set[g]||0)+1; else none++; });
      var ks=Object.keys(set).sort(function(a,b){return a.localeCompare(b,'th');}); var el=$('sumGroup'); if(el){ var cur=el.value;
        el.innerHTML='<option value="">ทุกแผนก</option>'+ks.map(function(k){return '<option value="'+esc(k)+'">แผนก: '+esc(k)+' ('+set[k]+')</option>';}).join('')+(none?'<option value="__none">(ไม่มีแผนก) ('+none+')</option>':''); if(cur)el.value=cur; } })();
    var list=ROWS.filter(function(o){
      if(q){ var h=((o.emp.full_name||'')+' '+(o.emp.nickname||'')+' '+(o.emp.position||'')).toLowerCase(); if(h.indexOf(q)<0)return false; }
      var g=o.emp.group_name||''; if(grp==='__none'){ if(g)return false; } else if(grp){ if(g!==grp)return false; }
      return true;
    });
    var tp=0,tl=0,tab=0,rates=[];
    list.forEach(function(o){var a=o.a; var w=a.present+a.late; var exp=w+a.sick_p+a.sick_np+a.personal_p+a.personal_np+a.vacation+a.absent;
      tp+=w; tl+=a.sick_p+a.sick_np+a.personal_p+a.personal_np+a.vacation; tab+=a.absent; if(exp>0)rates.push(w/exp*100);});
    var avg=rates.length?Math.round(rates.reduce(function(s,x){return s+x;},0)/rates.length):0;
    var K=[['พนักงาน',list.length,''],['มาทำงานรวม',tp,'วัน-คน'],['ลารวม',tl,'วัน-คน'],['ขาดงานรวม',tab,'วัน-คน'],['อัตราการมาเฉลี่ย',avg,'%']];
    $('sumKpis').innerHTML=K.map(function(k){return '<div class="kpi" style="--c:var(--navy)"><div class="lab"><span class="dot"></span>'+k[0]+'</div><div class="v num">'+k[1]+(k[2]==='%'?'<small>%</small>':'')+'</div><div class="cap">'+(k[2]==='%'?'':k[2])+'</div></div>';}).join('');
    $('sumPrintHead').innerHTML='<h2 style="text-align:center;margin:0 0 4px;font-family:Anuphan">รายงานสรุปการมาทำงานประจำปี '+(year+543)+'</h2><div style="text-align:center;color:#555;font-size:12px">บริษัท ไดกิ · พิมพ์เมื่อ '+new Date().toLocaleString('th-TH')+'</div>';
    $('sumSub').textContent='ปี '+(year+543)+' · '+list.length+' คน · หน่วย: วัน';
    function n(v,cls){return '<td><span class="stat '+(v?(cls||''):'z')+'">'+(v||'–')+'</span></td>';}
    var head='<table><thead><tr><th style="width:36px">#</th><th class="l">พนักงาน</th><th>เริ่มงาน</th><th>อายุงาน<br>(วัน)</th><th>มา</th><th>สาย</th><th>ป่วย<br>ได้ตัง</th><th>ป่วย<br>ไม่ได้</th><th>กิจ<br>ได้ตัง</th><th>กิจ<br>ไม่ได้</th><th>พักร้อน</th><th>ขาด</th><th>อัตรา</th><th>คงเหลือ<br>กิจ/ป่วย/พร</th></tr></thead><tbody>';
    var body=list.map(function(o,i){var a=o.a; var e=o.emp; var w=a.present+a.late; var exp=w+a.sick_p+a.sick_np+a.personal_p+a.personal_np+a.vacation+a.absent; var rate=exp>0?Math.round(w/exp*100):null;
      var pl=POLICY.personal-a.personal_p, sl=POLICY.sick-a.sick_p, vl=POLICY.vacation-a.vacation;
      var rc=rate==null?'var(--muted)':(rate>=95?'var(--present)':rate>=85?'var(--late)':'var(--absent)');
      return '<tr><td class="idx num" style="color:var(--muted)">'+(i+1)+'</td>'+
        '<td class="who"><div class="nm">'+esc(e.full_name)+(e.nickname?' <span class="nick">('+esc(e.nickname)+')</span>':'')+(e.group_name?'<span class="grpchip">'+esc(e.group_name)+'</span>':'')+'</div><div class="role">'+esc(e.position||'—')+'</div></td>'+
        '<td class="num" style="font-size:12px">'+esc(e.start_date||'—')+'</td>'+
        '<td class="num">'+(function(){ if(!e.start_date) return '—'; var t=Math.floor((Date.now()-new Date(e.start_date).getTime())/86400000); return t>=0? t.toLocaleString('en-US') : '—'; })()+'</td>'+
        n(a.present,'present')+n(a.late,'late')+n(a.sick_p,'sick')+n(a.sick_np,'sick')+n(a.personal_p,'personal')+n(a.personal_np,'personal')+n(a.vacation,'vacation')+n(a.absent,'absent')+
        '<td><span class="stat" style="color:'+rc+'">'+(rate==null?'–':rate+'%')+'</span></td>'+
        '<td class="num" style="font-size:12px">'+pl+' / '+sl+' / '+vl+'</td></tr>';
    }).join('');
    $('sumTable').innerHTML=list.length?head+body+'</tbody></table>':'<div class="empty-state"><h3>ไม่มีข้อมูลปีนี้</h3><div>ลองเลือกปีอื่น หรือกรอกข้อมูลก่อน</div></div>';
  }

  initYear();
  $('sumAddYear').addEventListener('click',function(){ var v=prompt('เพิ่มปี (พ.ศ. เช่น 2570 หรือ ค.ศ. เช่น 2027):'); if(!v)return; var nn=parseInt(v,10); if(isNaN(nn))return; var cy=nn>=2400?nn-543:nn; var sel=$('sumYear'),ex=false; for(var i=0;i<sel.options.length;i++)if(+sel.options[i].value===cy)ex=true; if(!ex){var o=document.createElement('option');o.value=cy;o.textContent=(cy+543)+' ('+cy+')'; var placed=false; for(var j=0;j<sel.options.length;j++){if(cy>+sel.options[j].value){sel.insertBefore(o,sel.options[j]);placed=true;break;}} if(!placed)sel.appendChild(o);} sel.value=cy; loadYear(); });
  $('sumYear').addEventListener('change',loadYear);
  $('sumSearch').addEventListener('input',function(){ if(curYear!=null) render(curYear); });
  $('sumGroup').addEventListener('change',function(){ if(curYear!=null) render(curYear); });
  $('sumPrint').addEventListener('click',function(){ window.print(); });
  window.__sumActivate=function(){ if(getSB()) loadYear(); };
})();

</script>
<script>
(function(){
  var views={grid:document.getElementById('view-grid'),dash:document.getElementById('view-dash'),leave:document.getElementById('view-leave'),employees:document.getElementById('view-employees'),summary:document.getElementById('view-summary'),score:document.getElementById('view-score'),deadline:document.getElementById('view-deadline')};
  var tabs=document.querySelectorAll('.tab');
  function show(name){
    for(var k in views){ views[k].classList.toggle('active',k===name); }
    tabs.forEach(function(t){ t.classList.toggle('active',t.dataset.tab===name); });
    if(name==='dash' && window.__dashRefresh) window.__dashRefresh();
    if(name==='grid' && window.__gridEnsure) window.__gridEnsure();
    if(name==='leave' && window.__leaveActivate) window.__leaveActivate();
    if(name==='employees' && window.__empActivate) window.__empActivate();
    if(name==='summary' && window.__sumActivate) window.__sumActivate();
    if(name==='score' && window.__scoreActivate) window.__scoreActivate();
    if(name==='deadline'){ if(window.__deadlineMount) window.__deadlineMount(); }
    if(name==='grid'){ if(window.__gridFit) setTimeout(window.__gridFit,0); setTimeout(setTabH,0); }
    window.scrollTo(0,0);
  }
  tabs.forEach(function(t){ t.onclick=function(){ show(t.dataset.tab); }; });
  // เดือนกลาง
  var gm=document.getElementById('globalMonth');
  function p2(n){return (n<10?'0':'')+n;}
  function shift(d){ var b=(window.__ym||gm.value).split('-'); var y=+b[0], mo=+b[1]-1+d; while(mo<0){mo+=12;y--;} while(mo>11){mo-=12;y++;} window.__setMonth(y+'-'+p2(mo+1)); }
  if(gm){ gm.addEventListener('change',function(){ window.__setMonth(gm.value); });
    document.getElementById('gPrev').onclick=function(){ shift(-1); };
    document.getElementById('gNext').onclick=function(){ shift(1); }; }
  var sb=document.getElementById('btnSave'); if(sb){ sb.onclick=function(){ if(window.__saveAll) window.__saveAll(); }; }
  var lb=document.getElementById('btnLoad'); if(lb){ lb.onclick=function(){ if(window.__loadAll) window.__loadAll(); }; }
  if(window.__updateSaveUI) window.__updateSaveUI();
  function setTabH(){ var t=document.querySelector('.tabbar'); var th=t?t.offsetHeight:62; document.documentElement.style.setProperty('--tabbarH', th+'px');
    var tb=document.querySelector('#view-grid .toolbar'); var tbh=(tb&&tb.offsetHeight)?tb.offsetHeight:0;
    document.documentElement.style.setProperty('--gridStick', (th+tbh+2)+'px'); }
  setTabH(); window.addEventListener('resize', setTabH);
})();
</script>
<script>
(function(){
  var DEDUCT={late:0.5,sick:0.5,personal:0.5,noscan:0.5,absent:2,warning:5};
  var START=100, LOW=90;
  var MTH=["มกราคม","กุมภาพันธ์","มีนาคม","เมษายน","พฤษภาคม","มิถุนายน","กรกฎาคม","สิงหาคม","กันยายน","ตุลาคม","พฤศจิกายน","ธันวาคม"];
  function $(id){return document.getElementById(id);}
  function esc(s){return (""+(s==null?"":s)).replace(/[&<>"]/g,function(m){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m];});}
  function p2(n){return (n<10?"0":"")+n;}
  function fnum(n){ return (Math.round(n*10)/10).toString(); }
  var warnAll=[];

  function ctx(){ return (window.__scoreData?window.__scoreData():{EMP:[],Y:2026,M:6,classify:function(){return"";}}); }
  function monthLabel(Y,M){ return MTH[M]+" "+(Y+543); }

  function scMsg(t,cls){ var el=$("scMsg"); if(!el)return; el.textContent=t||""; el.className="sc-msg"+(cls?" "+cls:""); }

  async function loadWarnings(){
    var sb=window.__getSB&&window.__getSB();
    if(!sb){ warnAll=[]; return; }
    try{
      var r=await sb.from("daiki_warnings").select("*").order("issue_date",{ascending:false});
      if(r.error) throw r.error;
      warnAll=r.data||[];
    }catch(e){ warnAll=[]; scMsg("โหลดใบเตือนไม่ได้: "+(e.message||e),"err"); }
  }
  async function saveWarning(obj){
    var sb=window.__getSB&&window.__getSB();
    if(!sb) throw new Error("ยังไม่ได้เชื่อมต่อฐานข้อมูล");
    var r=await sb.from("daiki_warnings").insert(obj).select();
    if(r.error) throw r.error; return r.data;
  }
  async function delWarning(id){
    var sb=window.__getSB&&window.__getSB();
    if(!sb) throw new Error("ยังไม่ได้เชื่อมต่อฐานข้อมูล");
    var r=await sb.from("daiki_warnings").delete().eq("id",id);
    if(r.error) throw r.error;
  }
  async function updateWarning(id,obj){
    var sb=window.__getSB&&window.__getSB();
    if(!sb) throw new Error("ยังไม่ได้เชื่อมต่อฐานข้อมูล");
    var r=await sb.from("daiki_warnings").update(obj).eq("id",id).select();
    if(r.error) throw r.error; return r.data;
  }

  function computeRows(){
    var c=ctx(); var EMP=c.EMP||[], cl=c.classify;
    var ym=c.Y+"-"+p2(c.M+1);
    // warnings in current month, by employee_id
    var wmon={};
    warnAll.forEach(function(w){
      if((""+ (w.issue_date||"")).slice(0,7)===ym){ wmon[w.employee_id]=(wmon[w.employee_id]||0)+1; }
    });
    return EMP.map(function(e){
      var t={late:0,sick:0,personal:0,noscan:0,absent:0};
      var cells=e.cells||{};
      Object.keys(cells).forEach(function(d){ var k=cl(cells[d]); if(t[k]!==undefined)t[k]++; });
      var warn=(e.dbId!=null && wmon[e.dbId])?wmon[e.dbId]:0;
      var ded=DEDUCT.late*t.late+DEDUCT.sick*t.sick+DEDUCT.personal*t.personal+DEDUCT.noscan*t.noscan+DEDUCT.absent*t.absent+DEDUCT.warning*warn;
      return {dbId:e.dbId,name:e.name,nick:e.nick,pos:e.pos,t:t,warn:warn,ded:ded,rem:START-ded};
    });
  }

  function renderRules(){
    var items=[
      ["late","มาสาย","0.5"],["sick","ลาป่วย","0.5"],["personal","ลากิจ","0.5"],
      ["noscan","ลืมสแกน","0.5"],["absent","ขาดงาน","2"],["warning","ใบเตือน","5"]
    ];
    var col={late:"#E8912A",sick:"#C24D6B",personal:"#6B6FCB",noscan:"#C9A227",absent:"#D8453A",warning:"#101F36"};
    $("scRules").innerHTML='<span style="font-size:12.5px;color:var(--muted);align-self:center">กติกาการหักคะแนน:</span>'+
      items.map(function(x){return '<span class="r"><i style="background:'+col[x[0]]+'"></i>'+x[1]+' <b>−'+x[2]+'</b></span>';}).join("");
  }

  function renderTable(rows){
    rows=rows.slice().sort(function(a,b){ return b.ded-a.ded; });
    var byEmp={};
    warnAll.forEach(function(w){ (byEmp[w.employee_id]=byEmp[w.employee_id]||[]).push(w); });
    Object.keys(byEmp).forEach(function(k){ byEmp[k].sort(function(a,b){ return (""+b.issue_date).localeCompare(""+a.issue_date); }); });
    var head='<thead><tr><th>#</th><th style="text-align:left">พนักงาน</th><th>สาย</th><th>ป่วย</th><th>กิจ</th><th>ลืมสแกน</th><th>ขาด</th><th>ใบเตือน</th><th>รวมหัก</th><th>คงเหลือ</th></tr></thead>';
    var body=rows.map(function(r,i){
      var zero=r.ded===0?" zero":"";
      var low=r.rem<LOW?" low":"";
      var wl=(r.dbId!=null && byEmp[r.dbId])?byEmp[r.dbId]:[];
      var badge=r.warn?('<span class="sc-badge">'+r.warn+'</span> '):'';
      var warnCell=(r.dbId!=null)
        ? '<button type="button" class="warn-btn" data-emp="'+r.dbId+'">'+badge+'<span class="warn-mng">จัดการ \u25BE</span></button>'
        : '<span class="sc-dim">\u2014</span>';
      var mainRow='<tr class="'+(zero?"zero":"")+'">'+
        '<td>'+(i+1)+'</td>'+
        '<td class="nm">'+esc(r.name||"")+(r.nick?' <small>'+esc(r.nick)+(r.pos?" \u00B7 "+esc(r.pos):"")+'</small>':(r.pos?' <small>'+esc(r.pos)+'</small>':''))+'</td>'+
        '<td>'+(r.t.late||"")+'</td><td>'+(r.t.sick||"")+'</td><td>'+(r.t.personal||"")+'</td>'+
        '<td>'+(r.t.noscan||"")+'</td><td>'+(r.t.absent||"")+'</td>'+
        '<td class="warn-cell">'+warnCell+'</td>'+
        '<td class="tot">'+(r.ded?("\u2212"+fnum(r.ded)):"0")+'</td>'+
        '<td class="rem'+low+'">'+fnum(r.rem)+'</td></tr>';
      var detail='';
      if(r.dbId!=null){
        var items=wl.length ? wl.map(function(w){
          return '<div class="wp-item">'+
            '<span class="wp-date">'+esc(thDate(w.issue_date)||w.issue_date||"")+'</span>'+
            '<span class="sc-badge">'+esc(w.level||"")+'</span>'+
            '<span class="wp-reason">'+esc(w.reason||"")+'</span>'+
            '<span class="wp-act"><button type="button" class="wp-edit" data-edit="'+w.id+'">\u270E แก้ไข</button>'+
            '<button type="button" class="wp-del" data-del="'+w.id+'">ลบ</button></span></div>';
        }).join("") : '<div class="wp-empty">ยังไม่มีใบเตือน</div>';
        detail='<tr class="warn-detail hide" data-detail="'+r.dbId+'"><td colspan="10">'+
          '<div class="warn-panel"><div class="wp-list">'+items+'</div>'+
          '<button type="button" class="wp-add" data-add="'+r.dbId+'">\uFF0B ออกใบเตือนใหม่</button></div></td></tr>';
      }
      return mainRow+detail;
    }).join("");
    $("scTbl").innerHTML=head+'<tbody>'+(rows.length?body:'<tr><td class="sc-empty" colspan="10">ยังไม่มีข้อมูลพนักงาน</td></tr>')+'</tbody>';
    var tbl=$("scTbl");
    tbl.querySelectorAll(".warn-btn").forEach(function(b){
      b.onclick=function(){ var dr=tbl.querySelector('tr.warn-detail[data-detail="'+b.dataset.emp+'"]'); if(dr) dr.classList.toggle("hide"); };
    });
    tbl.querySelectorAll(".wp-add").forEach(function(b){ b.onclick=function(){ openModal({empId:+b.dataset.add}); }; });
    tbl.querySelectorAll(".wp-edit").forEach(function(b){
      b.onclick=function(){ var w=warnAll.filter(function(x){return ""+x.id===b.dataset.edit;})[0]; if(w) openModal({edit:w}); };
    });
    tbl.querySelectorAll(".wp-del").forEach(function(b){
      b.onclick=async function(){ if(!confirm("ลบใบเตือนนี้?")) return;
        try{ await delWarning(b.dataset.del); await render(); scMsg("ลบใบเตือนแล้ว","ok"); }
        catch(e){ scMsg("ลบไม่สำเร็จ: "+(e.message||e),"err"); } };
    });
  }

  function renderKpis(rows){
    var c=ctx();
    var totDed=rows.reduce(function(a,r){return a+r.ded;},0);
    var ym=c.Y+"-"+p2(c.M+1);
    var wmon=warnAll.filter(function(w){return (""+(w.issue_date||"")).slice(0,7)===ym;}).length;
    var lowN=rows.filter(function(r){return r.rem<LOW;}).length;
    var K=[
      ["พนักงานทั้งหมด",rows.length,"var(--navy)"],
      ["รวมคะแนนที่หัก (เดือนนี้)","−"+fnum(totDed),"var(--orange)"],
      ["ใบเตือน (เดือนนี้)",wmon,"var(--absent)"],
      ["ต่ำกว่า "+LOW+" คะแนน",lowN,"var(--late)"]
    ];
    $("scKpis").innerHTML=K.map(function(k){
      return '<div class="sc-kpi"><div class="l">'+k[0]+'</div><div class="v" style="color:'+k[2]+'">'+k[1]+'</div></div>';
    }).join("");
  }

  function nameOf(dbId){
    var c=ctx(); var f=(c.EMP||[]).filter(function(e){return e.dbId===dbId;})[0];
    return f?f.name:("#"+dbId);
  }
  function posOf(dbId){
    var c=ctx(); var f=(c.EMP||[]).filter(function(e){return e.dbId===dbId;})[0];
    return f?(f.pos||""):"";
  }

  async function render(){
    var c=ctx();
    $("scSub").textContent="ประจำเดือน "+monthLabel(c.Y,c.M)+" · หักจากพฤติกรรม เริ่มต้น "+START+" คะแนน";
    renderRules();
    await loadWarnings();
    var rows=computeRows();
    renderKpis(rows);
    renderTable(rows);
  }
  window.__scoreActivate=function(){ render(); };

  // ---- issue-warning modal ----
  var scmEmps=[], scmActive=-1, scEditId=null;
  function empLabel(e){ return e.name+(e.nick?" ("+e.nick+")":""); }
  function renderEmpList(q){
    q=(q||"").trim().toLowerCase();
    var list=$("scmEmpList");
    var arr=scmEmps.filter(function(e){ return !q || empLabel(e).toLowerCase().indexOf(q)>=0; });
    scmActive=-1;
    if(!scmEmps.length){ list.innerHTML='<div class="scm-none">— ไม่มีพนักงานที่บันทึกในฐานข้อมูล —</div>'; list.classList.add("open"); return; }
    if(!arr.length){ list.innerHTML='<div class="scm-none">ไม่พบชื่อที่ค้นหา</div>'; list.classList.add("open"); return; }
    list.innerHTML=arr.map(function(e){
      return '<div class="scm-opt" data-id="'+e.dbId+'" data-label="'+esc(empLabel(e))+'">'+esc(e.name)+(e.nick?' <small>'+esc(e.nick)+'</small>':'')+'</div>';
    }).join("");
    list.classList.add("open");
    list.querySelectorAll(".scm-opt").forEach(function(o){
      o.onmousedown=function(ev){ ev.preventDefault(); pickEmp(o.dataset.id, o.dataset.label); };
    });
  }
  function pickEmp(id,label){
    $("scmEmp").value=id; $("scmEmpText").value=label;
    $("scmEmpList").classList.remove("open");
  }
  function openModal(opts){
    opts=opts||{};
    var c=ctx();
    scmEmps=(c.EMP||[]).filter(function(e){return e.dbId!=null;});
    var editing=opts.edit||null;
    scEditId=editing?editing.id:null;
    $("scmEmpList").classList.remove("open");
    var h=$("scModal").querySelector("h3"); if(h) h.textContent=editing?"แก้ไขใบเตือน":"ออกใบเตือน (หนังสือเตือน)";
    var fixedId=editing?editing.employee_id:(opts.empId!=null?opts.empId:null);
    if(fixedId!=null){
      $("scmEmp").value=fixedId; $("scmEmpText").value=nameOf(fixedId); $("scmEmpText").disabled=true;
    }else{
      $("scmEmp").value=""; $("scmEmpText").value=""; $("scmEmpText").disabled=!scmEmps.length;
    }
    $("scmEmpText").placeholder=scmEmps.length?"พิมพ์ชื่อเพื่อค้นหา...":"— ไม่มีพนักงานที่บันทึกในฐานข้อมูล —";
    if(editing){
      $("scmDate").value=(""+(editing.issue_date||"")).slice(0,10);
      $("scmLevel").value=editing.level||"ครั้งที่ 1";
      $("scmReason").value=editing.reason||"";
      $("scmDetail").value=editing.detail||"";
      $("scmSave").textContent="บันทึกการแก้ไข"; $("scmSave").disabled=false;
    }else{
      var t=new Date();
      $("scmDate").value=t.getFullYear()+"-"+p2(t.getMonth()+1)+"-"+p2(t.getDate());
      $("scmLevel").value="ครั้งที่ 1"; $("scmReason").value=""; $("scmDetail").value="";
      $("scmSave").textContent="บันทึกใบเตือน"; $("scmSave").disabled=(!scmEmps.length && fixedId==null);
    }
    $("scModal").classList.add("open");
  }
  function closeModal(){ scEditId=null; $("scmEmpText").disabled=false; $("scModal").classList.remove("open"); $("scmEmpList").classList.remove("open"); }

  $("scIssueBtn").onclick=openModal;
  $("scmCancel").onclick=closeModal;
  $("scModal").addEventListener("click",function(e){ if(e.target===$("scModal")) closeModal(); });
  $("scmEmpText").addEventListener("input",function(){ $("scmEmp").value=""; renderEmpList(this.value); });
  $("scmEmpText").addEventListener("focus",function(){ renderEmpList(this.value); });
  $("scmEmpText").addEventListener("blur",function(){ setTimeout(function(){ $("scmEmpList").classList.remove("open"); },120); });
  $("scmEmpText").addEventListener("keydown",function(ev){
    var list=$("scmEmpList"); var opts=list.querySelectorAll(".scm-opt");
    if(ev.key==="ArrowDown"||ev.key==="ArrowUp"){
      ev.preventDefault(); if(!opts.length) return;
      scmActive+= (ev.key==="ArrowDown"?1:-1);
      if(scmActive<0) scmActive=opts.length-1; if(scmActive>=opts.length) scmActive=0;
      opts.forEach(function(o,i){ o.classList.toggle("active",i===scmActive); });
      opts[scmActive].scrollIntoView({block:"nearest"});
    }else if(ev.key==="Enter"){
      if(scmActive>=0&&opts[scmActive]){ ev.preventDefault(); pickEmp(opts[scmActive].dataset.id,opts[scmActive].dataset.label); }
    }else if(ev.key==="Escape"){ list.classList.remove("open"); }
  });
  $("scmSave").onclick=async function(){
    var eid=$("scmEmp").value; var reason=$("scmReason").value.trim();
    if(!eid){ alert("เลือกพนักงานก่อน"); return; }
    if(!reason){ alert("ระบุเรื่อง/สาเหตุก่อน"); $("scmReason").focus(); return; }
    var obj={employee_id:+eid, issue_date:$("scmDate").value, level:$("scmLevel").value, reason:reason, detail:$("scmDetail").value.trim()||null};
    var editId=scEditId;
    $("scmSave").disabled=true; var oldtxt=$("scmSave").textContent; $("scmSave").textContent="กำลังบันทึก...";
    try{
      if(editId){ await updateWarning(editId,obj); closeModal(); await render(); scMsg("แก้ไขใบเตือนของ "+nameOf(+eid)+" แล้ว","ok"); }
      else{ await saveWarning(obj); closeModal(); await render(); scMsg("ออกใบเตือนให้ "+nameOf(+eid)+" แล้ว (\u22125 คะแนน)","ok"); }
    }catch(e){ scMsg("บันทึกไม่สำเร็จ: "+(e.message||e),"err"); alert("บันทึกไม่สำเร็จ: "+(e.message||e)); }
    finally{ $("scmSave").disabled=false; $("scmSave").textContent=oldtxt||"บันทึกใบเตือน"; }
  };

  // ---- print warning letter ----
  function thDate(iso){
    if(!iso) return "";
    var p=(""+iso).split("-"); if(p.length<3) return iso;
    return (+p[2])+" "+MTH[(+p[1])-1]+" "+((+p[0])+543);
  }
  function printLetter(w){
    var nm=nameOf(w.employee_id), pos=posOf(w.employee_id);
    var html='<!doctype html><html lang="th"><head><meta charset="utf-8"><title>หนังสือเตือน - '+esc(nm)+'</title>'+
    '<style>@page{size:A4;margin:22mm 20mm}*{font-family:"TH Sarabun New","IBM Plex Sans Thai",sans-serif}'+
    'body{color:#101F36;font-size:16pt;line-height:1.7}h1{text-align:center;font-size:22pt;margin:0 0 2pt}'+
    '.co{text-align:center;font-size:14pt;color:#333;margin-bottom:18pt}.meta{margin:14pt 0}.meta div{margin:2pt 0}'+
    '.body{margin:16pt 0;text-align:justify}.lv{display:inline-block;border:1.5pt solid #D42027;color:#D42027;padding:2pt 12pt;border-radius:6pt;font-weight:700}'+
    '.sign{display:flex;justify-content:space-between;margin-top:46pt;gap:20pt}.sign .b{flex:1;text-align:center}'+
    '.sign .line{margin:0 auto 6pt;border-top:1px dotted #333;width:80%;height:1px}.sign small{color:#555}'+
    '.ack{margin-top:40pt;border-top:1px solid #ccc;padding-top:14pt;font-size:14pt;color:#444}</style></head><body>'+
    '<h1>หนังสือเตือน</h1><div class="co">บริษัท มาซารุ มาร์เก็ตติ้ง จำกัด (MASARU)</div>'+
    '<div class="meta"><div>วันที่ '+esc(thDate(w.issue_date))+'</div>'+
    '<div>เรียน คุณ'+esc(nm)+(pos?(' &nbsp;ตำแหน่ง '+esc(pos)):"")+'</div>'+
    '<div>ระดับการเตือน: <span class="lv">'+esc(w.level||"")+'</span></div></div>'+
    '<div class="body">ตามที่บริษัทฯ ได้ตรวจพบว่าท่านมีพฤติกรรม/การกระทำอันเป็นการฝ่าฝืนระเบียบข้อบังคับในการทำงาน '+
    'ในเรื่อง <b>'+esc(w.reason||"")+'</b>'+(w.detail?(' โดยมีรายละเอียดดังนี้ '+esc(w.detail)):"")+
    ' นั้น บริษัทฯ จึงขอออกหนังสือฉบับนี้เพื่อเป็นการเตือนให้ท่านปรับปรุงแก้ไขและระมัดระวังมิให้เกิดเหตุการณ์ในลักษณะเดียวกันนี้ขึ้นอีก '+
    'หากท่านยังคงกระทำผิดซ้ำ บริษัทฯ มีความจำเป็นต้องพิจารณาดำเนินการตามระเบียบข้อบังคับในลำดับที่สูงขึ้นต่อไป '+
    'ทั้งนี้ การกระทำดังกล่าวมีผลต่อการประเมินความประพฤติประจำปี การปรับค่าจ้าง และการจ่ายโบนัสของท่าน</div>'+
    '<div class="sign"><div class="b"><div class="line"></div>ลูกหว้า<br><small>ผู้จัดการฝ่ายบุคคล</small></div>'+
    '<div class="b"><div class="line"></div>คุณพลวุฒิ บุญวิธวาเจริญ<br><small>ประธานกรรมการ</small></div></div>'+
    '<div class="ack"><div class="sign"><div class="b"><div class="line"></div>ลงชื่อพนักงานผู้รับทราบ<br><small>วันที่ ......... / ......... / .........</small></div></div></div>'+
    '</body></html>';
    var w2=window.open("","_blank");
    if(!w2){ alert("เบราว์เซอร์บล็อกป๊อปอัพ — อนุญาตป๊อปอัพเพื่อพิมพ์"); return; }
    w2.document.open(); w2.document.write(html); w2.document.close();
    w2.focus(); setTimeout(function(){ try{w2.print();}catch(e){} },350);
  }
})();
</script>


<script>
(function(){
  var _mounted=false;
  window.__deadlineMount=function(){
    if(_mounted) return; _mounted=true;
    var host=document.getElementById('dlHost'); if(!host) return;
    var root=host.attachShadow({mode:'open'});
    var cssEl=document.getElementById('dlCss'), tplEl=document.getElementById('dlTpl');
    root.innerHTML='<style>'+(cssEl?cssEl.textContent:'')+'</style>'+(tplEl?tplEl.innerHTML:'');
    var _q=function(id){ return root.querySelector('#'+id); };
    try{
/* ===== ระบบ Deadline (ฝังแบบ shadow DOM) ===== */

"use strict";
const KEY = "masaru_hr_deadline_v1";
const THMONTH = ["ม.ค.","ก.พ.","มี.ค.","เม.ย.","พ.ค.","มิ.ย.","ก.ค.","ส.ค.","ก.ย.","ต.ค.","พ.ย.","ธ.ค."];

let state = { records: [], done: [], terms: [] };  // done = array of milestone ids
let filter = "probation";
let showDone = false;
let qSearch="", focusWin="all", deptFilter="all", showAuto=false;
let online = false;

/* ---------- Supabase config ---------- */
const SUPABASE_URL = "https://iyycyvnvfmerxkcfalea.supabase.co";
const SUPABASE_KEY = "sb_publishable_ChkZClaeE6NCAxqyTqE4Yw_aTsz4zqi";
const _sb = window.supabase ? window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY) : null;

/* ---------- local cache (offline fallback) ---------- */
function cacheLoad(){
  try{
    const raw = localStorage.getItem(KEY);
    if(raw){ state = JSON.parse(raw); }
  }catch(e){}
  if(!state.records) state.records = [];
  if(!state.done) state.done = [];
  if(!state.terms) state.terms = [];
}
function cacheSave(){ try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(e){} }

/* ---------- Supabase data layer ---------- */
function recToRow(r){
  return { id:r.id, type:r.type, name:r.name, dept:r.dept||null, note:r.note||null,
    ref:r.ref||null, due:r.due||null, threshold:r.threshold||null, updated_at:new Date().toISOString() };
}
function rowToRec(r){
  const rec={ id:r.id, type:r.type, name:r.name, dept:r.dept||"", note:r.note||"" };
  if(r.ref) rec.ref=r.ref;
  if(r.due) rec.due=r.due;
  if(r.threshold!=null) rec.threshold=r.threshold;
  return rec;
}
function setStatus(ok){
  online=ok;
  const el=_q("syncDot");
  if(el){ el.className="sync "+(ok?"ok":"off"); el.textContent = ok ? "● ซิงค์แล้ว" : "● ออฟไลน์"; }
}
/* ---------- employee source: daiki_employees (จาก chack) ---------- */
var EMPLOYEES=[], _empActive=-1, _empLoaded=false;
function _empLabel(e){ var nm=e.full_name||""; return e.nickname?(e.nickname+" ("+nm+")"):nm; }
async function loadEmployees(){
  if(!_sb) return;
  try{
    var r=await _sb.from("daiki_employees")
      .select("id,full_name,nickname,position,group_name,start_date,resign_date,is_active");
    if(r.error) throw r.error;
    EMPLOYEES=(r.data||[]).filter(function(e){ return e.is_active!==false && !e.resign_date; })
      .sort(function(a,b){ return (""+(a.full_name||"")).localeCompare(""+(b.full_name||""),"th"); });
    _empLoaded=true;
  }catch(err){ console.warn("โหลดรายชื่อพนักงานไม่ได้", err); _empLoaded=false; }
}
function renderEmpList(q){
  var list=_q("empList"); if(!list) return;
  q=(""+(q||"")).trim().toLowerCase();
  _empActive=-1;
  if(!_empLoaded && !EMPLOYEES.length){ list.innerHTML='<div class="emp-none">— ยังไม่ได้เชื่อมต่อ/ไม่มีรายชื่อ (พิมพ์เองได้) —</div>'; list.classList.add("open"); return; }
  var arr=EMPLOYEES.filter(function(e){ return !q || (_empLabel(e).toLowerCase().indexOf(q)>=0); }).slice(0,50);
  if(!arr.length){ list.innerHTML='<div class="emp-none">ไม่พบชื่อ — จะใช้ที่พิมพ์ไว้</div>'; list.classList.add("open"); return; }
  list.innerHTML=arr.map(function(e){
    var sub=[e.position,e.group_name].filter(Boolean).join(" · ");
    return '<div class="emp-opt" data-id="'+e.id+'">'+
      '<span>'+_esc(_empLabel(e))+'</span>'+(sub?'<small>'+_esc(sub)+'</small>':'')+'</div>';
  }).join("");
  list.classList.add("open");
  list.querySelectorAll(".emp-opt").forEach(function(o){
    o.onmousedown=function(ev){ ev.preventDefault(); pickEmployee(o.dataset.id); };
  });
}
function pickEmployee(id){
  var e=EMPLOYEES.filter(function(x){return ""+x.id===""+id;})[0]; if(!e) return;
  var fn=_q("f_name"); if(fn) fn.value=_empLabel(e);
  // เติมวันเริ่มงานให้อัตโนมัติ (ใช้กับทดลองงาน/ลาคลอด)
  var ref=_q("f_ref");
  if(ref && e.start_date){ ref.value=(""+e.start_date).slice(0,10); }
  // เติมแผนก
  var dept=_q("f_dept");
  if(dept && e.group_name){ dept.value=e.group_name; }
  var list=_q("empList"); if(list) list.classList.remove("open");
}
function _esc(t){ return (""+(t==null?"":t)).replace(/[&<>"]/g,function(m){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m];}); }
function bindEmpCombo(){
  var inp=_q("f_name"); if(!inp) return;
  inp.addEventListener("input",function(){ renderEmpList(this.value); });
  inp.addEventListener("focus",function(){ if(!_empLoaded){ loadEmployees().then(function(){ renderEmpList(inp.value); }); } else { renderEmpList(this.value); } });
  inp.addEventListener("blur",function(){ setTimeout(function(){ var l=_q("empList"); if(l) l.classList.remove("open"); },140); });
  inp.addEventListener("keydown",function(ev){
    var list=_q("empList"); var opts=list?list.querySelectorAll(".emp-opt"):[];
    if(ev.key==="ArrowDown"||ev.key==="ArrowUp"){
      ev.preventDefault(); if(!opts.length) return;
      _empActive+=(ev.key==="ArrowDown"?1:-1);
      if(_empActive<0)_empActive=opts.length-1; if(_empActive>=opts.length)_empActive=0;
      opts.forEach(function(o,i){ o.classList.toggle("active",i===_empActive); });
      opts[_empActive].scrollIntoView({block:"nearest"});
    }else if(ev.key==="Enter"){
      if(_empActive>=0&&opts[_empActive]){ ev.preventDefault(); pickEmployee(opts[_empActive].dataset.id); }
    }else if(ev.key==="Escape"){ if(list) list.classList.remove("open"); }
  });
}

async function sbLoad(){
  if(!_sb){ cacheLoad(); setStatus(false); render(); return; }
  try{
    const [r1,r2,r3]=await Promise.all([
      _sb.from("hr_deadlines").select("*"),
      _sb.from("hr_deadline_done").select("milestone_id"),
      _sb.from("hr_termination").select("*")
    ]);
    if(r1.error) throw r1.error;
    if(r2.error) throw r2.error;
    if(r3.error) throw r3.error;
    state.records=(r1.data||[]).map(rowToRec);
    state.done=(r2.data||[]).map(x=>x.milestone_id);
    state.terms=(r3.data||[]).map(rowToTerm);
    cacheSave(); setStatus(true);
  }catch(err){
    console.warn("Supabase load failed → cache", err);
    cacheLoad(); setStatus(false);
  }
  render();
}
async function sbUpsertRecord(rec){
  if(!_sb) return;
  const {error}=await _sb.from("hr_deadlines").upsert(recToRow(rec));
  if(error) throw error;
}
async function sbDeleteRecord(id){
  if(!_sb) return;
  await _sb.from("hr_deadline_done").delete().like("milestone_id", id+"-%");
  const {error}=await _sb.from("hr_deadlines").delete().eq("id", id);
  if(error) throw error;
}
async function sbSetDone(mid, done){
  if(!_sb) return;
  if(done){ const {error}=await _sb.from("hr_deadline_done").upsert({milestone_id:mid}); if(error) throw error; }
  else { const {error}=await _sb.from("hr_deadline_done").delete().eq("milestone_id", mid); if(error) throw error; }
}
// push entire local state to Supabase (used by import / restore)
async function sbSyncAll(){
  if(!_sb) return;
  if(state.records.length){
    const {error}=await _sb.from("hr_deadlines").upsert(state.records.map(recToRow));
    if(error) throw error;
  }
  const {data:dbRecs}=await _sb.from("hr_deadlines").select("id");
  const keep=new Set(state.records.map(r=>r.id));
  const del=(dbRecs||[]).map(r=>r.id).filter(id=>!keep.has(id));
  if(del.length) await _sb.from("hr_deadlines").delete().in("id", del);
  // reconcile done: clear then insert current
  await _sb.from("hr_deadline_done").delete().neq("milestone_id","__none__");
  if(state.done.length) await _sb.from("hr_deadline_done").upsert(state.done.map(m=>({milestone_id:m})));
}
async function guard(fn){
  try{ await fn(); setStatus(true); }
  catch(err){ console.warn(err); setStatus(false); alert("⚠️ บันทึกขึ้น Supabase ไม่สำเร็จ (ออฟไลน์?)\nข้อมูลถูกเก็บในเครื่องไว้ก่อน จะซิงค์เมื่อออนไลน์"); }
}

/* ---------- date helpers ---------- */
function parseD(s){ const [y,m,d]=s.split("-").map(Number); return new Date(y,m-1,d); }
function addDays(dstr,n){ const d=parseD(dstr); d.setDate(d.getDate()+n); return d; }
function toISO(d){ return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); }
function thDate(d){ return d.getDate()+" "+THMONTH[d.getMonth()]+" "+(d.getFullYear()+543); }
function daysUntil(d){
  const now=new Date(); now.setHours(0,0,0,0);
  const t=new Date(d); t.setHours(0,0,0,0);
  return Math.round((t-now)/86400000);
}

/* ---------- status ---------- */
function statusOf(days){
  if(days<0) return {k:"overdue", label:"เลยกำหนด", icon:"🔴"};
  if(days<=3) return {k:"urgent", label:"ด่วนมาก", icon:"🟠"};
  if(days<=7) return {k:"soon", label:"ใกล้ถึง", icon:"🟡"};
  if(days<=14) return {k:"prep", label:"เตรียมตัว", icon:"🔵"};
  return {k:"ok", label:"ปกติ", icon:"🟢"};
}
function daysText(days){
  if(days<0) return "เลยมา "+Math.abs(days)+" วัน";
  if(days===0) return "วันนี้!";
  return "อีก "+days+" วัน";
}

/* ---------- build milestones from records ---------- */
function autoMilestones(){
  if(!showAuto || !EMPLOYEES || !EMPLOYEES.length) return [];
  // ชื่อทดลองงานที่เพิ่ม/นำเข้าเอง (กันสร้างซ้ำ) — เก็บทั้งชื่อเต็มและตัวพิมพ์เล็ก
  var manualNames=[];
  state.records.forEach(function(r){ if(r.type==="probation"){ var n=(r.name||"").trim(); if(n) manualNames.push(n.toLowerCase()); } });
  function hasManual(e){
    var full=(e.full_name||"").trim().toLowerCase();
    var label=(_empLabel(e)||"").trim().toLowerCase();
    for(var i=0;i<manualNames.length;i++){
      var m=manualNames[i];
      if(!m) continue;
      if(m===full || m===label) return true;          // ตรงกันเป๊ะ
      if(full && (m.indexOf(full)>=0 || full.indexOf(m)>=0)) return true; // ชื่อเต็มซ้อนกัน (จับ "แชมป์ (ชื่อเต็ม)")
    }
    return false;
  }
  var out=[], seen={};
  EMPLOYEES.forEach(function(e){
    if(e.is_active===false || e.resign_date) return;
    var start=e.start_date; if(!start) return;
    var nm=(e.full_name||"").trim(); if(!nm) return;
    var key=nm.toLowerCase(); if(seen[key]) return; seen[key]=true;   // กันพนักงานชื่อซ้ำใน DB
    if(hasManual(e)) return;                                          // มี manual แล้ว ไม่สร้าง auto
    var ek="auto:"+e.id;
    if((state.terms||[]).some(function(t){return t.emp_key===ek;})) return;  // ไม่ผ่านแล้ว → ไปตารางวันออก
    var dept=e.group_name||"";
    [30,60,90].forEach(function(n){
      var d=addDays(start,n); var days=daysUntil(d);
      if(days < -14) return;
      out.push({ id:"auto:"+e.id+":p"+n, rid:"auto:"+e.id, type:"probation", name:nm,
        label:"ประเมินทดลองงาน "+n+" วัน", date:d, dept:dept, auto:true });
    });
  });
  return out;
}
function milestones(){
  const out=[];
  state.records.forEach(r=>{
    if(r.type==="probation" && r.ref){
      [30,60,90].forEach(n=>{
        const d=addDays(r.ref,n);
        out.push({ id:r.id+"-p"+n, rid:r.id, type:r.type, name:r.name,
          label:"ประเมินทดลองงาน "+n+" วัน", date:d, note:r.note });
      });
    } else if(r.type==="maternity" && r.ref){
      const th=Number(r.threshold||45);
      const d=addDays(r.ref, th);
      const elapsed=daysUntil(parseD(r.ref))*-1; // days since start
      out.push({ id:r.id+"-m", rid:r.id, type:r.type, name:r.name,
        label:"ครบเกณฑ์ค่าจ้างนายจ้าง ("+th+" วัน)", date:d,
        note:(r.note?r.note+" · ":"")+"ลามาแล้ว "+elapsed+" วัน" });
    } else if((r.type==="contract"||r.type==="document") && r.due){
      const d=parseD(r.due);
      out.push({ id:r.id+"-d", rid:r.id, type:r.type, name:r.name,
        label: r.type==="contract" ? "หมดสัญญา / ต่อสัญญา" : "ครบกำหนดเอกสาร",
        date:d, note:r.note });
    }
  });
  var merged=out;  // ไม่ดึงอัตโนมัติแล้ว — เฉพาะที่เพิ่มเอง
  merged.forEach(m=>{ m.days=daysUntil(m.date); m.st=statusOf(m.days); m.done=state.done.includes(m.id);
    if(!m.auto){ const r=state.records.find(x=>x.id===m.rid); m.dept=r&&r.dept?r.dept:""; } });
  return merged;
}

/* ---------- render ---------- */
function typeIcon(t){ return {probation:"⏳",maternity:"👶",contract:"📄",document:"📁"}[t]||"📌"; }
function typeName(t){ return {probation:"ทดลองงาน",maternity:"ลาคลอด",contract:"สัญญา",document:"เอกสาร"}[t]||t; }

function escAttr(s){ return (""+(s==null?"":s)).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;"); }
function autoEid(rid){ rid=""+rid; return rid.indexOf("auto:")===0 ? rid.slice(5) : ""; }
function rowToTerm(x){ return { id:x.id, employee_id:x.employee_id, emp_key:x.emp_key, emp_name:x.emp_name, dept:x.dept||"", fail_milestone:x.fail_milestone||"", term_date:x.term_date, reason:x.reason||"" }; }
var _termCtx=null;
function openTermModal(opts){
  _termCtx={ key:opts.key, eid:opts.eid?(+opts.eid):null, name:opts.name||"", dept:opts.dept||"", ms:opts.ms||"" };
  var ex=(state.terms||[]).filter(function(t){return t.emp_key===_termCtx.key;})[0];
  _q("term_name").textContent=_termCtx.name+(_termCtx.dept?(" \u00B7 "+_termCtx.dept):"");
  _q("term_ms").textContent="ไม่ผ่าน: "+(_termCtx.ms||"ทดลองงาน");
  _q("term_date").value=ex&&ex.term_date?(""+ex.term_date).slice(0,10):toISO(new Date());
  _q("term_reason").value=ex&&ex.reason?ex.reason:"";
  _q("termOverlay").classList.add("show");
}
function closeTermModal(){ _q("termOverlay").classList.remove("show"); _termCtx=null; }
function saveTerm(){
  if(!_termCtx) return;
  var d=_q("term_date").value; if(!d){ alert("เลือกวันพ้นสภาพก่อน"); return; }
  var t={ employee_id:_termCtx.eid, emp_key:_termCtx.key, emp_name:_termCtx.name, dept:_termCtx.dept,
          fail_milestone:_termCtx.ms, term_date:d, reason:(_q("term_reason").value.trim()||null) };
  var arr=state.terms||(state.terms=[]);
  var i=-1; for(var k=0;k<arr.length;k++){ if(arr[k].emp_key===t.emp_key){ i=k; break; } }
  if(i>=0) arr[i]=t; else arr.push(t);
  cacheSave(); closeTermModal(); render(); guard(function(){ sbAddTerm(t); });
}
window.cancelTerm=function(key){
  if(!confirm("ยกเลิกสถานะไม่ผ่าน และกลับไปนับทดลองงานตามปกติ?")) return;
  state.terms=(state.terms||[]).filter(function(t){return t.emp_key!==key;});
  cacheSave(); render(); guard(function(){ sbDelTerm(key); });
};
window.editTerm=function(key){
  var t=(state.terms||[]).filter(function(x){return x.emp_key===key;})[0]; if(!t) return;
  openTermModal({ key:t.emp_key, eid:t.employee_id, name:t.emp_name, dept:t.dept, ms:t.fail_milestone });
};
async function sbAddTerm(t){ if(!_sb) return; const {error}=await _sb.from("hr_termination").upsert(t,{onConflict:"emp_key"}); if(error) throw error; }
async function sbDelTerm(key){ if(!_sb) return; const {error}=await _sb.from("hr_termination").delete().eq("emp_key",key); if(error) throw error; }
function bindListActions(container){
  if(!container) return;
  container.querySelectorAll("[data-pass]").forEach(function(b){ b.onclick=function(){ window.toggleDone(b.getAttribute("data-pass")); }; });
  container.querySelectorAll("[data-fail]").forEach(function(b){ b.onclick=function(){ openTermModal({ key:b.getAttribute("data-fail"), eid:b.getAttribute("data-eid"), name:b.getAttribute("data-name"), dept:b.getAttribute("data-dept"), ms:b.getAttribute("data-ms") }); }; });
}
function renderTermList(){
  var q=qSearch.trim().toLowerCase();
  var arr=(state.terms||[]).slice().filter(function(t){
    if(deptFilter!=="all" && (t.dept||"")!==deptFilter) return false;
    if(q && (t.emp_name||"").toLowerCase().indexOf(q)<0) return false;
    return true;
  }).sort(function(a,b){ return (""+a.term_date).localeCompare(""+b.term_date); });
  var listEl=_q("list");
  if(!arr.length){ listEl.innerHTML='<div class="empty">ยังไม่มีพนักงานที่ไม่ผ่านทดลองงาน</div>'; }
  else{
    listEl.innerHTML=arr.map(function(t){
      var days=daysUntil(t.term_date);
      var st=days<0?"overdue":(days<=7?"soon":"ok");
      var lbl=days<0?("ออกแล้ว "+Math.abs(days)+" วัน"):(days===0?"ออกวันนี้":("อีก "+days+" วัน"));
      return '<div class="gitem '+st+'"><div class="ghead">'+
        '<div class="icon">\uD83D\uDEAA</div>'+
        '<div class="gtitle"><span class="tag">พ้นสภาพ</span>'+escapeH(t.emp_name)+(t.dept?' <span class="tag">'+escapeH(t.dept)+'</span>':'')+
        (t.fail_milestone?' <small style="color:var(--muted)">ไม่ผ่าน '+escapeH(t.fail_milestone)+'</small>':'')+'</div>'+
        '<div class="glead">วันออก '+thDate(t.term_date)+' <span class="badge '+st+'">'+lbl+'</span></div>'+
        '<button class="iconbtn" title="แก้ไขวันออก" onclick="editTerm(\''+escAttr(t.emp_key)+'\')">\u270E</button>'+
        '<button class="iconbtn" title="ยกเลิก (กลับเป็นทดลองงาน)" onclick="cancelTerm(\''+escAttr(t.emp_key)+'\')">\u21A9</button>'+
        '</div>'+(t.reason?'<div class="gmiles"><div class="gmile" style="justify-content:flex-start">\uD83D\uDCDD '+escapeH(t.reason)+'</div></div>':'')+'</div>';
    }).join("");
  }
  _q("doneWrap").classList.add("hide");
  (function(){ var sel=_q("deadDept"); if(!sel) return;
    var set={}; (state.terms||[]).forEach(function(t){ if(t.dept) set[t.dept]=1; });
    var opts=Object.keys(set).sort(function(a,b){return a.localeCompare(b,"th");});
    sel.innerHTML='<option value="all">ทุกแผนก</option>'+opts.map(function(d){ return '<option value="'+d.replace(/"/g,"&quot;")+'"'+(d===deptFilter?" selected":"")+'>'+d+'</option>'; }).join("");
  })();
  _q("toggleDone").textContent = showDone ? "ซ่อนที่เสร็จแล้ว" : "แสดงที่เสร็จแล้ว";
}
function render(){
  const all = milestones();
  const termKeys={}; (state.terms||[]).forEach(function(t){ termKeys[t.emp_key]=1; });
  const active = all.filter(m=>!m.done && !termKeys[m.rid]).sort((a,b)=>a.days-b.days);
  const done = all.filter(m=>m.done && !termKeys[m.rid]).sort((a,b)=>b.date-a.date);

  // summary counts (active only)
  const c={overdue:0,urgent:0,soon:0,ok:0};
  active.forEach(m=>{
    if(m.st.k==="overdue")c.overdue++;
    else if(m.st.k==="urgent")c.urgent++;
    else if(m.st.k==="soon")c.soon++;
    else c.ok++;
  });
  _q("summary").innerHTML = `
    <div class="scard overdue"><div class="num">${c.overdue}</div><div class="lbl">🔴 เลยกำหนด</div></div>
    <div class="scard urgent"><div class="num">${c.urgent}</div><div class="lbl">🟠 ด่วน (≤3 วัน)</div></div>
    <div class="scard soon"><div class="num">${c.soon}</div><div class="lbl">🟡 ใกล้ถึง (≤7 วัน)</div></div>
    <div class="scard ok"><div class="num">${c.ok}</div><div class="lbl">🟢 ปกติ</div></div>`;

  // ---- จัดกลุ่มเป็น 1 การ์ด/คน (ทดลองงานยุบ 30/60/90 เป็นแถวย่อย) ----
  const groups = groupMiles(all);
  if(filter==="termination"){ renderTermList(); return; }
  const _q2=qSearch.trim().toLowerCase();
  const gShown = groups.filter(function(g){
    if(filter!=="all" && g.type!==filter) return false;
    if(termKeys[g.rid]) return false;
    if(deptFilter!=="all" && (g.dept||"")!==deptFilter) return false;
    if(_q2 && (g.name||"").toLowerCase().indexOf(_q2)<0) return false;
    if(focusWin==="overdue" && !(g.leadDays<0)) return false;
    if(focusWin==="week" && !(g.leadDays<=7)) return false;
    if(focusWin==="month" && !(g.leadDays<=30)) return false;
    return true;
  });
  const activeG = gShown.filter(g=>!g.allDone).sort((a,b)=>a.leadDays-b.leadDays);
  const doneG   = gShown.filter(g=>g.allDone).sort((a,b)=>b.leadDate-a.leadDate);

  const listEl=_q("list");
  listEl.innerHTML = activeG.length
    ? activeG.map(groupHTML).join("")
    : `<div class="empty">🎉 ไม่มีรายการที่ต้องเตือนในหมวดนี้</div>`;

  const doneWrap=_q("doneWrap");
  if(showDone && doneG.length){
    doneWrap.classList.remove("hide");
    _q("doneList").innerHTML=doneG.map(groupHTML).join("");
  }else{
    doneWrap.classList.add("hide");
  }
  bindListActions(listEl);
  if(showDone && doneG.length) bindListActions(_q("doneList"));
  (function(){ var sel=_q("deadDept"); if(!sel) return;
    var set={}; groups.forEach(function(g){ if(g.dept) set[g.dept]=1; });
    var opts=Object.keys(set).sort(function(a,b){return a.localeCompare(b,"th");});
    sel.innerHTML='<option value="all">ทุกแผนก</option>'+opts.map(function(d){ return '<option value="'+d.replace(/"/g,"&quot;")+'"'+(d===deptFilter?" selected":"")+'>'+d+'</option>'; }).join("");
  })();
  _q("toggleDone").textContent = showDone ? "ซ่อนที่เสร็จแล้ว" : "แสดงที่เสร็จแล้ว";
}

function groupMiles(list){
  const map={}, order=[];
  list.forEach(m=>{
    if(!map[m.rid]){ map[m.rid]={rid:m.rid,type:m.type,name:m.name,dept:m.dept,miles:[]}; order.push(m.rid); }
    map[m.rid].miles.push(m);
  });
  return order.map(rid=>{
    const g=map[rid];
    g.miles.sort((a,b)=>a.date-b.date);
    const pending=g.miles.filter(m=>!m.done);
    g.allDone=pending.length===0;
    const lead=pending.slice().sort((a,b)=>a.days-b.days)[0] || g.miles[g.miles.length-1];
    g.lead=lead; g.leadDays=lead?lead.days:0; g.leadDate=lead?lead.date:0;
    return g;
  });
}
function groupHTML(g){
  if(g.miles.length===1) return itemHTML(g.miles[0]);
  const cls = g.allDone ? 'done' : (g.lead? g.lead.st.k : '');
  const dept = g.dept?' <span class="tag">'+escapeH(g.dept)+'</span>':'';
  const head = `<div class="ghead">
      <div class="icon">${typeIcon(g.type)}</div>
      <div class="gtitle"><span class="tag">${typeName(g.type)}</span>${escapeH(g.name)}${dept}</div>
      <div class="glead">${ g.allDone ? '\u2705 เสร็จครบ' : daysText(g.leadDays)+' <span class="badge '+g.lead.st.k+'">'+g.lead.st.label+'</span>' }</div>
      ${ String(g.rid).indexOf("auto:")===0 ? '<span class="auto-tag">อัตโนมัติ</span>' : '<button class="iconbtn" title="แก้ไข" onclick="editRec(\''+g.rid+'\')">\u270E</button>' }
    </div>`;
  const rows = g.miles.map(m=>{
    const acts = m.done
      ? `<span class="gm-passed">\u2713 ผ่าน</span><button class="iconbtn sm gm-undo" data-pass="${m.id}" title="ยกเลิกผ่าน">\u21A9</button>`
      : `<button class="gm-pass" data-pass="${m.id}">\u2713 ผ่าน</button><button class="gm-fail" data-fail="${g.rid}" data-eid="${autoEid(g.rid)}" data-name="${escAttr(g.name)}" data-dept="${escAttr(g.dept||'')}" data-ms="${escAttr(m.label)}">\u2717 ไม่ผ่าน</button>`;
    return `<div class="gmile ${m.done?'done':m.st.k}">
        <span class="gm-label">${escapeH(m.label)}</span>
        <span class="gm-date">${thDate(m.date)}</span>
        <span class="gm-days ${m.st.k}">${ m.done ? '\u2713 ผ่าน' : daysText(m.days) }</span>
        <span class="gm-actions">${acts}</span>
      </div>`;
  }).join("");
  return `<div class="gitem ${cls}">${head}<div class="gmiles">${rows}</div></div>`;
}
function itemHTML(m){
  return `<div class="item ${m.done?'done':m.st.k}">
    <div class="icon">${typeIcon(m.type)}</div>
    <div class="body">
      <div class="title"><span class="tag">${typeName(m.type)}</span>${escapeH(m.name)}${m.dept?' <span class="tag">'+escapeH(m.dept)+'</span>':''}</div>
      <div class="meta">${escapeH(m.label)} · ${thDate(m.date)}${m.note?" · "+escapeH(m.note):""}</div>
    </div>
    <div class="right">
      <div class="days">${daysText(m.days)}</div>
      <span class="badge ${m.st.k}">${m.st.label}</span>
    </div>
    <div class="acts">
      <button class="iconbtn" title="${m.done?'ยกเลิกเสร็จ':'ทำเสร็จแล้ว'}" onclick="toggleDone('${m.id}')">${m.done?'↩':'✓'}</button>
      <button class="iconbtn" title="แก้ไข" onclick="editRec('${m.rid}')">✎</button>
    </div>
  </div>`;
}
function escapeH(s){ return String(s||"").replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

/* ---------- actions ---------- */
window.toggleDone=function(mid){
  const i=state.done.indexOf(mid);
  const nowDone = i<0;
  if(i>=0) state.done.splice(i,1); else state.done.push(mid);
  cacheSave(); render();
  guard(()=>sbSetDone(mid, nowDone));
};
window.editRec=function(rid){
  const r=state.records.find(x=>x.id===rid);
  if(r) openModal(r);
};

/* ---------- modal ---------- */
function openModal(rec){
  _q("modalTitle").textContent = rec ? "แก้ไขรายการ" : "เพิ่มรายการ";
  _q("f_id").value = rec?rec.id:"";
  _q("f_type").value = rec?rec.type:"probation";
  _q("f_name").value = rec?rec.name:"";
  _q("f_ref").value = rec&&rec.ref?rec.ref:"";
  _q("f_threshold").value = rec&&rec.threshold?rec.threshold:45;
  _q("f_due").value = rec&&rec.due?rec.due:"";
  _q("f_dept").value = rec&&rec.dept?rec.dept:"";
  _q("f_note").value = rec&&rec.note?rec.note:"";
  _q("deleteBtn").style.display = rec?"block":"none";
  syncFields();
  _q("overlay").classList.add("show");
}
function closeModal(){ _q("overlay").classList.remove("show"); }

function syncFields(){
  const t=_q("f_type").value;
  const show=(id,on)=>_q(id).classList.toggle("hide",!on);
  show("grp_ref", t==="probation"||t==="maternity");
  show("grp_threshold", t==="maternity");
  show("grp_due", t==="contract"||t==="document");
  const lblName=_q("lbl_name");
  const lblRef=_q("lbl_ref");
  const hintRef=_q("hint_ref");
  const lblDue=_q("lbl_due");
  if(t==="probation"){ lblName.textContent="ชื่อพนักงาน"; lblRef.textContent="วันเริ่มงาน"; hintRef.textContent="ระบบจะคำนวณ 30/60/90 วันให้อัตโนมัติ"; }
  else if(t==="maternity"){ lblName.textContent="ชื่อพนักงาน"; lblRef.textContent="วันเริ่มลาคลอด"; hintRef.textContent="ระบบจะนับวันที่ลามาแล้ว + วันครบเกณฑ์"; }
  else if(t==="contract"){ lblName.textContent="ชื่อพนักงาน / สัญญา"; lblDue.textContent="วันหมดสัญญา"; }
  else { lblName.textContent="ชื่อ / เรื่องเอกสาร"; lblDue.textContent="วันครบกำหนด"; }
}

function saveRec(){
  const id=_q("f_id").value || ("r"+Date.now());
  const type=_q("f_type").value;
  const name=_q("f_name").value.trim();
  if(!name){ alert("กรุณากรอกชื่อ"); return; }
  const rec={ id, type, name, dept:_q("f_dept").value.trim(), note:_q("f_note").value.trim() };
  if(type==="probation"||type==="maternity"){
    rec.ref=_q("f_ref").value;
    if(!rec.ref){ alert("กรุณาเลือกวันที่"); return; }
    if(type==="maternity") rec.threshold=Number(_q("f_threshold").value)||45;
  }else{
    rec.due=_q("f_due").value;
    if(!rec.due){ alert("กรุณาเลือกวันครบกำหนด"); return; }
  }
  const idx=state.records.findIndex(x=>x.id===id);
  if(idx>=0) state.records[idx]=rec; else state.records.push(rec);
  cacheSave(); closeModal(); render();
  guard(()=>sbUpsertRecord(rec));
}

function deleteRec(){
  const id=_q("f_id").value;
  if(!id) return;
  if(!confirm("ลบรายการนี้?")) return;
  state.records=state.records.filter(x=>x.id!==id);
  state.done=state.done.filter(m=>!m.startsWith(id+"-"));
  cacheSave(); closeModal(); render();
  guard(()=>sbDeleteRecord(id));
}

/* ---------- Excel import ---------- */
function normDate(v){
  if(v==null||v==="") return "";
  if(v instanceof Date && !isNaN(v)) return toISO(v);
  if(typeof v==="number"){ // Excel serial
    const d=new Date(Math.round((v-25569)*86400000));
    return isNaN(d)?"":toISO(d);
  }
  const s=String(v).trim();
  let m=s.match(/^(\d{1,4})[\/\-.](\d{1,2})[\/\-.](\d{1,4})$/);
  if(m){
    let a=+m[1], b=+m[2], c=+m[3], y, mo, da;
    if(a>31){ y=a; mo=b; da=c; }      // yyyy-mm-dd
    else { da=a; mo=b; y=c; }         // dd/mm/yyyy
    if(y>2400) y-=543;                // พ.ศ. -> ค.ศ.
    if(y<100) y+=2000;
    if(mo<1||mo>12||da<1||da>31) return "";
    return y+"-"+String(mo).padStart(2,"0")+"-"+String(da).padStart(2,"0");
  }
  const d=new Date(s);
  return isNaN(d)?"":toISO(d);
}
function mapType(v){
  const s=String(v||"");
  if(s.indexOf("ทดลอง")>=0) return "probation";
  if(s.indexOf("คลอด")>=0) return "maternity";
  if(s.indexOf("สัญญา")>=0) return "contract";
  if(s.indexOf("เอกสาร")>=0) return "document";
  return "";
}
function handleFile(file){
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const wb=XLSX.read(new Uint8Array(e.target.result), {type:"array", cellDates:true});
      // ไฟล์สำรองจากระบบนี้จะมีชีท "DATA" → กู้คืน
      if(wb.SheetNames.indexOf("DATA")>=0){
        const dj=XLSX.utils.sheet_to_json(wb.Sheets["DATA"], {defval:""});
        restoreFromRows(dj);
        if(wb.SheetNames.indexOf("DONE")>=0){
          const dd=XLSX.utils.sheet_to_json(wb.Sheets["DONE"], {defval:""})
            .map(x=>String(x.milestone_id||"").trim()).filter(Boolean);
          if(dd.length){ dd.forEach(id=>{ if(state.done.indexOf(id)<0) state.done.push(id); }); cacheSave(); render(); }
        }
        return;
      }
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws, {header:1, defval:""});
      importRows(rows);
    }catch(err){ alert("อ่านไฟล์ไม่สำเร็จ: "+err.message); }
  };
  reader.readAsArrayBuffer(file);
}
function restoreFromRows(dj){
  var records=[];
  dj.forEach(function(rw){
    var type=String(rw.type||"").trim(), name=String(rw.name||"").trim();
    if(!type||!name) return;
    var rec={ id:String(rw.id||("r"+Date.now()+Math.floor(Math.random()*1000))), type:type, name:name,
      dept:String(rw.dept||"").trim(), note:String(rw.note||"").trim() };
    var ref=normDate(rw.ref); if(ref) rec.ref=ref;
    var due=normDate(rw.due); if(due) rec.due=due;
    if(rw.threshold!==""&&rw.threshold!=null){ var th=Number(rw.threshold); if(!isNaN(th)) rec.threshold=th; }
    records.push(rec);
  });
  if(!records.length){ alert("ไม่พบข้อมูลสำหรับกู้คืนในไฟล์นี้"); return; }
  var replace=confirm("พบข้อมูลสำรอง "+records.length+" รายการ\n\n[ตกลง] = แทนที่ข้อมูลปัจจุบันทั้งหมด\n[ยกเลิก] = รวมกับของเดิม (ไม่เพิ่มที่ซ้ำ)");
  if(replace){ state.records=records; }
  else{
    var key=function(r){ return r.name+"|"+r.type+"|"+(r.ref||r.due||""); };
    var ex={}; state.records.forEach(function(r){ ex[key(r)]=1; });
    records.forEach(function(r){ if(!ex[key(r)]){ state.records.push(r); ex[key(r)]=1; } });
  }
  cacheSave(); render(); guard(function(){ sbSyncAll(); });
  alert("กู้คืนข้อมูลสำเร็จ \u2705 ("+records.length+" รายการ)");
}
function loadExcelJS(){
  return new Promise(function(res,rej){
    if(window.ExcelJS) return res(window.ExcelJS);
    var urls=["https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js",
              "https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"];
    var i=0;
    (function tryLoad(){
      if(i>=urls.length) return rej(new Error("โหลด ExcelJS ไม่สำเร็จ (ตรวจสอบอินเทอร์เน็ต)"));
      var sc=document.createElement("script"); sc.src=urls[i++];
      sc.onload=function(){ window.ExcelJS?res(window.ExcelJS):tryLoad(); };
      sc.onerror=tryLoad; document.head.appendChild(sc);
    })();
  });
}
async function exportExcel(){
  var ExcelJS; try{ ExcelJS=await loadExcelJS(); }catch(e){ alert(e.message); return; }
  var TYPE={probation:"ทดลองงาน",maternity:"ลาคลอด",contract:"สัญญา",document:"เอกสาร"};
  var BD={top:{style:"thin",color:{argb:"FFE3E3DC"}},left:{style:"thin",color:{argb:"FFE3E3DC"}},
          bottom:{style:"thin",color:{argb:"FFE3E3DC"}},right:{style:"thin",color:{argb:"FFE3E3DC"}}};
  var wb=new ExcelJS.Workbook(); wb.creator="MASARU HR"; wb.created=new Date();
  var ws=wb.addWorksheet("รายงาน",{views:[{state:"frozen",ySplit:3}]});
  ws.columns=[{width:14},{width:28},{width:32},{width:16},{width:11},{width:14},{width:10}];
  ws.mergeCells("A1:G1"); var t=ws.getCell("A1");
  t.value="รายการเตือน Deadline — MASARU HR";
  t.font={bold:true,size:16,color:{argb:"FFFFFFFF"}}; t.alignment={vertical:"middle",indent:1};
  t.fill={type:"pattern",pattern:"solid",fgColor:{argb:"FF1B2D51"}}; ws.getRow(1).height=28;
  ws.mergeCells("A2:G2"); var s2=ws.getCell("A2");
  s2.font={size:10,color:{argb:"FF64708A"}}; s2.alignment={indent:1};
  var heads=["ประเภท","ชื่อพนักงาน","รายละเอียด","วันครบกำหนด","เหลือ (วัน)","สถานะ","เสร็จ"];
  var hr=ws.getRow(3);
  heads.forEach(function(h,i){ var c=hr.getCell(i+1); c.value=h;
    c.font={bold:true,color:{argb:"FFFFFFFF"}}; c.fill={type:"pattern",pattern:"solid",fgColor:{argb:"FF2E75B6"}};
    c.alignment={horizontal:"center",vertical:"middle"}; c.border=BD; });
  hr.height=20;
  var ms=milestones(); var rr=4;
  ms.forEach(function(m,idx){
    var days=m.days;
    var argb= days<0?"FFC00000":(days<=3?"FFD8453A":(days<=7?"FFC9A227":"FF1E7145"));
    var row=ws.getRow(rr++);
    row.getCell(1).value=TYPE[m.type]||m.type;
    row.getCell(2).value=m.name;
    row.getCell(3).value=m.label;
    row.getCell(4).value=thDate(toISO(m.date));
    row.getCell(5).value=days;
    row.getCell(6).value=(m.st&&m.st.label)||"";
    row.getCell(7).value=m.done?"\u2713":"";
    row.eachCell(function(c,col){ c.border=BD;
      c.alignment={vertical:"middle",horizontal:(col===2||col===3)?"left":"center"};
      if(idx%2===1) c.fill={type:"pattern",pattern:"solid",fgColor:{argb:"FFF7FBFF"}}; });
    row.getCell(5).font={bold:true,color:{argb:argb}};
    row.getCell(6).font={bold:true,color:{argb:argb}};
  });
  s2.value="ส่งออกเมื่อ "+thDate(toISO(new Date()))+" · รวม "+ms.length+" รายการเตือน";
  var wd=wb.addWorksheet("DATA"); wd.state="hidden";
  wd.addRow(["id","type","name","dept","ref","due","threshold","note"]);
  state.records.forEach(function(x){ wd.addRow([x.id,x.type,x.name,x.dept||"",x.ref||"",x.due||"",(x.threshold==null?"":x.threshold),x.note||""]); });
  var wDone=wb.addWorksheet("DONE"); wDone.state="hidden"; wDone.addRow(["milestone_id"]);
  (state.done||[]).forEach(function(id){ wDone.addRow([id]); });
  var buf=await wb.xlsx.writeBuffer();
  var blob=new Blob([buf],{type:"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"});
  var url=URL.createObjectURL(blob); var n=new Date();
  var stamp=n.getFullYear()+String(n.getMonth()+1).padStart(2,"0")+String(n.getDate()).padStart(2,"0");
  var a=document.createElement("a"); a.href=url; a.download="MASARU_Deadline_"+stamp+".xlsx";
  document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
}
function importRows(rows){
  // find header row: contains "ชื่อ" and "ประเภท"
  let hi=-1;
  for(let i=0;i<Math.min(rows.length,6);i++){
    const line=rows[i].map(x=>String(x)).join("|");
    if(line.indexOf("ชื่อ")>=0 && line.indexOf("ประเภท")>=0){ hi=i; break; }
  }
  if(hi<0){ alert("ไม่พบหัวตาราง (ต้องมีคอลัมน์ 'ชื่อ' และ 'ประเภท') — ใช้ไฟล์แม่แบบนะครับ"); return; }
  const data=rows.slice(hi+1);
  let added=0, skipped=0;
  const existKeys=new Set(state.records.map(r=>r.name+"|"+r.type+"|"+(r.ref||r.due||"")));
  data.forEach(row=>{
    const name=String(row[0]||"").trim();
    const type=mapType(row[1]);
    if(!name || !type) return;                       // skip empty/invalid
    const dstr=normDate(row[2]);
    if(!dstr){ skipped++; return; }                  // needs a valid date
    const rec={ id:"r"+Date.now()+Math.floor(Math.random()*1000), type, name,
      dept:String(row[4]||"").trim(), note:String(row[5]||"").trim() };
    if(type==="probation"||type==="maternity"){
      rec.ref=dstr;
      if(type==="maternity") rec.threshold=Number(row[3])||45;
    }else{ rec.due=dstr; }
    const key=name+"|"+type+"|"+dstr;
    if(existKeys.has(key)){ skipped++; return; }      // dedup
    existKeys.add(key);
    state.records.push(rec); added++;
  });
  cacheSave(); render();
  guard(()=>sbSyncAll());
  alert("นำเข้าสำเร็จ ✅\nเพิ่มใหม่ "+added+" รายการ"+(skipped?"\nข้าม "+skipped+" รายการ (ซ้ำ/วันที่ไม่ถูกต้อง)":""));
}

/* ---------- backup / restore ---------- */
function exportData(){
  const payload={ app:"masaru_hr_deadline", version:1,
    exportedAt:new Date().toISOString(),
    records:state.records, done:state.done };
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const now=new Date();
  const stamp=now.getFullYear()+String(now.getMonth()+1).padStart(2,"0")+String(now.getDate()).padStart(2,"0");
  const a=document.createElement("a");
  a.href=url; a.download="HR_Deadline_Backup_"+stamp+".json";
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}
function restoreData(file){
  const reader=new FileReader();
  reader.onload=e=>{
    let data;
    try{ data=JSON.parse(e.target.result); }
    catch(err){ alert("ไฟล์ไม่ถูกต้อง (ต้องเป็นไฟล์สำรองที่ส่งออกจากระบบนี้)"); return; }
    if(!data || !Array.isArray(data.records)){ alert("ไฟล์นี้ไม่ใช่ไฟล์สำรองของระบบเตือน Deadline HR"); return; }
    const cnt=data.records.length;
    const replace=confirm("พบข้อมูลสำรอง "+cnt+" รายการ\n\n[ตกลง] = แทนที่ข้อมูลปัจจุบันทั้งหมด\n[ยกเลิก] = รวมเข้ากับข้อมูลเดิม (ไม่เพิ่มที่ซ้ำ)");
    if(replace){
      state.records=data.records;
      state.done=Array.isArray(data.done)?data.done:[];
      cacheSave(); render();
      guard(()=>sbSyncAll());
      alert("กู้คืนข้อมูลสำเร็จ ✅ ("+cnt+" รายการ)");
    }else{
      const key=r=>r.name+"|"+r.type+"|"+(r.ref||r.due||"");
      const exist=new Set(state.records.map(key));
      let added=0;
      data.records.forEach(r=>{ if(!exist.has(key(r))){ state.records.push(r); exist.add(key(r)); added++; } });
      const doneSet=new Set(state.done);
      (data.done||[]).forEach(d=>doneSet.add(d));
      state.done=[...doneSet];
      cacheSave(); render();
      guard(()=>sbSyncAll());
      alert("รวมข้อมูลแล้ว ✅ เพิ่มใหม่ "+added+" รายการ");
    }
  };
  reader.readAsText(file);
}

/* ---------- alert popup ---------- */
const SNOOZE_KEY="masaru_hr_deadline_snooze";
function urgentMilestones(){
  var tk={}; (state.terms||[]).forEach(function(t){ tk[t.emp_key]=1; });
  return milestones().filter(m=>!m.done && m.days<=7 && !tk[m.rid]).sort((a,b)=>a.days-b.days);
}
function showAlertPop(force){
  const items=urgentMilestones();
  if(items.length===0){
    if(force) alert("ไม่มีงานด่วน ✅ (ภายใน 7 วันข้างหน้า)");
    return;
  }
  // snooze check (skip auto-open if dismissed today)
  if(!force){
    const today=toISO(new Date());
    if(localStorage.getItem(SNOOZE_KEY)===today) return;
  }
  const od=items.filter(m=>m.days<0).length;
  const ur=items.filter(m=>m.days>=0&&m.days<=3).length;
  const parts=[];
  if(od) parts.push("🔴 เลยกำหนด "+od);
  if(ur) parts.push("🟠 ด่วน "+ur);
  parts.push("รวม "+items.length+" รายการภายใน 7 วัน");
  _q("popSub").textContent=parts.join(" · ");
  _q("popList").innerHTML=items.map(m=>`
    <div class="pop-row ${m.st.k}">
      <div class="pr-body">
        <div class="pr-title">${typeIcon(m.type)} ${escapeH(m.name)}${m.dept?" · "+escapeH(m.dept):""}</div>
        <div class="pr-meta">${escapeH(m.label)} · ${thDate(m.date)}</div>
      </div>
      <div class="pr-days">${daysText(m.days)}</div>
    </div>`).join("");
  _q("popSnooze").checked=false;
  _q("alertPop").classList.add("show");
}
function closeAlertPop(){
  if(_q("popSnooze").checked){
    localStorage.setItem(SNOOZE_KEY, toISO(new Date()));
  }
  _q("alertPop").classList.remove("show");
}

async function init(){
  const now=new Date();
  _q("todayLabel").textContent = "วันนี้ "+thDate(now);
  cacheLoad();     // instant render
  bindEmpCombo();
  render();
  loadEmployees().then(function(){ render(); });
  await sbLoad();  // then fetch fresh from Supabase

  _q("addBtn").onclick=()=>openModal(null);
  _q("importBtn").onclick=()=>_q("fileInput").click();
  _q("fileInput").onchange=e=>{
    if(e.target.files[0]) handleFile(e.target.files[0]);
    e.target.value="";
  };
  _q("cancelBtn").onclick=closeModal;
  _q("saveBtn").onclick=saveRec;
  _q("deleteBtn").onclick=deleteRec;
  _q("f_type").onchange=syncFields;
  _q("toggleDone").onclick=()=>{ showDone=!showDone; render(); };
  _q("exportXlsxBtn").onclick=exportExcel;
  _q("overlay").onclick=(e)=>{ if(e.target.id==="overlay") closeModal(); };

  _q("bellBtn").onclick=()=>showAlertPop(true);
  _q("popClose").onclick=closeAlertPop;
  _q("alertPop").onclick=(e)=>{ if(e.target.id==="alertPop") closeAlertPop(); };

  root.querySelectorAll("#filters .chip").forEach(ch=>{
    ch.onclick=()=>{
      root.querySelectorAll("#filters .chip").forEach(c=>c.classList.remove("active"));
      ch.classList.add("active");
      filter=ch.dataset.type; render();
    };
  });
  _q("deadSearch").addEventListener("input",function(){ qSearch=this.value; render(); });
  root.querySelectorAll("#focusBtns .focus").forEach(function(b){
    b.onclick=function(){ root.querySelectorAll("#focusBtns .focus").forEach(function(c){c.classList.remove("active");}); b.classList.add("active"); focusWin=b.dataset.focus; render(); };
  });
  _q("deadDept").onchange=function(){ deptFilter=this.value; render(); };
  _q("termSave").onclick=saveTerm;
  _q("termCancel").onclick=closeTermModal;
  _q("termOverlay").addEventListener("click",function(e){ if(e.target===_q("termOverlay")) closeTermModal(); });

  showAlertPop(false); // auto-open on load if there are urgent items

  // realtime: refresh when anyone changes data
  if(_sb){
    try{
      _sb.channel("hr_deadline_rt")
        .on("postgres_changes",{event:"*",schema:"public",table:"hr_deadlines"},()=>sbLoad())
        .on("postgres_changes",{event:"*",schema:"public",table:"hr_deadline_done"},()=>sbLoad())
        .subscribe();
    }catch(e){ console.warn("realtime off", e); }
  }
}
init();

/* ===== end deadline ===== */
    }catch(e){ console.error('deadline mount error',e); try{ root.innerHTML+='<div style="padding:16px;color:#c00;font-family:sans-serif">โหลดระบบ Deadline ไม่สำเร็จ: '+((e&&e.message)||e)+'</div>'; }catch(_){}}
  };
})();
</script>
</body>
</html>
