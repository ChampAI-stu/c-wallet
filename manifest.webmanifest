<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MASARU · ระบบบันทึกการมาทำงาน</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --navy:#1B2D51; --ink:#101F36; --orange:#D42027; --orange-soft:#FBE7E8;
  --bg:#EEEEEA; --panel:#FFFFFF; --line:#E3E3DC; --muted:#7A8398;
  --present:#2E9E6B; --late:#E8912A; --sick:#C24D6B; --personal:#6B6FCB;
  --vacation:#2E93C4; --absent:#D8453A; --dayoff:#B4BAC6; --holiday:#9AA3B5;
  --shadow:0 1px 2px rgba(16,31,54,.06),0 8px 24px rgba(16,31,54,.06);
}*{box-sizing:border-box}html,body{margin:0;padding:0}body{
  font-family:'IBM Plex Sans Thai',system-ui,sans-serif;
  background:var(--bg);color:var(--ink);
  font-size:14px;line-height:1.5;
  -webkit-font-smoothing:antialiased;
}#view-dash .num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}#view-dash h1,#view-dash h2,#view-dash h3{font-family:'Anuphan',sans-serif;margin:0;font-weight:600;letter-spacing:-.01em}#view-dash .topbar{
  background:var(--navy);color:#fff;position:sticky;top:0;z-index:40;
  border-bottom:3px solid var(--orange);
}#view-dash .topbar-in{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}#view-dash .brand{display:flex;align-items:center;gap:12px;margin-right:auto}#view-dash .mark{width:38px;height:38px;flex:none}#view-dash .brand .t1{font-family:'Anuphan';font-weight:700;font-size:18px;line-height:1;letter-spacing:.02em}#view-dash .brand .t2{font-size:12px;color:#AEB8CF;margin-top:3px}#view-dash .tb-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-dash .select-wrap{position:relative}#view-dash select,#view-dash .btn{
  font-family:inherit;font-size:13px;border-radius:9px;cursor:pointer;
  border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;
  padding:9px 14px;appearance:none;
}#view-dash select{padding-right:32px}#view-dash .select-wrap::after{content:"";position:absolute;right:12px;top:50%;width:7px;height:7px;
  border-right:2px solid #AEB8CF;border-bottom:2px solid #AEB8CF;transform:translateY(-70%) rotate(45deg);pointer-events:none}#view-dash .btn-upload{background:var(--orange);color:var(--ink);border:none;font-weight:600}#view-dash .btn-upload:hover{filter:brightness(1.05)}#view-dash .demo-tag{font-size:11px;font-weight:600;color:var(--ink);background:var(--orange);
  padding:4px 9px;border-radius:999px;display:none}#view-dash .demo-tag.on{display:inline-block}#view-dash .wrap{max-width:1280px;margin:0 auto;padding:24px}#view-dash .section-h{display:flex;align-items:baseline;gap:12px;margin:0 2px 12px}#view-dash .section-h h2{font-size:17px}#view-dash .section-h .sub{font-size:12.5px;color:var(--muted)}#view-dash .eyebrow{font-family:'Anuphan';font-size:11px;font-weight:600;letter-spacing:.14em;
  text-transform:uppercase;color:var(--orange)}#view-dash .kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-bottom:30px}#view-dash .kpi{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px 16px 14px;box-shadow:var(--shadow);position:relative;overflow:hidden}#view-dash .kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c,var(--navy))}#view-dash .kpi .lab{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px}#view-dash .kpi .dot{width:8px;height:8px;border-radius:3px;background:var(--c,var(--navy))}#view-dash .kpi .v{font-family:'Anuphan';font-weight:700;font-size:30px;line-height:1.1;margin-top:6px;color:var(--ink)}#view-dash .kpi .v small{font-size:14px;color:var(--muted);font-weight:500}#view-dash .kpi .cap{font-size:11.5px;color:var(--muted);margin-top:2px}#view-dash .panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:20px 22px;margin-bottom:30px}#view-dash .steps{display:flex;gap:10px;align-items:flex-end;overflow-x:auto;padding:6px 2px 2px}#view-dash .step{flex:1 0 62px;min-width:62px;text-align:center;cursor:pointer;border-radius:12px;padding:8px 6px 10px;
  transition:background .12s;border:1px solid transparent}#view-dash .step:hover{background:#F6F6F2}#view-dash .step.sel{background:var(--orange-soft);border-color:#EEBCC0}#view-dash .step.future{opacity:.35;pointer-events:none}#view-dash .step .date{font-size:11px;color:var(--muted)}#view-dash .step .date b{color:var(--ink);font-weight:600}#view-dash .bar-track{height:96px;display:flex;align-items:flex-end;justify-content:center;margin:6px 0 6px}#view-dash .bar{width:26px;background:var(--navy);border-radius:6px 6px 3px 3px;min-height:4px;position:relative;transition:height .3s ease}#view-dash .step.sel .bar{background:var(--orange)}#view-dash .step .cnt{font-family:'Anuphan';font-weight:700;font-size:16px;line-height:1}#view-dash .day-detail{margin-top:14px;padding-top:14px;border-top:1px dashed var(--line);display:flex;flex-wrap:wrap;gap:8px;align-items:center}#view-dash .day-detail .dh{font-size:13px;font-weight:600;color:var(--ink);margin-right:6px}#view-dash .chip{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;background:#F6F6F2;border:1px solid var(--line);
  padding:5px 11px;border-radius:999px}#view-dash .chip .cd{width:9px;height:9px;border-radius:3px}#view-dash .chip b{font-family:'Anuphan';font-variant-numeric:tabular-nums}#view-dash .controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}#view-dash .field{background:var(--panel);border:1px solid var(--line);border-radius:11px;display:flex;align-items:center;gap:8px;padding:0 12px;box-shadow:var(--shadow)}#view-dash .field svg{color:var(--muted);flex:none}#view-dash .field input,#view-dash .field select{background:transparent;border:none;color:var(--ink);padding:11px 4px;font-family:inherit;font-size:13.5px;outline:none;min-width:150px}#view-dash .field select{cursor:pointer;padding-right:20px}#view-dash .field.grow{flex:1;min-width:200px}#view-dash .controls .btn.exp{background:var(--navy);border-color:var(--navy);margin-left:auto}#view-dash .controls .btn.exp:hover{background:var(--ink)}#view-dash .tbl-wrap{background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}#view-dash table{width:100%;border-collapse:collapse;font-size:13px}#view-dash thead th{background:#F7F7F3;color:var(--muted);font-weight:600;font-size:11.5px;letter-spacing:.02em;
  text-align:center;padding:12px 8px;border-bottom:1px solid var(--line);white-space:nowrap;position:sticky;top:0}#view-dash thead th.l{text-align:left;padding-left:20px}#view-dash tbody td{padding:12px 8px;border-bottom:1px solid #F0F0EA;text-align:center;vertical-align:middle}#view-dash tbody tr:last-child td{border-bottom:none}#view-dash tbody tr.emp-row{cursor:pointer}#view-dash tbody tr.emp-row:hover{background:#FBFAF6}#view-dash .idx{color:var(--muted);font-size:12px}#view-dash .who{text-align:left;padding-left:20px}#view-dash .who .nm{font-weight:600;color:var(--ink)}#view-dash .who .nm .nick{color:var(--orange);font-weight:600}#view-dash .who .role{font-size:11.5px;color:var(--muted);margin-top:1px}#view-dash .stat{font-family:'Anuphan';font-weight:600;font-variant-numeric:tabular-nums;font-size:14.5px}#view-dash .stat.z{color:#CBCEC7;font-weight:500}#view-dash .stat.present{color:var(--present)}#view-dash .stat.late{color:var(--late)}#view-dash .stat.sick{color:var(--sick)}#view-dash .stat.personal{color:var(--personal)}#view-dash .stat.vacation{color:var(--vacation)}#view-dash .stat.absent{color:var(--absent)}#view-dash .rate{display:flex;align-items:center;gap:8px;justify-content:flex-end;padding-right:16px}#view-dash .rate .rbar{width:64px;height:7px;border-radius:99px;background:#EDEDE7;overflow:hidden}#view-dash .rate .rfill{height:100%;border-radius:99px}#view-dash .rate .rv{font-family:'Anuphan';font-weight:600;font-variant-numeric:tabular-nums;width:44px;text-align:right}#view-dash .tl-row td{padding:0;background:#FAFAF6}#view-dash .tl{padding:14px 20px 18px;display:none}#view-dash .tl.open{display:block}#view-dash .tl .tl-h{font-size:12px;color:var(--muted);margin-bottom:9px}#view-dash .tl-grid{display:flex;flex-wrap:wrap;gap:5px}#view-dash .cell{width:34px;height:40px;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  font-size:11px;border:1px solid var(--line);background:#fff}#view-dash .cell .d{font-size:9px;color:var(--muted);line-height:1}#view-dash .cell .m{font-family:'Anuphan';font-weight:600;font-size:12px;line-height:1.3}#view-dash .cell.present{background:#EAF6F0;border-color:#BFE6D3;color:var(--present)}#view-dash .cell.late{background:#FDF1E1;border-color:#F6D9AF;color:var(--late)}#view-dash .cell.sick{background:#FBEBF0;border-color:#F0C6D3;color:var(--sick)}#view-dash .cell.personal{background:#EDEDFA;border-color:#CBCCF0;color:var(--personal)}#view-dash .cell.vacation{background:#E8F4FA;border-color:#BEE0F0;color:var(--vacation)}#view-dash .cell.absent{background:#FCEAE8;border-color:#F4C4BE;color:var(--absent)}#view-dash .cell.dayoff{background:#F3F3F0;color:var(--dayoff)}#view-dash .cell.holiday{background:#F3F3F0;color:var(--holiday)}#view-dash .cell.empty{background:#fff;color:#D9D9D2}#view-dash .empty-state{text-align:center;padding:70px 20px;color:var(--muted)}#view-dash .empty-state h3{font-size:18px;color:var(--ink);margin-bottom:8px}#view-dash .qcell{min-width:96px}#view-dash .qtop{font-size:12px;color:var(--muted)}#view-dash .qtop b{font-family:'Anuphan';font-size:16px;color:var(--ink)}#view-dash .qtop b.over{color:var(--absent)}#view-dash .qtrack{height:6px;border-radius:99px;background:#EDEDE7;overflow:hidden;margin:3px 0}#view-dash .qfill{height:100%;border-radius:99px}#view-dash .qrem{font-size:11px;color:var(--muted)}#view-dash .qrem.over{color:var(--absent);font-weight:600}#view-dash .vq{display:flex;gap:4px;margin-top:5px;justify-content:center}#view-dash .vqx{font-family:'Anuphan';font-size:10.5px;font-variant-numeric:tabular-nums;padding:2px 5px;border-radius:5px;
  background:#F1F1EC;color:var(--muted);border:1px solid var(--line)}#view-dash .vqx.over{background:#FCEAE8;border-color:#F4C4BE;color:var(--absent);font-weight:600}#view-dash .badge{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px;display:inline-block}#view-dash .badge.ok{background:#EAF6F0;color:var(--present)}#view-dash .badge.over{background:#FCEAE8;color:var(--absent)}#view-dash .quota-note{font-size:12px;color:var(--muted)}#view-dash .quota-note b{color:var(--ink);font-weight:600}#view-dash .legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;font-size:12px;color:var(--muted)}#view-dash .legend span{display:inline-flex;align-items:center;gap:6px}#view-dash .legend i{width:11px;height:11px;border-radius:3px;display:inline-block}#view-dash .foot{text-align:center;color:var(--muted);font-size:12px;margin:26px 0 8px}#view-dash input[type=file]{display:none}#view-dash .dbbar{background:#152540;border-bottom:1px solid rgba(255,255,255,.08)}#view-dash .dbbar-in{max-width:1280px;margin:0 auto;padding:11px 24px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-dash .dbbar .dblab{color:var(--orange);font-family:'Anuphan';font-weight:600;font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-right:2px}#view-dash .dbbar input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#fff;border-radius:8px;padding:8px 11px;font-family:inherit;font-size:12.5px;outline:none}#view-dash .dbbar input::placeholder{color:#7C88A6}#view-dash .dbbar input.url{width:250px}#view-dash .dbbar input.key{width:170px}#view-dash .dbbar input.mon{width:150px;color-scheme:dark}#view-dash .dbbtn{font-family:inherit;font-size:12.5px;font-weight:600;border-radius:8px;padding:8px 13px;cursor:pointer;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff}#view-dash .dbbtn.go{background:var(--orange);color:var(--ink);border:none}#view-dash .dbbtn.load{background:#2E9E6B;color:#fff;border:none}#view-dash .dbbtn:hover{filter:brightness(1.08)}#view-dash .dbmsg{font-size:12px;color:#AEB8CF;margin-left:auto;max-width:100%}#view-dash .dbmsg.ok{color:#7FE0AE}#view-dash .dbmsg.err{color:#FF9E93}@media(max-width:640px){#view-dash .dbbar input.url,#view-dash .dbbar input.key{width:100%}}@media(max-width:1000px){#view-dash .kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){#view-dash .kpis{grid-template-columns:repeat(2,1fr)}#view-dash .wrap{padding:16px}#view-dash thead th.hide,#view-dash tbody td.hide{display:none}
}
:root{
  --navy:#1B2D51; --ink:#101F36; --orange:#D42027; --orange-soft:#FBE7E8;
  --bg:#EEEEEA; --panel:#FFFFFF; --line:#E3E3DC; --muted:#7A8398;
  --present:#2E9E6B; --late:#E8912A; --sick:#C24D6B; --personal:#6B6FCB;
  --vacation:#2E93C4; --absent:#D8453A; --dayoff:#B4BAC6; --holiday:#9AA3B5;
  --shadow:0 1px 2px rgba(16,31,54,.06),0 8px 24px rgba(16,31,54,.06);
}*{box-sizing:border-box}html,body{margin:0;padding:0}body{
  font-family:'IBM Plex Sans Thai',system-ui,sans-serif;
  background:var(--bg);color:var(--ink);
  font-size:14px;line-height:1.5;
  -webkit-font-smoothing:antialiased;
}#view-leave .num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}#view-leave h1,#view-leave h2,#view-leave h3{font-family:'Anuphan',sans-serif;margin:0;font-weight:600;letter-spacing:-.01em}#view-leave .topbar{
  background:var(--navy);color:#fff;position:sticky;top:0;z-index:40;
  border-bottom:3px solid var(--orange);
}#view-leave .topbar-in{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}#view-leave .brand{display:flex;align-items:center;gap:12px;margin-right:auto}#view-leave .mark{width:38px;height:38px;flex:none}#view-leave .brand .t1{font-family:'Anuphan';font-weight:700;font-size:18px;line-height:1;letter-spacing:.02em}#view-leave .brand .t2{font-size:12px;color:#AEB8CF;margin-top:3px}#view-leave .tb-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-leave .select-wrap{position:relative}#view-leave select,#view-leave .btn{
  font-family:inherit;font-size:13px;border-radius:9px;cursor:pointer;
  border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;
  padding:9px 14px;appearance:none;
