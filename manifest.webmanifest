  border-right:2px solid #AEB8CF;border-bottom:2px solid #AEB8CF;transform:translateY(-70%) rotate(45deg);pointer-events:none}#view-leave .btn-upload{background:var(--orange);color:var(--ink);border:none;font-weight:600}#view-leave .btn-upload:hover{filter:brightness(1.05)}#view-leave .demo-tag{font-size:11px;font-weight:600;color:var(--ink);background:var(--orange);
  padding:4px 9px;border-radius:999px;display:none}#view-leave .demo-tag.on{display:inline-block}#view-leave .wrap{max-width:1280px;margin:0 auto;padding:24px}#view-leave .section-h{display:flex;align-items:baseline;gap:12px;margin:0 2px 12px}#view-leave .section-h h2{font-size:17px}#view-leave .section-h .sub{font-size:12.5px;color:var(--muted)}#view-leave .eyebrow{font-family:'Anuphan';font-size:11px;font-weight:600;letter-spacing:.14em;
  text-transform:uppercase;color:var(--orange)}#view-leave .kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-bottom:30px}#view-leave .kpi{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px 16px 14px;box-shadow:var(--shadow);position:relative;overflow:hidden}#view-leave .kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c,var(--navy))}#view-leave .kpi .lab{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px}#view-leave .kpi .dot{width:8px;height:8px;border-radius:3px;background:var(--c,var(--navy))}#view-leave .kpi .v{font-family:'Anuphan';font-weight:700;font-size:30px;line-height:1.1;margin-top:6px;color:var(--ink)}#view-leave .kpi .v small{font-size:14px;color:var(--muted);font-weight:500}#view-leave .kpi .cap{font-size:11.5px;color:var(--muted);margin-top:2px}#view-leave .panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:20px 22px;margin-bottom:30px}#view-leave .steps{display:flex;gap:10px;align-items:flex-end;overflow-x:auto;padding:6px 2px 2px}#view-leave .step{flex:1 0 62px;min-width:62px;text-align:center;cursor:pointer;border-radius:12px;padding:8px 6px 10px;
