  font-size:11px;border:1px solid var(--line);background:#fff}#view-employees .cell .d{font-size:9px;color:var(--muted);line-height:1}#view-employees .cell .m{font-family:'Anuphan';font-weight:600;font-size:12px;line-height:1.3}#view-employees .cell.present{background:#EAF6F0;border-color:#BFE6D3;color:var(--present)}#view-employees .cell.late{background:#FDF1E1;border-color:#F6D9AF;color:var(--late)}#view-employees .cell.sick{background:#FBEBF0;border-color:#F0C6D3;color:var(--sick)}#view-employees .cell.personal{background:#EDEDFA;border-color:#CBCCF0;color:var(--personal)}#view-employees .cell.vacation{background:#E8F4FA;border-color:#BEE0F0;color:var(--vacation)}#view-employees .cell.absent{background:#FCEAE8;border-color:#F4C4BE;color:var(--absent)}#view-employees .cell.dayoff{background:#F3F3F0;color:var(--dayoff)}#view-employees .cell.holiday{background:#F3F3F0;color:var(--holiday)}#view-employees .cell.empty{background:#fff;color:#D9D9D2}#view-employees .empty-state{text-align:center;padding:70px 20px;color:var(--muted)}#view-employees .empty-state h3{font-size:18px;color:var(--ink);margin-bottom:8px}#view-employees .qcell{min-width:96px}#view-employees .qtop{font-size:12px;color:var(--muted)}#view-employees .qtop b{font-family:'Anuphan';font-size:16px;color:var(--ink)}#view-employees .qtop b.over{color:var(--absent)}#view-employees .qtrack{height:6px;border-radius:99px;background:#EDEDE7;overflow:hidden;margin:3px 0}#view-employees .qfill{height:100%;border-radius:99px}#view-employees .qrem{font-size:11px;color:var(--muted)}#view-employees .qrem.over{color:var(--absent);font-weight:600}#view-employees .vq{display:flex;gap:4px;margin-top:5px;justify-content:center}#view-employees .vqx{font-family:'Anuphan';font-size:10.5px;font-variant-numeric:tabular-nums;padding:2px 5px;border-radius:5px;
  background:#F1F1EC;color:var(--muted);border:1px solid var(--line)}#view-employees .vqx.over{background:#FCEAE8;border-color:#F4C4BE;color:var(--absent);font-weight:600}#view-employees .badge{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px;display:inline-block}#view-employees .badge.ok{background:#EAF6F0;color:var(--present)}#view-employees .badge.over{background:#FCEAE8;color:var(--absent)}#view-employees .quota-note{font-size:12px;color:var(--muted)}#view-employees .quota-note b{color:var(--ink);font-weight:600}#view-employees .legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;font-size:12px;color:var(--muted)}#view-employees .legend span{display:inline-flex;align-items:center;gap:6px}#view-employees .legend i{width:11px;height:11px;border-radius:3px;display:inline-block}#view-employees .foot{text-align:center;color:var(--muted);font-size:12px;margin:26px 0 8px}#view-employees input[type=file]{display:none}#view-employees .dbbar{background:#152540;border-bottom:1px solid rgba(255,255,255,.08)}#view-employees .dbbar-in{max-width:1280px;margin:0 auto;padding:11px 24px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-employees .dbbar .dblab{color:var(--orange);font-family:'Anuphan';font-weight:600;font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-right:2px}#view-employees .dbbar input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#fff;border-radius:8px;padding:8px 11px;font-family:inherit;font-size:12.5px;outline:none}#view-employees .dbbar input::placeholder{color:#7C88A6}#view-employees .dbbar input.url{width:250px}#view-employees .dbbar input.key{width:170px}#view-employees .dbbar input.mon{width:150px;color-scheme:dark}#view-employees .dbbtn{font-family:inherit;font-size:12.5px;font-weight:600;border-radius:8px;padding:8px 13px;cursor:pointer;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff}#view-employees .dbbtn.go{background:var(--orange);color:var(--ink);border:none}#view-employees .dbbtn.load{background:#2E9E6B;color:#fff;border:none}#view-employees .dbbtn:hover{filter:brightness(1.08)}#view-employees .dbmsg{font-size:12px;color:#AEB8CF;margin-left:auto;max-width:100%}#view-employees .dbmsg.ok{color:#7FE0AE}#view-employees .dbmsg.err{color:#FF9E93}@media(max-width:640px){#view-employees .dbbar input.url,#view-employees .dbbar input.key{width:100%}}@media(max-width:1000px){#view-employees .kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){#view-employees .kpis{grid-template-columns:repeat(2,1fr)}#view-employees .wrap{padding:16px}#view-employees thead th.hide,#view-employees tbody td.hide{display:none}
}
:root{
  --navy:#1B2D51; --ink:#101F36; --orange:#D42027; --orange-soft:#FBE7E8;
  --bg:#EEEEEA; --panel:#FFFFFF; --line:#E3E3DC; --muted:#7A8398;
  --present:#2E9E6B; --late:#E8912A; --sick:#C24D6B; --personal:#6B6FCB;
  --vacation:#2E93C4; --absent:#D8453A; --dayoff:#B4BAC6; --holiday:#9AA3B5;
  --shadow:0 1px 2px rgba(16,31,54,.06),0 8px 24px rgba(16,31,54,.06);
}*{box-sizing:border-box}html,body{margin:0;padding:0}body{
  font-family:'IBM Plex Sans Thai',system-ui,sans-serif;
  background:var(--bg);color:var(--ink);
  font-size:14px;line-height:1.5;
  -webkit-font-smoothing:antialiased;
}#view-summary .num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}#view-summary h1,#view-summary h2,#view-summary h3{font-family:'Anuphan',sans-serif;margin:0;font-weight:600;letter-spacing:-.01em}#view-summary .topbar{
  background:var(--navy);color:#fff;position:sticky;top:0;z-index:40;
  border-bottom:3px solid var(--orange);
}#view-summary .topbar-in{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}#view-summary .brand{display:flex;align-items:center;gap:12px;margin-right:auto}#view-summary .mark{width:38px;height:38px;flex:none}#view-summary .brand .t1{font-family:'Anuphan';font-weight:700;font-size:18px;line-height:1;letter-spacing:.02em}#view-summary .brand .t2{font-size:12px;color:#AEB8CF;margin-top:3px}#view-summary .tb-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-summary .select-wrap{position:relative}#view-summary select,#view-summary .btn{
  font-family:inherit;font-size:13px;border-radius:9px;cursor:pointer;
  border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;
  padding:9px 14px;appearance:none;
}#view-summary select{padding-right:32px}#view-summary .select-wrap::after{content:"";position:absolute;right:12px;top:50%;width:7px;height:7px;
  border-right:2px solid #AEB8CF;border-bottom:2px solid #AEB8CF;transform:translateY(-70%) rotate(45deg);pointer-events:none}#view-summary .btn-upload{background:var(--orange);color:var(--ink);border:none;font-weight:600}#view-summary .btn-upload:hover{filter:brightness(1.05)}#view-summary .demo-tag{font-size:11px;font-weight:600;color:var(--ink);background:var(--orange);
  padding:4px 9px;border-radius:999px;display:none}#view-summary .demo-tag.on{display:inline-block}#view-summary .wrap{max-width:1280px;margin:0 auto;padding:24px}#view-summary .section-h{display:flex;align-items:baseline;gap:12px;margin:0 2px 12px}#view-summary .section-h h2{font-size:17px}#view-summary .section-h .sub{font-size:12.5px;color:var(--muted)}#view-summary .eyebrow{font-family:'Anuphan';font-size:11px;font-weight:600;letter-spacing:.14em;
  text-transform:uppercase;color:var(--orange)}#view-summary .kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-bottom:30px}#view-summary .kpi{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px 16px 14px;box-shadow:var(--shadow);position:relative;overflow:hidden}#view-summary .kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c,var(--navy))}#view-summary .kpi .lab{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px}#view-summary .kpi .dot{width:8px;height:8px;border-radius:3px;background:var(--c,var(--navy))}#view-summary .kpi .v{font-family:'Anuphan';font-weight:700;font-size:30px;line-height:1.1;margin-top:6px;color:var(--ink)}#view-summary .kpi .v small{font-size:14px;color:var(--muted);font-weight:500}#view-summary .kpi .cap{font-size:11.5px;color:var(--muted);margin-top:2px}#view-summary .panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:20px 22px;margin-bottom:30px}#view-summary .steps{display:flex;gap:10px;align-items:flex-end;overflow-x:auto;padding:6px 2px 2px}#view-summary .step{flex:1 0 62px;min-width:62px;text-align:center;cursor:pointer;border-radius:12px;padding:8px 6px 10px;
  transition:background .12s;border:1px solid transparent}#view-summary .step:hover{background:#F6F6F2}#view-summary .step.sel{background:var(--orange-soft);border-color:#EEBCC0}#view-summary .step.future{opacity:.35;pointer-events:none}#view-summary .step .date{font-size:11px;color:var(--muted)}#view-summary .step .date b{color:var(--ink);font-weight:600}#view-summary .bar-track{height:96px;display:flex;align-items:flex-end;justify-content:center;margin:6px 0 6px}#view-summary .bar{width:26px;background:var(--navy);border-radius:6px 6px 3px 3px;min-height:4px;position:relative;transition:height .3s ease}#view-summary .step.sel .bar{background:var(--orange)}#view-summary .step .cnt{font-family:'Anuphan';font-weight:700;font-size:16px;line-height:1}#view-summary .day-detail{margin-top:14px;padding-top:14px;border-top:1px dashed var(--line);display:flex;flex-wrap:wrap;gap:8px;align-items:center}#view-summary .day-detail .dh{font-size:13px;font-weight:600;color:var(--ink);margin-right:6px}#view-summary .chip{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;background:#F6F6F2;border:1px solid var(--line);
  padding:5px 11px;border-radius:999px}#view-summary .chip .cd{width:9px;height:9px;border-radius:3px}#view-summary .chip b{font-family:'Anuphan';font-variant-numeric:tabular-nums}#view-summary .controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}#view-summary .field{background:var(--panel);border:1px solid var(--line);border-radius:11px;display:flex;align-items:center;gap:8px;padding:0 12px;box-shadow:var(--shadow)}#view-summary .field svg{color:var(--muted);flex:none}#view-summary .field input,#view-summary .field select{background:transparent;border:none;color:var(--ink);padding:11px 4px;font-family:inherit;font-size:13.5px;outline:none;min-width:150px}#view-summary .field select{cursor:pointer;padding-right:20px}#view-summary .field.grow{flex:1;min-width:200px}#view-summary .controls .btn.exp{background:var(--navy);border-color:var(--navy);margin-left:auto}#view-summary .controls .btn.exp:hover{background:var(--ink)}#view-summary .tbl-wrap{background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}#view-summary table{width:100%;border-collapse:collapse;font-size:13px}#view-summary thead th{background:#F7F7F3;color:var(--muted);font-weight:600;font-size:11.5px;letter-spacing:.02em;
  text-align:center;padding:12px 8px;border-bottom:1px solid var(--line);white-space:nowrap;position:sticky;top:0}#view-summary thead th.l{text-align:left;padding-left:20px}#view-summary tbody td{padding:12px 8px;border-bottom:1px solid #F0F0EA;text-align:center;vertical-align:middle}#view-summary tbody tr:last-child td{border-bottom:none}#view-summary tbody tr.emp-row{cursor:pointer}#view-summary tbody tr.emp-row:hover{background:#FBFAF6}#view-summary .idx{color:var(--muted);font-size:12px}#view-summary .who{text-align:left;padding-left:20px}#view-summary .who .nm{font-weight:600;color:var(--ink)}#view-summary .who .nm .nick{color:var(--orange);font-weight:600}#view-summary .who .role{font-size:11.5px;color:var(--muted);margin-top:1px}#view-summary .stat{font-family:'Anuphan';font-weight:600;font-variant-numeric:tabular-nums;font-size:14.5px}#view-summary .stat.z{color:#CBCEC7;font-weight:500}#view-summary .stat.present{color:var(--present)}#view-summary .stat.late{color:var(--late)}#view-summary .stat.sick{color:var(--sick)}#view-summary .stat.personal{color:var(--personal)}#view-summary .stat.vacation{color:var(--vacation)}#view-summary .stat.absent{color:var(--absent)}#view-summary .rate{display:flex;align-items:center;gap:8px;justify-content:flex-end;padding-right:16px}#view-summary .rate .rbar{width:64px;height:7px;border-radius:99px;background:#EDEDE7;overflow:hidden}#view-summary .rate .rfill{height:100%;border-radius:99px}#view-summary .rate .rv{font-family:'Anuphan';font-weight:600;font-variant-numeric:tabular-nums;width:44px;text-align:right}#view-summary .tl-row td{padding:0;background:#FAFAF6}#view-summary .tl{padding:14px 20px 18px;display:none}#view-summary .tl.open{display:block}#view-summary .tl .tl-h{font-size:12px;color:var(--muted);margin-bottom:9px}#view-summary .tl-grid{display:flex;flex-wrap:wrap;gap:5px}#view-summary .cell{width:34px;height:40px;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  font-size:11px;border:1px solid var(--line);background:#fff}#view-summary .cell .d{font-size:9px;color:var(--muted);line-height:1}#view-summary .cell .m{font-family:'Anuphan';font-weight:600;font-size:12px;line-height:1.3}#view-summary .cell.present{background:#EAF6F0;border-color:#BFE6D3;color:var(--present)}#view-summary .cell.late{background:#FDF1E1;border-color:#F6D9AF;color:var(--late)}#view-summary .cell.sick{background:#FBEBF0;border-color:#F0C6D3;color:var(--sick)}#view-summary .cell.personal{background:#EDEDFA;border-color:#CBCCF0;color:var(--personal)}#view-summary .cell.vacation{background:#E8F4FA;border-color:#BEE0F0;color:var(--vacation)}#view-summary .cell.absent{background:#FCEAE8;border-color:#F4C4BE;color:var(--absent)}#view-summary .cell.dayoff{background:#F3F3F0;color:var(--dayoff)}#view-summary .cell.holiday{background:#F3F3F0;color:var(--holiday)}#view-summary .cell.empty{background:#fff;color:#D9D9D2}#view-summary .empty-state{text-align:center;padding:70px 20px;color:var(--muted)}#view-summary .empty-state h3{font-size:18px;color:var(--ink);margin-bottom:8px}#view-summary .qcell{min-width:96px}#view-summary .qtop{font-size:12px;color:var(--muted)}#view-summary .qtop b{font-family:'Anuphan';font-size:16px;color:var(--ink)}#view-summary .qtop b.over{color:var(--absent)}#view-summary .qtrack{height:6px;border-radius:99px;background:#EDEDE7;overflow:hidden;margin:3px 0}#view-summary .qfill{height:100%;border-radius:99px}#view-summary .qrem{font-size:11px;color:var(--muted)}#view-summary .qrem.over{color:var(--absent);font-weight:600}#view-summary .vq{display:flex;gap:4px;margin-top:5px;justify-content:center}#view-summary .vqx{font-family:'Anuphan';font-size:10.5px;font-variant-numeric:tabular-nums;padding:2px 5px;border-radius:5px;
  background:#F1F1EC;color:var(--muted);border:1px solid var(--line)}#view-summary .vqx.over{background:#FCEAE8;border-color:#F4C4BE;color:var(--absent);font-weight:600}#view-summary .badge{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px;display:inline-block}#view-summary .badge.ok{background:#EAF6F0;color:var(--present)}#view-summary .badge.over{background:#FCEAE8;color:var(--absent)}#view-summary .quota-note{font-size:12px;color:var(--muted)}#view-summary .quota-note b{color:var(--ink);font-weight:600}#view-summary .legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;font-size:12px;color:var(--muted)}#view-summary .legend span{display:inline-flex;align-items:center;gap:6px}#view-summary .legend i{width:11px;height:11px;border-radius:3px;display:inline-block}#view-summary .foot{text-align:center;color:var(--muted);font-size:12px;margin:26px 0 8px}#view-summary input[type=file]{display:none}#view-summary .dbbar{background:#152540;border-bottom:1px solid rgba(255,255,255,.08)}#view-summary .dbbar-in{max-width:1280px;margin:0 auto;padding:11px 24px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-summary .dbbar .dblab{color:var(--orange);font-family:'Anuphan';font-weight:600;font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-right:2px}#view-summary .dbbar input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#fff;border-radius:8px;padding:8px 11px;font-family:inherit;font-size:12.5px;outline:none}#view-summary .dbbar input::placeholder{color:#7C88A6}#view-summary .dbbar input.url{width:250px}#view-summary .dbbar input.key{width:170px}#view-summary .dbbar input.mon{width:150px;color-scheme:dark}#view-summary .dbbtn{font-family:inherit;font-size:12.5px;font-weight:600;border-radius:8px;padding:8px 13px;cursor:pointer;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff}#view-summary .dbbtn.go{background:var(--orange);color:var(--ink);border:none}#view-summary .dbbtn.load{background:#2E9E6B;color:#fff;border:none}#view-summary .dbbtn:hover{filter:brightness(1.08)}#view-summary .dbmsg{font-size:12px;color:#AEB8CF;margin-left:auto;max-width:100%}#view-summary .dbmsg.ok{color:#7FE0AE}#view-summary .dbmsg.err{color:#FF9E93}@media(max-width:640px){#view-summary .dbbar input.url,#view-summary .dbbar input.key{width:100%}}@media(max-width:1000px){#view-summary .kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){#view-summary .kpis{grid-template-columns:repeat(2,1fr)}#view-summary .wrap{padding:16px}#view-summary thead th.hide,#view-summary tbody td.hide{display:none}
