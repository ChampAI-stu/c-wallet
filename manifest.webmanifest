  background:#F1F1EC;color:var(--muted);border:1px solid var(--line)}#view-leave .vqx.over{background:#FCEAE8;border-color:#F4C4BE;color:var(--absent);font-weight:600}#view-leave .badge{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px;display:inline-block}#view-leave .badge.ok{background:#EAF6F0;color:var(--present)}#view-leave .badge.over{background:#FCEAE8;color:var(--absent)}#view-leave .quota-note{font-size:12px;color:var(--muted)}#view-leave .quota-note b{color:var(--ink);font-weight:600}#view-leave .legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;font-size:12px;color:var(--muted)}#view-leave .legend span{display:inline-flex;align-items:center;gap:6px}#view-leave .legend i{width:11px;height:11px;border-radius:3px;display:inline-block}#view-leave .foot{text-align:center;color:var(--muted);font-size:12px;margin:26px 0 8px}#view-leave input[type=file]{display:none}#view-leave .dbbar{background:#152540;border-bottom:1px solid rgba(255,255,255,.08)}#view-leave .dbbar-in{max-width:1280px;margin:0 auto;padding:11px 24px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-leave .dbbar .dblab{color:var(--orange);font-family:'Anuphan';font-weight:600;font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-right:2px}#view-leave .dbbar input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#fff;border-radius:8px;padding:8px 11px;font-family:inherit;font-size:12.5px;outline:none}#view-leave .dbbar input::placeholder{color:#7C88A6}#view-leave .dbbar input.url{width:250px}#view-leave .dbbar input.key{width:170px}#view-leave .dbbar input.mon{width:150px;color-scheme:dark}#view-leave .dbbtn{font-family:inherit;font-size:12.5px;font-weight:600;border-radius:8px;padding:8px 13px;cursor:pointer;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff}#view-leave .dbbtn.go{background:var(--orange);color:var(--ink);border:none}#view-leave .dbbtn.load{background:#2E9E6B;color:#fff;border:none}#view-leave .dbbtn:hover{filter:brightness(1.08)}#view-leave .dbmsg{font-size:12px;color:#AEB8CF;margin-left:auto;max-width:100%}#view-leave .dbmsg.ok{color:#7FE0AE}#view-leave .dbmsg.err{color:#FF9E93}@media(max-width:640px){#view-leave .dbbar input.url,#view-leave .dbbar input.key{width:100%}}@media(max-width:1000px){#view-leave .kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){#view-leave .kpis{grid-template-columns:repeat(2,1fr)}#view-leave .wrap{padding:16px}#view-leave thead th.hide,#view-leave tbody td.hide{display:none}
}
:root{
  --navy:#1B2D51; --ink:#101F36; --orange:#D42027; --orange-soft:#FBE7E8;
  --bg:#EEEEEA; --panel:#FFFFFF; --line:#E3E3DC; --muted:#7A8398;
  --present:#2E9E6B; --late:#E8912A; --sick:#C24D6B; --personal:#6B6FCB;
  --vacation:#2E93C4; --absent:#D8453A; --dayoff:#B4BAC6; --holiday:#9AA3B5;
  --shadow:0 1px 2px rgba(16,31,54,.06),0 8px 24px rgba(16,31,54,.06);
}*{box-sizing:border-box}html,body{margin:0;padding:0}body{
  font-family:'IBM Plex Sans Thai',system-ui,sans-serif;
  background:var(--bg);color:var(--ink);
  font-size:14px;line-height:1.5;
  -webkit-font-smoothing:antialiased;
}#view-employees .num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}#view-employees h1,#view-employees h2,#view-employees h3{font-family:'Anuphan',sans-serif;margin:0;font-weight:600;letter-spacing:-.01em}#view-employees .topbar{
  background:var(--navy);color:#fff;position:sticky;top:0;z-index:40;
  border-bottom:3px solid var(--orange);
}#view-employees .topbar-in{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}#view-employees .brand{display:flex;align-items:center;gap:12px;margin-right:auto}#view-employees .mark{width:38px;height:38px;flex:none}#view-employees .brand .t1{font-family:'Anuphan';font-weight:700;font-size:18px;line-height:1;letter-spacing:.02em}#view-employees .brand .t2{font-size:12px;color:#AEB8CF;margin-top:3px}#view-employees .tb-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}#view-employees .select-wrap{position:relative}#view-employees select,#view-employees .btn{
  font-family:inherit;font-size:13px;border-radius:9px;cursor:pointer;
  border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;
  padding:9px 14px;appearance:none;
}#view-employees select{padding-right:32px}#view-employees .select-wrap::after{content:"";position:absolute;right:12px;top:50%;width:7px;height:7px;
  border-right:2px solid #AEB8CF;border-bottom:2px solid #AEB8CF;transform:translateY(-70%) rotate(45deg);pointer-events:none}#view-employees .btn-upload{background:var(--orange);color:var(--ink);border:none;font-weight:600}#view-employees .btn-upload:hover{filter:brightness(1.05)}#view-employees .demo-tag{font-size:11px;font-weight:600;color:var(--ink);background:var(--orange);
  padding:4px 9px;border-radius:999px;display:none}#view-employees .demo-tag.on{display:inline-block}#view-employees .wrap{max-width:1280px;margin:0 auto;padding:24px}#view-employees .section-h{display:flex;align-items:baseline;gap:12px;margin:0 2px 12px}#view-employees .section-h h2{font-size:17px}#view-employees .section-h .sub{font-size:12.5px;color:var(--muted)}#view-employees .eyebrow{font-family:'Anuphan';font-size:11px;font-weight:600;letter-spacing:.14em;
  text-transform:uppercase;color:var(--orange)}#view-employees .kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-bottom:30px}#view-employees .kpi{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px 16px 14px;box-shadow:var(--shadow);position:relative;overflow:hidden}#view-employees .kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c,var(--navy))}#view-employees .kpi .lab{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px}#view-employees .kpi .dot{width:8px;height:8px;border-radius:3px;background:var(--c,var(--navy))}#view-employees .kpi .v{font-family:'Anuphan';font-weight:700;font-size:30px;line-height:1.1;margin-top:6px;color:var(--ink)}#view-employees .kpi .v small{font-size:14px;color:var(--muted);font-weight:500}#view-employees .kpi .cap{font-size:11.5px;color:var(--muted);margin-top:2px}#view-employees .panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:20px 22px;margin-bottom:30px}#view-employees .steps{display:flex;gap:10px;align-items:flex-end;overflow-x:auto;padding:6px 2px 2px}#view-employees .step{flex:1 0 62px;min-width:62px;text-align:center;cursor:pointer;border-radius:12px;padding:8px 6px 10px;
  transition:background .12s;border:1px solid transparent}#view-employees .step:hover{background:#F6F6F2}#view-employees .step.sel{background:var(--orange-soft);border-color:#EEBCC0}#view-employees .step.future{opacity:.35;pointer-events:none}#view-employees .step .date{font-size:11px;color:var(--muted)}#view-employees .step .date b{color:var(--ink);font-weight:600}#view-employees .bar-track{height:96px;display:flex;align-items:flex-end;justify-content:center;margin:6px 0 6px}#view-employees .bar{width:26px;background:var(--navy);border-radius:6px 6px 3px 3px;min-height:4px;position:relative;transition:height .3s ease}#view-employees .step.sel .bar{background:var(--orange)}#view-employees .step .cnt{font-family:'Anuphan';font-weight:700;font-size:16px;line-height:1}#view-employees .day-detail{margin-top:14px;padding-top:14px;border-top:1px dashed var(--line);display:flex;flex-wrap:wrap;gap:8px;align-items:center}#view-employees .day-detail .dh{font-size:13px;font-weight:600;color:var(--ink);margin-right:6px}#view-employees .chip{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;background:#F6F6F2;border:1px solid var(--line);
