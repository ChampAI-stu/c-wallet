<section id="view-leave" class="view">

<div class="wrap">
  <div class="section-h"><span class="eyebrow">สิทธิการลา</span><h2>สิทธิการลาคงเหลือรายปี</h2><span class="sub" id="quotaSub"></span></div>
  <div class="controls">
    <div class="field"><span style="color:var(--muted);font-size:12.5px">ปี พ.ศ.</span><select id="quotaYear"></select></div>
    <button class="btn" id="quotaAddYear" style="background:var(--navy);border-color:var(--navy);color:#fff">＋ เพิ่มปี</button>
    <div class="field grow"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input id="quotaSearch" placeholder="ค้นหาชื่อ / ตำแหน่ง" autocomplete="off"></div>
    <div class="field"><select id="quotaGroup"></select></div>
    <span class="quota-note"><b>ลากิจ 4 วัน · ลาป่วย 30 วัน</b> (นับเป็นชม. · 8ชม=1วัน) · <b>พักร้อน 6 วัน</b> (&le; ไตรมาสละ 2) — นับเฉพาะ &quot;ได้ตัง&quot;</span>
    <span class="dbmsg" id="leaveMsg" style="margin-left:auto"></span>
  </div>
  <div class="tbl-wrap" id="quotaWrap"><div class="empty-state"><h3>ยังไม่ได้โหลดข้อมูล</h3><div>เลือกปีแล้วกด &quot;โหลดจาก DB&quot;</div></div></div>
</div>

</section>
<section id="view-employees" class="view">

