  --navy:#1B2D51; --ink:#101F36; --orange:#D42027; --orange-soft:#FBE7E8;
  --bg:#EEEEEA; --panel:#FFFFFF; --line:#E3E3DC; --muted:#7A8398;
  --present:#2E9E6B; --late:#E8912A; --sick:#C24D6B; --personal:#6B6FCB;
  --vacation:#2E93C4; --absent:#D8453A; --dayoff:#B4BAC6; --holiday:#9AA3B5;
  --shadow:0 1px 2px rgba(16,31,54,.06),0 8px 24px rgba(16,31,54,.06);
}*{box-sizing:border-box}html,body{margin:0;padding:0}body{font-family:'IBM Plex Sans Thai',system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;-webkit-font-smoothing:antialiased}#view-grid .num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}#view-grid h1,#view-grid h2{font-family:'Anuphan';margin:0;font-weight:600;letter-spacing:-.01em}#view-grid .topbar{background:var(--navy);color:#fff;position:sticky;top:0;z-index:60;border-bottom:3px solid var(--orange)}#view-grid .topbar-in{max-width:1400px;margin:0 auto;padding:13px 22px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}#view-grid .brand{display:flex;align-items:center;gap:11px;margin-right:auto}#view-grid .mark{width:34px;height:34px}#view-grid .brand .t1{font-family:'Anuphan';font-weight:700;font-size:17px;line-height:1;letter-spacing:.02em}#view-grid .brand .t2{font-size:11.5px;color:#AEB8CF;margin-top:3px}#view-grid .mode-tag{font-size:11px;font-weight:600;color:var(--ink);background:var(--orange);padding:4px 10px;border-radius:999px}#view-grid .mode-tag.live{background:#2E9E6B;color:#fff}#view-grid .dbbar{background:#152540;border-bottom:1px solid rgba(255,255,255,.08)}#view-grid .dbbar-in{max-width:1400px;margin:0 auto;padding:10px 22px;display:flex;gap:9px;align-items:center;flex-wrap:wrap}#view-grid .dblab{color:var(--orange);font-family:'Anuphan';font-weight:600;font-size:12px;letter-spacing:.1em;text-transform:uppercase}#view-grid .dbbar input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#fff;border-radius:8px;padding:7px 10px;font-family:inherit;font-size:12.5px;outline:none}#view-grid .dbbar input::placeholder{color:#7C88A6}#view-grid .dbbar input.url{width:230px}#view-grid .dbbar input.key{width:150px}#view-grid .dbbar input.mon{width:140px;color-scheme:dark}#view-grid .dbbtn{font-family:inherit;font-size:12.5px;font-weight:600;border-radius:8px;padding:7px 12px;cursor:pointer;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff}#view-grid .dbbtn.go{background:var(--orange);color:var(--ink);border:none}#view-grid .dbbtn.load{background:#2E9E6B;color:#fff;border:none}#view-grid .dbbtn:hover{filter:brightness(1.08)}#view-grid .dbmsg{font-size:12px;color:#AEB8CF;margin-left:auto}#view-grid .dbmsg.ok{color:#7FE0AE}#view-grid .dbmsg.err{color:#FF9E93}#view-grid .wrap{max-width:1400px;margin:0 auto;padding:18px 22px}#view-grid .toolbar{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-bottom:14px;position:sticky;top:var(--tabbarH,62px);z-index:7;background:var(--bg);padding:8px 0}#view-grid .brushes{display:flex;gap:6px;flex-wrap:wrap;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:7px 9px;box-shadow:var(--shadow)}#view-grid .brushes .lbl{font-size:12px;color:var(--muted);margin-right:2px}#view-grid .brush{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;border:1.5px solid var(--line);background:#fff;border-radius:9px;padding:6px 10px;cursor:pointer;font-family:inherit}#view-grid .brush .sw{width:15px;height:15px;border-radius:4px;font-family:'Anuphan';font-weight:700;font-size:10px;display:flex;align-items:center;justify-content:center;color:#fff}#view-grid .brush.active{border-color:var(--ink);box-shadow:0 0 0 2px rgba(16,31,54,.08)}#view-grid .brush.eraser .sw{background:#fff;border:1px solid var(--line);color:var(--muted)}#view-grid .save-ind{font-size:12.5px;color:var(--muted);display:flex;align-items:center;gap:7px;margin-left:auto}#view-grid .save-ind .d{width:9px;height:9px;border-radius:50%;background:#CBCEC7}#view-grid .save-ind.saving .d{background:var(--late);animation:pulse 1s infinite}#view-grid .save-ind.saved .d{background:var(--present)}#view-grid .save-ind.err .d{background:var(--absent)}@keyframes pulse{50%{opacity:.35}}#view-grid .addbtn{font-family:inherit;font-size:12.5px;font-weight:600;border:1px dashed var(--navy);color:var(--navy);background:#fff;border-radius:9px;padding:8px 12px;cursor:pointer}#view-grid .addbtn:hover{background:var(--orange-soft)}#view-grid .grid-wrap{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:visible}#view-grid table.grid{border-collapse:separate;border-spacing:0;font-size:12.5px}#view-grid .grid th,#view-grid .grid td{border-right:1px solid #333333;border-bottom:1px solid #333333;text-align:center;white-space:nowrap}#view-grid .grid thead th{position:sticky;top:var(--gridStick,130px);z-index:5;background:#F7F7F3;color:var(--muted);font-weight:600;font-size:11px;padding:7px 4px;height:44px}#view-grid .grid thead th.wknd{background:#EFEFE9;color:var(--absent)}#view-grid .grid th.hcol{min-width:34px}#view-grid .grid th.dnum{font-family:'Anuphan';font-size:13px;color:var(--ink)}#view-grid .grid th.dow{font-weight:500}#view-grid .cn{position:sticky;z-index:4;background:var(--panel)}#view-grid .c-idx{left:0;width:34px;min-width:34px}#view-grid .c-name{left:34px;min-width:238px;max-width:238px;text-align:left}#view-grid .c-sum{left:272px;width:46px;min-width:46px}#view-grid .grid thead th.cn{z-index:7;background:#F7F7F3}#view-grid .grid tbody td.cn{border-bottom:1px solid #333333}#view-grid td.c-name{padding:3px 10px}#view-grid td.c-name .nm{font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:224px;line-height:1.25}#view-grid td.c-name .nm .nick{color:var(--orange)}#view-grid td.c-name .role{font-size:10.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:224px;line-height:1.2}#view-grid td.c-sum{font-family:'Anuphan';font-weight:700;color:var(--present);font-size:14px}#view-grid tbody tr:hover td.cn{background:#FBFAF6}#view-grid td.cell{width:30px;min-width:30px;height:30px;cursor:pointer;font-family:'Anuphan';font-weight:600;user-select:none;color:var(--ink)}#view-grid td.cell:hover{outline:2px solid var(--orange);outline-offset:-2px}#view-grid table.grid.nobrush td.cell{cursor:default}#view-grid table.grid.nobrush td.cell:hover{outline:none}#view-grid td.cell.present{background:#EAF6F0;color:var(--present)}#view-grid td.cell.late{background:#FDF1E1;color:var(--late)}#view-grid td.cell.sick{background:#FBEBF0;color:var(--ink)}#view-grid td.cell.personal{background:#EDEDFA;color:var(--ink)}#view-grid td.cell.vacation{background:#E8F4FA;color:var(--ink)}#view-grid td.cell.absent{background:var(--absent);color:#fff;font-weight:800}#view-grid td.cell.dayoff{background:#F3F3F0;color:var(--ink)}#view-grid td.cell.holiday{background:#F3F3F0;color:var(--ink)}#view-grid td.cell.wknd{background:#FAFAF6}#view-grid td.cell{position:relative}#view-grid td.cell.has-note::after{content:"";position:absolute;top:1px;right:1px;border-top:7px solid var(--orange);border-left:7px solid transparent}#view-grid td.cell.unpaid{background-image:repeating-linear-gradient(45deg,rgba(0,0,0,0) 0,rgba(0,0,0,0) 3px,rgba(0,0,0,.10) 3px,rgba(0,0,0,.10) 5px)}#view-grid td.cell.unpaid::before{content:"฿";position:absolute;bottom:-1px;left:1px;font-size:9px;color:var(--absent);text-decoration:line-through;font-weight:700}#view-grid td.cell.partial{font-weight:800}#view-grid .grid-filter{display:flex;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:8px 14px;margin-bottom:10px;color:var(--muted);box-shadow:var(--shadow)}#view-grid .grid-filter input{flex:1;border:none;outline:none;background:transparent;font-family:inherit;font-size:14px;color:var(--ink)}#view-grid .grid-filter #gridCount{font-size:12px;color:var(--muted);white-space:nowrap}#view-grid .brush-drop{font-family:inherit;font-size:12.5px;border:1.5px solid var(--ink);border-radius:9px;padding:6px 8px;background:var(--orange-soft);color:var(--ink);cursor:pointer;margin-left:-3px;outline:none}#view-grid .paidsel{display:flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:8px 12px;box-shadow:var(--shadow);font-size:12.5px;color:var(--muted)}#view-grid .paidsel select{font-family:inherit;font-size:13px;border:1px solid var(--line);border-radius:8px;padding:6px 9px;background:#fff;color:var(--ink);cursor:pointer;outline:none}#view-grid .brush.note .sw{color:#fff}#view-grid td.cell.flash{animation:flash .8s}@keyframes flash{0%{box-shadow:inset 0 0 0 3px var(--orange)}100%{box-shadow:none}}#view-grid .grid tfoot td{position:sticky;bottom:0;z-index:5;background:#F2F5F8;font-family:'Anuphan';font-weight:600;color:var(--navy);font-size:12px;padding:7px 3px}#view-grid .grid tfoot td.cn{z-index:7}#view-grid .grid tfoot td.foot-lab{text-align:right;padding-right:10px;color:var(--muted);font-weight:600}#view-grid .legend{display:flex;gap:13px;flex-wrap:wrap;margin-top:13px;font-size:12px;color:var(--muted)}#view-grid .legend span{display:inline-flex;align-items:center;gap:6px}#view-grid .legend i{width:11px;height:11px;border-radius:3px}#view-grid .hint{font-size:12.5px;color:var(--muted);margin:2px 0 12px}#view-grid .hint b{color:var(--ink)}


#view-employees .emp-form{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 20px 60px rgba(20,30,60,.35);padding:18px 20px;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:200;width:min(640px,92vw);max-height:86vh;overflow:auto}
#empBackdrop{position:fixed;inset:0;background:rgba(20,30,60,.42);z-index:190}
#view-employees .emp-form h3{font-family:'Anuphan';font-size:15px;margin:0 0 14px;color:var(--ink)}
#view-employees .ef-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
#view-employees .ef-f{display:flex;flex-direction:column;gap:4px}
#view-employees .ef-f label{font-size:12px;color:var(--muted)}
#view-employees .ef-f label .req{color:var(--absent)}
#view-employees .ef-f input{font-family:inherit;font-size:13.5px;padding:9px 11px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);outline:none}
#view-employees .ef-f input:focus{border-color:var(--orange)}
#view-employees .ef-actions{display:flex;gap:8px;margin-top:16px}
#view-employees .ebtn{font-family:inherit;font-size:13px;font-weight:600;border-radius:9px;padding:9px 16px;cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink)}
#view-employees .ebtn.save{background:var(--navy);border-color:var(--navy);color:#fff}
#view-employees .ebtn.save:hover{background:var(--ink)}
#view-employees .ebtn:hover{background:#F6F6F2}
#view-employees .act{display:inline-flex;gap:6px}
#view-employees .act button{font-family:inherit;font-size:12px;border:1px solid var(--line);background:#fff;border-radius:7px;padding:5px 10px;cursor:pointer;color:var(--ink)}
#view-employees .act button:hover{background:#F6F6F2}
#view-employees .act .del{color:var(--absent);border-color:#F0C6C0}
#view-employees .act .resign{color:var(--late)}
#view-employees .act .restore{color:var(--present)}
#view-employees .pill{font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:999px}
#view-employees .pill.on{background:#EAF6F0;color:var(--present)}
#view-employees .pill.off{background:#FCEAE8;color:var(--absent)}

/* ===== unified shell (global) ===== */
.tabbar{background:var(--navy);color:#fff;position:sticky;top:0;z-index:80;border-bottom:3px solid var(--orange)}
.tabbar-in{max-width:1400px;margin:0 auto;padding:0 22px;display:flex;align-items:center;gap:14px}
.tabbar .brand{display:flex;align-items:center;gap:11px;padding:9px 0}
.tabbar .logo-chip{width:38px;height:38px;background:#fff;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:none;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.tabbar .logo-chip img{width:32px;height:32px;object-fit:contain;display:block}
.tabbar .mark{width:32px;height:32px}
.tabbar .t1{font-family:'Anuphan';font-weight:700;font-size:16px;line-height:1;letter-spacing:.02em}
.tabbar .t2{font-size:11px;color:#AEB8CF;margin-top:3px}
.tabs{display:flex;gap:2px;margin-left:6px}
.tab{font-family:'Anuphan';font-weight:600;font-size:14.5px;color:#AEB8CF;background:none;border:none;padding:16px 16px 13px;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-3px}
.tab:hover{color:#fff}
.tab.active{color:#fff;border-bottom-color:var(--orange)}
.home-btn{display:inline-flex;align-items:center;gap:6px;margin-left:14px;background:rgba(255,255,255,.08);color:#fff;text-decoration:none;border:1px solid rgba(255,255,255,.25);border-radius:9px;padding:9px 13px;font-family:inherit;font-weight:600;font-size:13px;white-space:nowrap}
.home-btn:hover{background:rgba(255,255,255,.18)}
.load-all{margin-left:auto;background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:9px;padding:9px 14px;font-family:'Anuphan';font-weight:600;font-size:13px;cursor:pointer}
.load-all:hover{background:rgba(255,255,255,.18)}
.save-all{background:var(--orange);color:var(--ink);border:none;border-radius:9px;padding:9px 16px;font-family:'Anuphan';font-weight:700;font-size:13.5px;cursor:pointer;display:inline-flex;align-items:center}
.save-all.has-changes{animation:savepulse 1.6s infinite}
.save-all:hover{filter:brightness(1.05)}
.save-all:disabled{opacity:.6;cursor:default;animation:none}
@keyframes savepulse{0%,100%{box-shadow:0 0 0 0 rgba(255,165,6,.5)}50%{box-shadow:0 0 0 6px rgba(255,165,6,0)}}
.gmonth{margin-left:auto;display:flex;align-items:center;gap:4px}
.gmonth input[type=month]{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:8px;padding:7px 10px;font-family:inherit;font-size:13px;color-scheme:dark;outline:none}
.gm-btn{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:8px;padding:7px 11px;cursor:pointer;font-size:12px}
.gm-btn:hover{background:rgba(255,255,255,.18)}
.view{display:none}
.view.active{display:block}
.view > .topbar{position:static;top:auto;z-index:1}
#view-grid > .topbar{display:none}                 /* ซ่อนแถบซ้ำของ grid (โลโก้ DAIKI ที่ 2) */
#view-dash > .topbar .brand{display:none}          /* ซ่อนโลโก้ซ้ำฝั่งแดชบอร์ด (เหลือแค่ปุ่มอัปโหลด/เลือกชีต) */
.view > .dbbar{position:static}
.view > .dbbar .dbbar-in input.url,.view > .dbbar .dbbar-in input.key{display:none}
.view > .dbbar .dbbtn.go{display:none}
.print-head{display:none}
.grpchip{display:inline-block;background:var(--navy);color:#fff;font-size:10px;padding:1px 8px;border-radius:999px;margin-left:6px;vertical-align:middle;font-weight:600}
#view-dash #tblWrap, #view-employees #empWrap, #view-summary #sumTable, #view-leave #quotaWrap{overflow:visible}
#view-dash #tblWrap thead th, #view-employees #empWrap thead th, #view-summary #sumTable thead th, #view-leave #quotaWrap thead th{position:sticky;top:var(--tabbarH,62px);z-index:5;background:#F4F4EF;box-shadow:inset 0 -1px 0 var(--line)}
@media print{
  .tabbar,.no-print,.view>.topbar,.view>.dbbar{display:none !important}
  .view:not(.active){display:none !important}
  body{background:#fff}
  #view-summary .print-head{display:block !important;margin-bottom:14px}
  #view-summary .tbl-wrap{box-shadow:none;border:1px solid #ccc}
  #view-summary .kpis{margin-bottom:12px}
  #view-summary table{font-size:11px}
  @page{size:A4 landscape;margin:10mm}
}

</style>
</head>
<body>
<div class="tabbar"><div class="tabbar-in"><div class="brand"><img class="logo-chip-img" src="data:image/png;base64," alt="MASARU" style="height:26px;width:auto;display:block"><div><div class="t2" style="margin-top:2px">ระบบบันทึกการมาทำงาน</div></div></div><a class="home-btn" href="index.html" title="กลับหน้าหลัก"><span aria-hidden="true" style="font-size:15px;line-height:1">←</span> หน้าหลัก</a><div class="tabs"><button class="tab active" data-tab="grid">กรอกข้อมูล</button><button class="tab" data-tab="dash">แดชบอร์ด</button><button class="tab" data-tab="leave">สิทธิการลา</button><button class="tab" data-tab="employees">ข้อมูลพนักงาน</button><button class="tab" data-tab="summary">สรุปรายปี</button><button class="tab" data-tab="score">คะแนน/ใบเตือน</button><button class="tab" data-tab="deadline">เตือน Deadline</button></div><button class="load-all" id="btnLoad">🔄 โหลด</button><button class="save-all" id="btnSave" style="display:none">💾 บันทึก</button><div class="gmonth"><button class="gm-btn" id="gPrev">◀</button><input type="month" id="globalMonth" value="2026-07" autocomplete="off"><button class="gm-btn" id="gNext">▶</button></div></div></div>
<section id="view-grid" class="view active">

<div class="topbar"><div class="topbar-in">
  <div class="brand">
    <img class="mark" src="data:image/png;base64," alt="MASARU" style="width:auto;height:34px">
    <div><div class="t2" style="margin-top:6px">กรอกการมาทำงานรายวัน</div></div>
  </div>
  <span class="mode-tag" id="modeTag">โหมดทดลอง (ไม่บันทึก)</span>
</div></div>

<div class="dbbar"><div class="dbbar-in">
  <span class="dblab">ฐานข้อมูล</span>
  <input class="url" id="dbUrl" placeholder="Supabase URL">
  <input class="key" id="dbKey" type="password" placeholder="anon key">
  <button class="dbbtn go" id="dbConnect">เชื่อมต่อ</button>

  <span class="dbmsg" id="dbMsg">โหมดทดลอง — เชื่อมต่อ Supabase เพื่อบันทึกจริงและ sync แบบ realtime</span>
</div></div>

<div class="wrap">
  <div class="toolbar">
    <div class="brushes"><span class="lbl">เครื่องมือ:</span><span id="brushList"></span></div>
    <button class="addbtn" id="addEmp">＋ เพิ่มพนักงาน</button>
    <div class="save-ind" id="saveInd"><span class="d"></span><span id="saveTxt">พร้อม</span></div>
  </div>
  <div class="hint">เลือกเครื่องมือด้านบน แล้ว <b>คลิก</b> หรือ <b>คลิกค้างลากผ่าน</b> ช่องเพื่อกรอก · เลือก <b>ล้าง</b> เพื่อลบ · <span id="rtHint">แก้เสร็จกด <b>💾 บันทึก</b> บนแถบเมนู · โหลดล่าสุดกด <b>🔄 โหลด</b></span></div>

  <div class="grid-filter"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input id="gridSearch" placeholder="ค้นหาชื่อ / ชื่อเล่น / ตำแหน่ง" autocomplete="off"><select id="gridGroup" style="font-family:inherit;font-size:13px;border:1px solid var(--line);border-radius:8px;padding:6px 9px;background:#fff;color:var(--ink);cursor:pointer;outline:none"></select><span id="gridCount"></span></div>
  <div class="grid-wrap" id="gridWrap"><table class="grid" id="grid"></table></div>
